{
  "name": "yousef-portfolio",
  "version": "1.0.0",
  "description": "Yousef Mohamed's portfolio website built with Eleventy",
  "scripts": {
    "build": "eleventy",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "debug": "DEBUG=* eleventy",
    "clean": "rimraf _site || rm -rf _site",
    "sync-assets": "node scripts/sync_ghost_assets.js",
    "optimize": "python3 scripts/optimize_assets.py",
    "refactor": "node scripts/force-macro-refactor-final.js",
    "prod:build": "npm run clean && npm run sync-assets && npm run optimize && npm run refactor && ELEVENTY_ENV=production eleventy",
    "prod:build:safe": "npm run clean && npm run sync-assets && npm run optimize && ELEVENTY_ENV=production eleventy",
    "deploy": "bash scripts/deploy.sh",
    "maintenance": "bash scripts/maintenance.sh",
    "verify-assets": "node scripts/verify-assets.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YousefMohamd/YousefMohamd.github.io.git"
  },
  "author": "Yousef Mohamed",
  "license": "MIT",
  "main": ".eleventy.js",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-navigation": "^0.1.6",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^1.21.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^5.2.5",
    "rimraf": "^6.1.3",
    "terser": "^5.50.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "keywords": [
    "eleventy",
    "portfolio",
    "static-site"
  ]
}
