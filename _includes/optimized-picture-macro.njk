{% macro renderOptimizedImage(url, name, width, height) %}
  {% set lowerUrl = url | lower %}
  {% if '.webp' in lowerUrl or '.avif' in lowerUrl %}
    <picture style="display:block;width:100%;height:100%;object-fit:cover">
      {% if '.webp' in lowerUrl %}
        <source type="image/webp" srcset="{{ url }}">
      {% elif '.avif' in lowerUrl %}
        <source type="image/avif" srcset="{{ url }}">
      {% endif %}
      <img src="{{ url }}" alt="{{ name }}" width="{{ width }}" height="{{ height }}" style="display:block;width:100%;height:auto;max-width:100%;object-fit:contain;margin-bottom:20px;border-radius:8px" decoding="async" loading="lazy">
    </picture>
  {% else %}
    <img src="{{ url }}" alt="{{ name }}" width="{{ width }}" height="{{ height }}" style="display:block;width:100%;height:auto;max-width:100%;object-fit:contain;margin-bottom:20px;border-radius:8px" decoding="async" loading="lazy">
  {% endif %}
{% endmacro %}
