---
layout: layouts/base.njk
title: Short Film Projects
---

<!-- GSAP 3.13 — plugins are free since Webflow acquisition -->
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/MorphSVGPlugin.min.js" defer></script>

<!-- Fonts loaded properly at document level -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="w3-text-light-grey section-heading">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project">
        {% if p.data.vimeoId %}
          <section
            class="cinema"
            data-cinema
            data-video-id="{{ p.data.vimeoId | escape }}"
            data-title="{{ p.data.title | escape }}"
            data-subtitle="{{ (p.data.subtitle or '') | escape }}"
            data-state="idle"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <div class="cinema-video" data-video-layer></div>
              <img
                class="cinema-poster"
                data-poster
                src="/img/optimized/projects/short-film/{{ p.data.vimeoId | escape }}.webp"
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width="1920"
                height="1080"
              >

              <!-- Projector beam (cinema light) -->
              <div class="cine-light" data-light aria-hidden="true"></div>

              <!-- Title block (top-left) -->
              <div class="cine-title-block" data-title-block>
                <h3 class="cine-title" data-film-title></h3>
                <p class="cine-desc" data-film-desc></p>
              </div>
            </div>

            <!-- Camera stage (bottom-left) -->
            <div class="cine-camera-stage" data-camera-stage>
              <button
                class="cine-camera-btn"
                data-camera-btn
                type="button"
                aria-label="Play film"
              >
                <svg
                  class="cine-camera-svg"
                  viewBox="0 0 240 240"
                  xmlns="http://www.w3.org/2000/svg"
                  shape-rendering="geometricPrecision"
                  aria-hidden="true"
                >
                  <!-- Body group (fades on click) -->
                  <g class="cam-body">
                    <rect x="60" y="88" width="120" height="76" rx="9" fill="currentColor"/>
                    <rect x="52" y="114" width="10" height="14" fill="currentColor"/>
                    <polygon points="53,114 32,106 32,136 53,128" fill="currentColor"/>
                    <rect x="178" y="106" width="10" height="28" fill="currentColor"/>
                    <polygon points="187,106 225,82 225,158 187,134" fill="currentColor"/>
                    <path d="M 104 163 A 16 16 0 0 0 136 163 Z" fill="currentColor"/>
                    <polygon points="116,168 124,168 124,230 116,230" fill="currentColor"/>
                    <polygon points="112,168 102,168 60,230 73,230" fill="currentColor"/>
                    <polygon points="128,168 138,168 180,230 167,230" fill="currentColor"/>
                  </g>

                  <!-- Reel holes (fade on click) -->
                  <g class="cam-holes" fill="var(--cam-bg,#000)">
                    <circle cx="95" cy="60" r="4.5"/>
                    <circle cx="95" cy="42" r="6"/>
                    <circle cx="95" cy="78" r="6"/>
                    <circle cx="77" cy="60" r="6"/>
                    <circle cx="113" cy="60" r="6"/>
                    <circle cx="150" cy="48" r="4.5"/>
                    <circle cx="150" cy="24" r="7.5"/>
                    <circle cx="172.83" cy="40.58" r="7.5"/>
                    <circle cx="164.11" cy="67.42" r="7.5"/>
                    <circle cx="135.89" cy="67.42" r="7.5"/>
                    <circle cx="127.17" cy="40.58" r="7.5"/>
                  </g>

                  <!-- Left reel (morphs to pause bar) -->
                  <path
                    class="cam-reel-left"
                    d="M 63 60 a 32 32 0 1 0 64 0 a 32 32 0 1 0 -64 0"
                    fill="currentColor"
                  />

                  <!-- Right reel (morphs to pause bar) -->
                  <path
                    class="cam-reel-right"
                    d="M 110 48 a 40 40 0 1 0 80 0 a 40 40 0 1 0 -80 0"
                    fill="currentColor"
                  />

                  <!-- Hidden morph targets -->
                  <path class="morph-left"  d="M 88 60 H 106 V 180 H 88 Z" fill="currentColor" style="opacity:0;visibility:hidden"/>
                  <path class="morph-right" d="M 134 60 H 152 V 180 H 134 Z" fill="currentColor" style="opacity:0;visibility:hidden"/>
                </svg>
              </button>
            </div>

            <!-- Control bar (revealed after morph) -->
            <div class="cine-controls" data-controls aria-label="Film controls">
              <div class="cine-main-row">
                <button class="cine-playpause" data-playpause-btn type="button" aria-label="Play">
                  <svg class="pp-svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path class="pp-path" d="M8 5v14l11-7z" fill="currentColor"/>
                  </svg>
                </button>

                <div class="cine-timeline">
                  <div class="cine-timeline-track">
                    <div class="cine-timeline-fill" data-progress-fill></div>
                    <input
                      class="cine-timeline-input"
                      data-progress
                      type="range"
                      min="0" max="1000" step="1" value="0"
                      aria-label="Seek through the film"
                      disabled
                    >
                  </div>
                </div>

                <span class="cine-time" data-time>00:00 / 00:00</span>
              </div>

              <div class="cine-btn-row">
                <div class="cine-btn-left">
                  <div class="cine-volume">
                    <button class="cine-btn" data-volume-btn type="button" aria-label="Unmute film">
                      <svg viewBox="0 0 24 24" class="cine-btn-icon" aria-hidden="true">
                        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                      </svg>
                    </button>
                    <input
                      class="cine-volume-slider"
                      data-volume-slider
                      type="range"
                      min="0" max="1" step="0.01" value="1"
                      aria-label="Volume"
                    >
                  </div>
                </div>

                <div class="cine-btn-right">
                  <div class="cine-speed-wrap">
                    <button class="cine-btn cine-btn-text" data-speed-btn type="button" aria-label="Playback speed">1x</button>
                    <div class="cine-popup" data-speed-menu hidden>
                      <button class="cine-popup-item" data-speed-value="0.5">0.5x</button>
                      <button class="cine-popup-item" data-speed-value="0.75">0.75x</button>
                      <button class="cine-popup-item is-active" data-speed-value="1">1x</button>
                      <button class="cine-popup-item" data-speed-value="1.25">1.25x</button>
                      <button class="cine-popup-item" data-speed-value="1.5">1.5x</button>
                      <button class="cine-popup-item" data-speed-value="2">2x</button>
                    </div>
                  </div>

                  <div class="cine-quality-wrap">
                    <button class="cine-btn cine-btn-text" data-quality-btn type="button" aria-label="Video quality">
                      <span data-quality-label>Auto</span>
                    </button>
                    <div class="cine-popup" data-quality-menu hidden></div>
                  </div>

                  <button class="cine-btn" data-fullscreen-btn type="button" aria-label="Fullscreen">
                    <svg viewBox="0 0 24 24" class="cine-btn-icon" aria-hidden="true">
                      <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description">{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/* ============================================================
   CINEMATIC PLAYER — v7
   ------------------------------------------------------------
   States (data-state on .cinema):
     idle     → title visible + camera at bottom-left
     playing  → video playing + controls (auto-hide after 3s)
     paused   → video paused + controls visible
   Classes:
     .is-morphing   → during the GSAP camera→pause morph
     .is-ui-visible → controls forced visible
     .is-ended      → end card: title block returns
   Motion: transform / opacity / filter only.
   ============================================================ */

.cinematic-projects {
  --cine-bg: #0a0a0a;
  --cine-surface: rgba(10, 10, 10, 0.85);
  --cine-text: #e6e6e6;
  --cine-desc: #cccccc;
  --cine-accent: #e8d68a;
  /* Title: Phosphate on macOS → Anton on others → Impact fallback */
  --cine-title-font: 'Phosphate', 'Anton', 'Impact', 'Oswald', sans-serif;
  /* Description: Apple system font on macOS → Inter fallback on others */
  --cine-body-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'AppleSystemUIFont', 'Inter', 'Helvetica Neue', 'Segoe UI', sans-serif;
}

.cinematic-projects .section-heading {
  font-family: var(--cine-body-font);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 48px;
  color: #f0f0f0;
}
.cinematic-projects .film-project { margin-bottom: 56px; }
.cinematic-projects .film-description {
  font-family: var(--cine-body-font);
  color: #c8c8c8;
  line-height: 1.8;
  font-size: 15px;
  margin-top: 20px;
}
.cinematic-projects .film-divider {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.08);
  margin: 40px 0;
}

/* ===== Container ===== */
.cinematic-projects .cinema {
  position: relative;
  isolation: isolate;
  border-radius: 12px;
  overflow: hidden;
  background: #000;
  box-shadow: 0 24px 72px rgba(0,0,0,0.65);
}

/* ===== Screen ===== */
.cinematic-projects .cinema-screen {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
}

/* ===== Video + Poster ===== */
.cinematic-projects .cinema-video,
.cinematic-projects .cinema-video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  opacity: 0;
  transition: opacity 0.7s ease;
  pointer-events: none;
}
.cinematic-projects .cinema[data-state="playing"] .cinema-video,
.cinematic-projects .cinema[data-state="paused"] .cinema-video,
.cinematic-projects .cinema[data-state="playing"] .cinema-video iframe,
.cinematic-projects .cinema[data-state="paused"] .cinema-video iframe {
  opacity: 1;
}
.cinematic-projects .cinema-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 0.6s ease;
  z-index: 2;
}
.cinematic-projects .cinema[data-state="playing"] .cinema-poster,
.cinematic-projects .cinema[data-state="paused"] .cinema-poster {
  opacity: 0;
  pointer-events: none;
}

/* ===== Projector Beam (cinema light) ===== */
.cinematic-projects .cine-light {
  position: absolute;
  inset: 0;
  z-index: 3;
  opacity: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 60% 60% at 15% 80%,
      rgba(255, 235, 180, 0.42) 0%,
      rgba(255, 235, 180, 0.14) 32%,
      transparent 65%);
  mix-blend-mode: screen;
  transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-morphing .cine-light,
.cinematic-projects .cinema[data-state="playing"] .cine-light,
.cinematic-projects .cinema[data-state="paused"] .cine-light {
  opacity: 1;
}

/* ===== Title block — TOP-LEFT ===== */
.cinematic-projects .cine-title-block {
  position: absolute;
  top: 28px;
  left: 32px;
  right: 32px;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-width: 620px;
  pointer-events: none;
  /* Soft scroll entrance (once per load) */
  opacity: 0;
  transform: translate3d(0, -22px, 0);
  filter: blur(6px);
  animation: cine-soft-scroll 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
}
@keyframes cine-soft-scroll {
  0%   { opacity: 0; transform: translate3d(0, -22px, 0); filter: blur(6px); }
  60%  { opacity: 1; filter: blur(0); }
  100% { opacity: 1; transform: translate3d(0, 0, 0); filter: blur(0); }
}

.cinematic-projects .cine-title {
  font-family: var(--cine-title-font);
  font-size: clamp(26px, 4.2vw, 48px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: 0.01em;
  color: var(--cine-text);
  margin: 0;
  text-transform: uppercase;
  text-shadow: 0 2px 18px rgba(0,0,0,0.85);
}
.cinematic-projects .cine-desc {
  font-family: var(--cine-body-font);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.55;
  color: var(--cine-desc);
  margin: 0;
  max-width: 520px;
  text-shadow: 0 1px 6px rgba(0,0,0,0.75);
}

/* Fade title out on morph / playback */
.cinematic-projects .cinema.is-morphing .cine-title-block,
.cinematic-projects .cinema[data-state="playing"] .cine-title-block,
.cinematic-projects .cinema[data-state="paused"] .cine-title-block {
  animation: none;
  opacity: 0;
  transform: translate3d(0, -18px, 0);
  filter: blur(4px);
  transition:
    opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
    filter 0.7s ease;
}

/* End card: title returns only when the film ends */
.cinematic-projects .cinema.is-ended .cine-title-block {
  opacity: 1;
  transform: translate3d(0, 0, 0);
  filter: blur(0);
}

/* ===== Camera stage — BOTTOM-LEFT ===== */
.cinematic-projects .cine-camera-stage {
  position: absolute;
  bottom: 24px;
  left: 24px;
  z-index: 12;
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.4s ease;
}
.cinematic-projects .cinema.is-morphing .cine-camera-stage,
.cinematic-projects .cinema[data-state="playing"] .cine-camera-stage,
.cinematic-projects .cinema[data-state="paused"] .cine-camera-stage {
  opacity: 0;
  pointer-events: none;
}

.cinematic-projects .cine-camera-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96px;
  height: 96px;
  padding: 0;
  border: none;
  background: transparent;
  color: #f2f0eb;
  cursor: pointer;
  border-radius: 8px;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
}
.cinematic-projects .cine-camera-btn:hover {
  transform: scale(1.08);
  background: rgba(255,255,255,0.04);
}
.cinematic-projects .cine-camera-btn:active {
  transform: scale(0.96);
}

.cinematic-projects .cine-camera-svg {
  width: 76px;
  height: 76px;
  color: #f2f0eb;
  --cam-bg: #000;
  /* FLAT 2D — no drop shadow, no shading */
  display: block;
}

/* Reel spin on hover (Animation 2, idle only) */
@keyframes cine-reel-spin { to { transform: rotate(360deg); } }
.cinematic-projects .cinema[data-state="idle"] .cine-camera-btn:hover .cam-reel-left {
  animation: cine-reel-spin 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1;
  transform-origin: 95px 60px;
}
.cinematic-projects .cinema[data-state="idle"] .cine-camera-btn:hover .cam-reel-right {
  animation: cine-reel-spin 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1;
  animation-delay: 0.08s;
  transform-origin: 150px 48px;
}
.cinematic-projects .cinema[data-state="idle"] .cine-camera-btn:hover .cam-holes circle:nth-child(-n+5) {
  animation: cine-reel-spin 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1;
  transform-origin: 95px 60px;
}
.cinematic-projects .cinema[data-state="idle"] .cine-camera-btn:hover .cam-holes circle:nth-child(n+6) {
  animation: cine-reel-spin 1.4s cubic-bezier(0.16, 1, 0.3, 1) 1;
  animation-delay: 0.08s;
  transform-origin: 150px 48px;
}

/* ===== Control Bar ===== */
.cinematic-projects .cine-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 64px 22px 18px;
  background: linear-gradient(to top,
              rgba(0,0,0,0.92) 0%,
              rgba(0,0,0,0.72) 42%,
              rgba(0,0,0,0.24) 78%,
              rgba(0,0,0,0) 100%);
  opacity: 0;
  transform: translate3d(0, 12px, 0);
  pointer-events: none;
  transition:
    opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-morphing .cine-controls,
.cinematic-projects .cinema[data-state="playing"].is-ui-visible .cine-controls,
.cinematic-projects .cinema[data-state="playing"]:hover .cine-controls,
.cinematic-projects .cinema[data-state="paused"] .cine-controls {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

/* ===== Main row: play/pause + timeline + time ===== */
.cinematic-projects .cine-main-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
}

/* ===== Timeline ===== */
.cinematic-projects .cine-timeline {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.cinematic-projects .cine-timeline-track {
  position: relative;
  flex: 1;
  height: 3px;
  border-radius: 3px;
  background: rgba(242, 240, 235, 0.18);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transform: scaleY(1);
  transform-origin: center;
  transition: transform 0.2s ease;
  will-change: transform;
}
.cinematic-projects .cine-timeline:hover .cine-timeline-track { transform: scaleY(1.6667); }
.cinematic-projects .cine-timeline-fill {
  position: absolute;
  top: 0; left: 0;
  height: 100%;
  width: 100%;
  background: rgba(242, 240, 235, 0.88);
  border-radius: 3px;
  pointer-events: none;
  transform: scaleX(0);
  transform-origin: left center;
  box-shadow: 0 0 8px rgba(242,240,235,0.35);
  will-change: transform;
}
.cinematic-projects .cine-timeline-input {
  position: absolute;
  inset: -6px 0;
  width: 100%;
  height: calc(100% + 12px);
  margin: 0; padding: 0;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  cursor: pointer;
  outline: none;
  z-index: 2;
}
.cinematic-projects .cine-timeline-input:disabled { cursor: default; }
.cinematic-projects .cine-timeline-input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: #f2f0eb;
  cursor: pointer;
  box-shadow: 0 0 0 4px rgba(242,240,235,0.18), 0 2px 6px rgba(0,0,0,0.5);
}
.cinematic-projects .cine-timeline-input::-moz-range-thumb {
  width: 12px; height: 12px;
  border-radius: 50%;
  background: #f2f0eb;
  cursor: pointer;
  border: none;
}

/* ===== Button Row ===== */
.cinematic-projects .cine-btn-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.cinematic-projects .cine-btn-left,
.cinematic-projects .cine-btn-right {
  display: flex;
  align-items: center;
  gap: 4px;
}

.cinematic-projects .cine-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40px;
  min-width: 40px;
  padding: 0 10px;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #f2f0eb;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.15s ease;
  font-family: var(--cine-body-font);
  font-size: 12px;
  font-weight: 500;
}
.cinematic-projects .cine-btn:hover { background: rgba(255,255,255,0.09); }
.cinematic-projects .cine-btn:active { transform: scale(0.94); }
.cinematic-projects .cine-btn-icon { width: 22px; height: 22px; fill: currentColor; }
.cinematic-projects .cine-btn-text { color: #f2f0eb; opacity: 0.88; }
.cinematic-projects .cine-btn-text:hover { opacity: 1; }

.cinematic-projects .cine-playpause {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px; height: 44px;
  padding: 0;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: #f2f0eb;
  cursor: pointer;
  flex: 0 0 auto;
  transition: background 0.15s ease, transform 0.15s ease;
}
.cinematic-projects .cine-playpause:hover { background: rgba(255,255,255,0.09); }
.cinematic-projects .cine-playpause:active { transform: scale(0.94); }
.cinematic-projects .pp-svg { width: 28px; height: 28px; fill: currentColor; }

.cinematic-projects .cine-volume {
  display: inline-flex;
  align-items: center;
}
.cinematic-projects .cine-volume-slider {
  width: 80px;
  height: 3px;
  margin: 0 0 0 8px; padding: 0;
  appearance: none;
  -webkit-appearance: none;
  background: rgba(242,240,235,0.25);
  border-radius: 2px;
  cursor: pointer;
  outline: none;
  opacity: 0;
  transform: scaleX(0);
  transform-origin: left center;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  will-change: transform, opacity;
}
.cinematic-projects .cine-volume:hover .cine-volume-slider,
.cinematic-projects .cine-volume-slider:focus {
  opacity: 1;
  transform: scaleX(1);
  pointer-events: auto;
}
.cinematic-projects .cine-volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 10px; height: 10px;
  border-radius: 50%;
  background: #f2f0eb;
  cursor: pointer;
  box-shadow: 0 0 0 3px rgba(242,240,235,0.15);
}
.cinematic-projects .cine-volume-slider::-moz-range-thumb {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: #f2f0eb;
  cursor: pointer;
  border: none;
  box-shadow: 0 0 0 3px rgba(242,240,235,0.15);
}

.cinematic-projects .cine-time {
  font-family: var(--cine-body-font);
  font-size: 12px;
  color: rgba(242,240,235,0.7);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  white-space: nowrap;
  padding: 0 6px;
  user-select: none;
  flex: 0 0 auto;
}

.cinematic-projects .cine-speed-wrap,
.cinematic-projects .cine-quality-wrap { position: relative; }

.cinematic-projects .cine-popup {
  position: absolute;
  bottom: calc(100% + 10px);
  right: 0;
  min-width: 100px;
  padding: 6px;
  background: var(--cine-surface);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  z-index: 40;
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
}
.cinematic-projects .cine-popup[hidden] { display: none; }
.cinematic-projects .cine-popup-item {
  background: transparent;
  border: none;
  color: #f2f0eb;
  font-family: var(--cine-body-font);
  font-size: 12px;
  font-weight: 500;
  padding: 7px 12px;
  text-align: left;
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.12s ease;
}
.cinematic-projects .cine-popup-item:hover { background: rgba(255,255,255,0.1); }
.cinematic-projects .cine-popup-item.is-active {
  background: rgba(232,214,138,0.16);
  color: var(--cine-accent);
}

/* ===== Responsive ===== */
@media (max-width: 640px) {
  .cinematic-projects .cine-title { font-size: 28px; }
  .cinematic-projects .cine-desc { font-size: 11px; }
  .cinematic-projects .cine-title-block { top: 16px; left: 18px; right: 18px; }
  .cinematic-projects .cine-camera-stage { bottom: 16px; left: 16px; }
  .cinematic-projects .cine-camera-btn { width: 72px; height: 72px; }
  .cinematic-projects .cine-camera-svg { width: 56px; height: 56px; }
  .cinematic-projects .cine-controls { padding: 52px 14px 14px; }
  .cinematic-projects .cine-time { font-size: 11px; padding: 0 3px; }
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-projects *,
  .cinematic-projects *::before,
  .cinematic-projects *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
</style>

<script>
(function () {
  'use strict';

  /* ---------- Vimeo SDK loader ---------- */
  let sdkPromise;
  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) return Promise.resolve(window.Vimeo);
    if (sdkPromise) return sdkPromise;
    sdkPromise = new Promise(function (resolve, reject) {
      const s = document.createElement('script');
      const t = setTimeout(() => reject(new Error('Vimeo SDK timeout')), 20000);
      s.src = 'https://player.vimeo.com/api/player.js';
      s.async = true;
      s.onload = () => {
        clearTimeout(t);
        (window.Vimeo && window.Vimeo.Player) ? resolve(window.Vimeo) : reject(new Error('missing'));
      };
      s.onerror = () => { clearTimeout(t); reject(new Error('load failed')); };
      document.head.appendChild(s);
    });
    return sdkPromise;
  }

  function withTimeout(p, ms) {
    return new Promise((res, rej) => {
      const t = setTimeout(() => rej(new Error('timeout')), ms);
      Promise.resolve(p).then(v => { clearTimeout(t); res(v); }, e => { clearTimeout(t); rej(e); });
    });
  }

  function fmt(s) {
    const v = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(v / 3600);
    const m = Math.floor((v % 3600) / 60);
    const sec = v % 60;
    const str = String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    return h ? h + ':' + str : str;
  }

  function preconnect() {
    ['https://player.vimeo.com', 'https://i.vimeocdn.com', 'https://f.vimeocdn.com'].forEach(href => {
      if (document.querySelector('link[rel="preconnect"][href="' + href + '"]')) return;
      const l = document.createElement('link');
      l.rel = 'preconnect';
      l.href = href;
      l.crossOrigin = '';
      document.head.appendChild(l);
    });
  }

  /* ---------- Wait for GSAP to be ready ---------- */
  function waitForGSAP(maxMs) {
    return new Promise(resolve => {
      const start = Date.now();
      (function poll() {
        if (window.gsap && window.MorphSVGPlugin) return resolve(true);
        if (Date.now() - start > (maxMs || 3000)) return resolve(false);
        requestAnimationFrame(poll);
      })();
    });
  }

  /* ---------- Init ---------- */
  function initialize() {
    preconnect();
    const sections = document.querySelectorAll('[data-cinema]');
    if (!sections.length) return;

    waitForGSAP(3000).then(hasGSAP => {
      sections.forEach(root => initSection(root, hasGSAP));
    });
  }

  function initSection(root, hasGSAP) {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const q  = sel => root.querySelector(sel);
    const qa = sel => Array.from(root.querySelectorAll(sel));

    const videoLayer   = q('[data-video-layer]');
    const cameraBtn    = q('[data-camera-btn]');
    const cameraStage  = q('[data-camera-stage]');
    const titleBlock   = q('[data-title-block]');
    const filmTitle    = q('[data-film-title]');
    const filmDesc     = q('[data-film-desc]');
    const controls     = q('[data-controls]');
    const playpauseBtn = q('[data-playpause-btn]');
    const ppPath       = q('.pp-path');
    const volumeBtn    = q('[data-volume-btn]');
    const volumeSlider = q('[data-volume-slider]');
    const timeEl       = q('[data-time]');
    const speedBtn     = q('[data-speed-btn]');
    const speedMenu    = q('[data-speed-menu]');
    const qualityBtn   = q('[data-quality-btn]');
    const qualityMenu  = q('[data-quality-menu]');
    const qualityLabel = q('[data-quality-label]');
    const fullscreenBtn = q('[data-fullscreen-btn]');
    const progress     = q('[data-progress]');
    const progressFill = q('[data-progress-fill]');

    filmTitle.textContent = root.dataset.title || '';
    filmDesc.textContent  = root.dataset.subtitle || '';

    let player = null;
    let prepPromise = null;
    let ready = false;
    let failed = false;
    let morphing = false;
    let morphDone = false;
    let started = false;
    let duration = 0;
    let current = 0;
    let seeking = false;
    let idleTimer = null;
    let muted = true;
    let qualities = [];
    let currentQuality = 'auto';
    let lastVolume = 1;

    function setState(s) {
      root.dataset.state = s;
      if (s === 'playing') {
        root.classList.add('is-ui-visible');
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(() => root.classList.remove('is-ui-visible'), 3000);
      } else if (s === 'paused') {
        root.classList.add('is-ui-visible');
        if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      }
    }

    function setPlayPauseIcon(playing) {
      if (!ppPath) return;
      ppPath.setAttribute('d', playing
        ? 'M6 19h4V5H6v14zm8-14v14h4V5h-4z'
        : 'M8 5v14l11-7z');
      if (playpauseBtn) playpauseBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    }

    function setVolumeIcon(volume, isMuted) {
      if (!volumeBtn) return;
      const v = isMuted ? 0 : volume;
      volumeBtn.setAttribute('aria-label', v === 0 ? 'Unmute film' : 'Mute film');
      let d;
      if (v === 0) {
        d = 'M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z';
      } else if (v < 0.5) {
        d = 'M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z';
      } else {
        d = 'M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z';
      }
      volumeBtn.querySelector('path').setAttribute('d', d);
    }

    function updateTime() {
      const pct = duration > 0 ? (current / duration * 100) : 0;
      if (!seeking) {
        progress.value = duration > 0 ? Math.round(current / duration * 1000) : 0;
        if (progressFill) progressFill.style.transform = 'scaleX(' + (pct / 100) + ')';
      }
      if (timeEl) timeEl.textContent = fmt(current) + ' / ' + fmt(duration);
    }

    function buildQualityMenu() {
      if (!qualityMenu) return;
      qualityMenu.innerHTML = '';
      const items = [{ id: 'auto', label: 'Auto' }]
        .concat(qualities.map(o => ({ id: o.id, label: o.label || (o.id + 'p') })));
      items.forEach(it => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cine-popup-item' + (String(it.id) === String(currentQuality) ? ' is-active' : '');
        b.textContent = it.label;
        b.addEventListener('click', e => {
          e.stopPropagation();
          withTimeout(player.setQuality(it.id), 8000)
            .then(actual => {
              currentQuality = actual;
              if (qualityLabel) qualityLabel.textContent = actual === 'auto' ? 'Auto' : actual + 'p';
              buildQualityMenu();
            })
            .catch(() => {})
            .finally(() => { qualityMenu.hidden = true; });
        });
        qualityMenu.appendChild(b);
      });
    }

    function fail(err) {
      if (failed) return;
      failed = true;
      console.warn('[Cinema] failed:', err);
      if (cameraBtn) cameraBtn.disabled = true;
    }

    function prepare() {
      if (prepPromise) return prepPromise;
      prepPromise = (async () => {
        const Vimeo = await loadVimeoSDK();
        const vid = String(root.dataset.videoId || '');
        if (!/^\d+$/.test(vid)) throw new Error('Invalid Vimeo ID');

        const iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + vid +
          '?background=1&autoplay=0&loop=0&byline=0&title=0&portrait=0&controls=0&muted=1&playsinline=1&keyboard=0&dnt=1';
        iframe.title = 'Film';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        iframe.tabIndex = -1;
        iframe.setAttribute('loading', 'eager');
        videoLayer.appendChild(iframe);

        player = new Vimeo.Player(iframe);

        player.on('play',  () => {
          root.classList.remove('is-ended');
          setState('playing');
          setPlayPauseIcon(true);
        });
        player.on('pause', () => { setState('paused');  setPlayPauseIcon(false); });
        player.on('ended', () => {
          setState('paused');
          setPlayPauseIcon(false);
          current = duration;
          updateTime();
          root.classList.add('is-ended');
        });
        player.on('timeupdate', e => {
          current = Number(e.seconds) || 0;
          duration = Number(e.duration) || duration;
          updateTime();
        });
        player.on('durationchange', e => {
          duration = Number(e.duration) || 0;
          updateTime();
        });
        player.on('volumechange', e => {
          muted = Boolean(e.muted) || e.volume === 0;
          if (e.volume > 0) lastVolume = e.volume;
          if (volumeSlider) volumeSlider.value = e.volume;
          setVolumeIcon(e.volume, muted);
        });
        player.on('qualitychange', e => {
          if (e && e.id) {
            currentQuality = e.id;
            if (qualityLabel) qualityLabel.textContent = e.id === 'auto' ? 'Auto' : e.id + 'p';
            buildQualityMenu();
          }
        });
        player.on('error', e => {
          const ignore = ['setQuality','getQuality','getQualities','setPlaybackRate','setCurrentTime','setMuted','setVolume','getMuted','getPaused','getDuration','getVolume'];
          if (e && e.method && ignore.indexOf(e.method) !== -1) return;
          fail(e);
        });

        await withTimeout(player.ready(), 20000);
        ready = true;
        progress.disabled = false;
        player.getDuration().then(v => { duration = Number(v) || 0; updateTime(); }).catch(() => {});
        player.getMuted().then(m => { muted = m; setVolumeIcon(1, m); }).catch(() => {});
        player.getVolume().then(v => { if (volumeSlider) volumeSlider.value = v; }).catch(() => {});
        player.getQualities().then(arr => {
          if (Array.isArray(arr) && arr.length) {
            qualities = arr;
            buildQualityMenu();
          }
        }).catch(() => {});
      })().catch(fail);
      return prepPromise;
    }

    /* ---------- The magical morph ---------- */
    function runMorphAndStart() {
      if (morphing || morphDone || failed) return;
      morphing = true;
      root.classList.add('is-morphing');

      // Kick video load in parallel
      prepare().then(() => {
        if (!ready || !player) return;
        player.play().catch(() => {});
      });

      const cleanupAndStart = () => {
        morphing = false;
        morphDone = true;
        root.classList.remove('is-morphing');
        setState('paused');
        setPlayPauseIcon(true); // will be corrected by vimeo play event
        started = true;
      };

      if (hasGSAP) {
        window.gsap.registerPlugin(window.MorphSVGPlugin);
        const tl = window.gsap.timeline({ onComplete: cleanupAndStart });

        // 1) Title + description fade out softly (0 → 550ms)
        tl.to(titleBlock, { opacity: 0, y: -18, filter: 'blur(4px)', duration: 0.55, ease: 'power2.out' }, 0);

        // 2) Light beam appears (150 → 900ms)
        tl.to(q('[data-light]'), { opacity: 1, duration: 0.75, ease: 'power2.out' }, 0.15);

        // 3) Holes fade out (200 → 500ms)
        tl.to(qa('.cam-holes circle'), { opacity: 0, duration: 0.3, ease: 'power2.out' }, 0.2);

        // 4) Body fades out (250 → 650ms)
        tl.to(q('.cam-body'), { opacity: 0, duration: 0.4, ease: 'power2.out' }, 0.25);

        // 5) Reels morph into pause bars (300 → 1100ms)
        tl.to(q('.cam-reel-left'), {
          morphSVG: { shape: q('.morph-left'), shapeIndex: 'auto' },
          duration: 0.8,
          ease: 'power3.inOut'
        }, 0.3);
        tl.to(q('.cam-reel-right'), {
          morphSVG: { shape: q('.morph-right'), shapeIndex: 'auto' },
          duration: 0.8,
          ease: 'power3.inOut'
        }, 0.3);

        // 6) Camera stage fades away (1150 → 1550ms)
        tl.to(cameraStage, { opacity: 0, duration: 0.4, ease: 'power2.out' }, 1.15);

        // 7) Controls fade in (1300 → 1850ms)
        tl.to(controls, { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' }, 1.3);
      } else {
        // Fallback: no GSAP → just hide camera, show controls
        cameraStage.style.transition = 'opacity 0.5s ease';
        cameraStage.style.opacity = '0';
        controls.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        controls.style.opacity = '1';
        controls.style.transform = 'none';
        setTimeout(cleanupAndStart, 600);
      }
    }

    /* ---------- Events ---------- */
    cameraBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (!morphDone && !morphing) runMorphAndStart();
    });

    playpauseBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (!ready || !player) return;
      if (root.dataset.state === 'playing') player.pause().catch(() => {});
      else player.play().catch(() => {});
    });

    volumeBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (!ready || !player) return;
      if (muted) {
        player.setVolume(lastVolume || 0.8).then(() => player.setMuted(false)).catch(() => {});
      } else {
        player.setMuted(true).catch(() => {});
      }
    });

    if (volumeSlider) {
      volumeSlider.addEventListener('input', e => {
        e.stopPropagation();
        if (!ready || !player) return;
        const v = Number(volumeSlider.value);
        player.setVolume(v).catch(() => {});
        if (v > 0 && muted) player.setMuted(false).catch(() => {});
      });
    }

    speedBtn.addEventListener('click', e => {
      e.stopPropagation();
      speedMenu.hidden = !speedMenu.hidden;
      qualityMenu.hidden = true;
    });

    qa('[data-speed-value]').forEach(b => {
      b.addEventListener('click', e => {
        e.stopPropagation();
        const v = Number(b.dataset.speedValue);
        if (ready && player) {
          player.setPlaybackRate(v).then(() => {
            speedBtn.textContent = v + 'x';
            qa('[data-speed-value]').forEach(x => x.classList.toggle('is-active', x === b));
          }).catch(() => {});
        }
        speedMenu.hidden = true;
      });
    });

    qualityBtn.addEventListener('click', e => {
      e.stopPropagation();
      qualityMenu.hidden = !qualityMenu.hidden;
      speedMenu.hidden = true;
    });

    fullscreenBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (!document.fullscreenElement) root.requestFullscreen().catch(() => {});
      else document.exitFullscreen().catch(() => {});
    });

    progress.addEventListener('input', e => {
      e.stopPropagation();
      seeking = true;
      const pct = Number(progress.value) / 10;
      if (progressFill) progressFill.style.transform = 'scaleX(' + (pct / 100) + ')';
      const preview = duration * Number(progress.value) / 1000;
      if (timeEl) timeEl.textContent = fmt(preview) + ' / ' + fmt(duration);
    });

    progress.addEventListener('change', e => {
      e.stopPropagation();
      if (!ready || !player) return;
      const target = duration * Number(progress.value) / 1000;
      withTimeout(player.setCurrentTime(target), 8000).catch(() => {}).finally(() => {
        seeking = false;
        updateTime();
      });
    });

    progress.addEventListener('blur', () => { seeking = false; updateTime(); });

    // Auto-hide controls on mouse leave while playing
    root.addEventListener('mousemove', () => {
      if (root.dataset.state === 'playing') {
        root.classList.add('is-ui-visible');
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(() => root.classList.remove('is-ui-visible'), 3000);
      }
    });
    root.addEventListener('mouseleave', () => {
      if (root.dataset.state === 'playing') {
        root.classList.remove('is-ui-visible');
        if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      }
    });

    // Close popups when clicking outside
    document.addEventListener('click', e => {
      if (!root.contains(e.target)) return;
      if (!e.target.closest('.cine-speed-wrap')) speedMenu.hidden = true;
      if (!e.target.closest('.cine-quality-wrap')) qualityMenu.hidden = true;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
})();
</script>
