  overflow: hidden;
}
.cinematic-projects .cine-progress-buffer {
  position: absolute; top: 0; left: 0;
  height: 100%; width: 0;
  background: rgba(255,255,255,0.28);
  transition: width 0.3s ease;
}
.cinematic-projects .cine-progress-fill {
  position: absolute; top: 0; left: 0;
  height: 100%; width: 0;
  background: #e53935;
}
.cinematic-projects .cine-progress-input {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  opacity: 0; cursor: pointer;
  margin: 0; padding: 0;
  -webkit-appearance: none; appearance: none;
