</style>

<script>
(function () {
  'use strict';

  // ═══ Reveal on scroll ═══
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('is-visible');
      else entry.target.classList.remove('is-visible');
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.label-reveal').forEach(el => observer.observe(el));

  // Remove first markdown paragraph
  document.querySelectorAll('[data-film-markdown]').forEach(el => {
    el.querySelectorAll('p').forEach(p => {
      const strong = p.querySelector('strong');
      // Case 1: no <strong> → remove whole paragraph
      if (!strong) { p.remove(); return; }
      // Case 2: leading text before <strong> → strip it
      const toRemove = [];
      let found = false;
      p.childNodes.forEach(node => {
        if (found) return;
        if (node === strong) { found = true; return; }
        toRemove.push(node);
      });
      toRemove.forEach(n => n.remove());
    });
  });

  // ═══ Vimeo metadata ═══
  const vimeoCache = new Map();
  function fetchVimeoInfo(id) {
    if (!id) return Promise.resolve(null);
    if (vimeoCache.has(id)) return Promise.resolve(vimeoCache.get(id));
    return new Promise(resolve => {
      const cb = 'vi_' + Date.now() + '_' + Math.random().toString(36).slice(2);
      const s = document.createElement('script');
      let done = false;
      const cleanup = () => {
        if (done) return; done = true;
        window[cb] = function () {};  // no-op (Vimeo may still call it late)
        if (s.parentNode) s.parentNode.removeChild(s);
      };
      window[cb] = (data) => {
        const p = data || null;
        if (p && p.description) {
          p.description = String(p.description).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
        }
        vimeoCache.set(id, p);
        resolve(p);
        cleanup();
      };
      s.src = 'https://vimeo.com/api/oembed.json?url=' +
        encodeURIComponent('https://vimeo.com/' + id) + '&callback=' + cb;
      s.async = true;
      s.onerror = () => { vimeoCache.set(id, null); resolve(null); cleanup(); };
      document.head.appendChild(s);
      setTimeout(() => { if (!done) { resolve(null); cleanup(); } }, 6000);
    });
  }

  const avatarCache = new Map();
  function fetchAvatar(username) {
    if (!username) return Promise.resolve('');
    if (avatarCache.has(username)) return Promise.resolve(avatarCache.get(username));
    return new Promise(resolve => {
      const cb = 'va_' + Date.now() + '_' + Math.random().toString(36).slice(2);
      const s = document.createElement('script');
      let done = false;
      const cleanup = () => {
        if (done) return; done = true;
        window[cb] = function () {};  // no-op (Vimeo may still call it late)
        if (s.parentNode) s.parentNode.removeChild(s);
      };
      window[cb] = (data) => {
        const url = (data && (data.portrait_large || data.portrait_medium || data.portrait_small)) || '';
        avatarCache.set(username, url);
        resolve(url);
        cleanup();
      };
      s.src = 'https://vimeo.com/api/v2/' + encodeURIComponent(username) + '/info.json?callback=' + cb;
      s.async = true;
      s.onerror = () => { avatarCache.set(username, ''); resolve(''); cleanup(); };
      document.head.appendChild(s);
      setTimeout(() => { if (!done) { resolve(''); cleanup(); } }, 5000);
    });
  }

  document.querySelectorAll('[data-cinema]').forEach(cinema => {
    const vimeoId = cinema.dataset.vimeoId;
    if (!vimeoId) return;
    const descEl = cinema.querySelector('[data-film-desc]');
    const endDescEl = cinema.querySelector('[data-end-desc]');
    const endAuthorEl = cinema.querySelector('[data-end-author]');
    fetchVimeoInfo(vimeoId).then(info => {
      if (!info) return;
      if (info.description) {
        if (descEl) descEl.textContent = info.description;
        if (endDescEl) endDescEl.textContent = info.description;
      }
      if (info.author_name && endAuthorEl) endAuthorEl.textContent = info.author_name;
      const m = (info.author_url || '').match(/vimeo\.com\/([^\/?#]+)/);
      if (m) {
        const img = cinema.querySelector('[data-vimeo-avatar]');
        if (img && !img.dataset.fetched) {
          img.dataset.fetched = '1';
          fetchAvatar(m[1]).then(url => {
            if (!url) return;
            img.src = url;
            img.onload = () => img.classList.add('is-loaded');
            img.onerror = () => img.removeAttribute('src');
          });
        }
      }
    }).catch(() => {});
  });

  // ═══ Format time ═══
  function fmt(s) {
    s = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    const mm = String(m).padStart(2, '0');
    const ss = String(sec).padStart(2, '0');
    return h ? h + ':' + mm + ':' + ss : mm + ':' + ss;
  }

  // ═══════════════════════════════════════════════════════
  // Init each player
  // ═══════════════════════════════════════════════════════
  document.querySelectorAll('[data-cinema]').forEach(root => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const video = root.querySelector('[data-video]');
    if (!video) return;

    const screenEl = root.querySelector('.cinema-screen') || root;
    const progressWrap = root.querySelector('[data-progress-wrap]');
    const progressInput = root.querySelector('[data-progress]');
    const progressFill = root.querySelector('[data-progress-fill]');
    const progressBuffer = root.querySelector('[data-progress-buffer]');
    const playBtn = root.querySelector('[data-playpause]');
    const iconPlay = root.querySelector('.cine-pp-play');
    const iconPause = root.querySelector('.cine-pp-pause');
    const volumeBtn = root.querySelector('[data-volume]');
    const iconVolOn = root.querySelector('.cine-icon-vol-on');
    const iconVolOff = root.querySelector('.cine-icon-vol-off');
    const volumeSlider = root.querySelector('[data-volume-slider]');
    const timeEl = root.querySelector('[data-time]');
    const settingsTrigger = root.querySelector('[data-settings-trigger]');
    const settingsMenu = root.querySelector('[data-settings-menu]');
    const replayBtn = root.querySelector('[data-replay]');

    let idleTimer = null;
    let isSeeking = false;
    let lastVolume = 1;

    // ═══════════════════════════════════════════════════
    // UI visibility — hover-driven only
    // ═══════════════════════════════════════════════════
    function showUI() {
      if (!root.classList.contains('has-started')) return;
      if (root.classList.contains('is-loading')) return;
      if (root.classList.contains('is-ended')) return;

      root.classList.remove('is-showing-title');
      root.classList.add('is-ui-visible');
      if (idleTimer) clearTimeout(idleTimer);

      if (!video.paused) {
        // Playing: hide after 3s
        idleTimer = setTimeout(() => {
          if (!video.paused && !video.ended) {
            root.classList.remove('is-ui-visible');
          }
        }, 3000);
      } else if (video.paused && !video.ended) {
        // Paused: after 3s show title, hide controls
        idleTimer = setTimeout(() => {
          if (video.paused && !video.ended && !root.classList.contains('is-loading')) {
            root.classList.add('is-showing-title');
            root.classList.remove('is-ui-visible');
          }
        }, 3000);
      }
    }

    function hideUI(showTitle) {
      root.classList.remove('is-ui-visible');
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      if (showTitle) {
        root.classList.add('is-showing-title');
      }
    }

    // ── Hover on video area ──
    screenEl.addEventListener('mousemove', showUI);
    screenEl.addEventListener('mouseenter', showUI);

    // ── Mouse leaves video area → hide controls ──
    screenEl.addEventListener('mouseleave', () => {
      if (video.ended) return;
      // Hide controls immediately
      // If paused → also show title (idle state)
      hideUI(video.paused && root.classList.contains('has-started'));
    });

    // ═══════════════════════════════════════════════════
    // Play/Pause icon toggle
    // ═══════════════════════════════════════════════════
    function updatePlayIcon() {
      if (!iconPlay || !iconPause) return;
      if (video.paused) {
        iconPlay.style.display = '';
        iconPause.style.display = 'none';
        root.classList.add('is-paused');
        root.classList.remove('is-playing');
        if (playBtn) playBtn.setAttribute('aria-label', 'Play');
      } else {
        iconPlay.style.display = 'none';
        iconPause.style.display = '';
        root.classList.remove('is-paused');
        root.classList.add('is-playing');
        if (playBtn) playBtn.setAttribute('aria-label', 'Pause');
      }
    }

    // ═══════════════════════════════════════════════════
    // Play / Pause
    // ═══════════════════════════════════════════════════
    function togglePlay() {
      if (video.paused || video.ended) {
        if (video.ended) {
          root.classList.remove('is-ended');
          video.currentTime = 0;
        }
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    }

    function firstPlay() {
      if (root.classList.contains('has-played-once')) {
        togglePlay();
        return;
      }
      root.classList.add('has-played-once', 'is-loading');
      const hideDots = () => root.classList.remove('is-loading');
      video.addEventListener('playing', hideDots, { once: true });
      setTimeout(hideDots, 2000);
      video.play().catch(() => hideDots());
    }

    video.addEventListener('play', () => {
      root.classList.add('has-started');
      root.classList.remove('is-ended', 'is-showing-title');
      updatePlayIcon();
      showUI();
    });

    video.addEventListener('pause', () => {
      if (root.classList.contains('is-ended')) return;
      updatePlayIcon();
      root.classList.remove('is-showing-title');
      root.classList.add('is-ui-visible');
      if (idleTimer) clearTimeout(idleTimer);
      // After 3s: show title + hide controls
      idleTimer = setTimeout(() => {
        if (video.paused && !video.ended && !root.classList.contains('is-loading')) {
          root.classList.add('is-showing-title');
          root.classList.remove('is-ui-visible');
        }
      }, 3000);
    });

    video.addEventListener('ended', () => {
      root.classList.add('is-ended');
      root.classList.remove('is-playing', 'is-showing-title');
      updatePlayIcon();
      hideUI(false);
    });

    video.addEventListener('loadedmetadata', () => {
      root.classList.remove('is-ended');
      updatePlayIcon();
      updateTime();
    });

    if (playBtn) playBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (!root.classList.contains('has-played-once') && (video.paused || video.ended)) {
        firstPlay();
      } else {
        togglePlay();
      }
    });

    video.addEventListener('click', () => {
      if (!root.classList.contains('has-played-once')) {
        firstPlay();
      } else if (video.paused || video.ended) {
        togglePlay();
      } else {
        video.pause();
      }
    });

    

    // ═══════════════════════════════════════════════════
    // Double-tap on left side → rewind 5s
    // ═══════════════════════════════════════════════════
    const dtapFeedback = root.querySelector('[data-dtap-feedback]');
    let lastTapTime = 0;
    let lastTapX = 0;
    let lastTapY = 0;
    let tapFeedbackTimer = null;

    function showDtapFeedback() {
      if (!dtapFeedback) return;
      dtapFeedback.classList.add('is-active');
      if (tapFeedbackTimer) clearTimeout(tapFeedbackTimer);
      tapFeedbackTimer = setTimeout(() => {
        dtapFeedback.classList.remove('is-active');
      }, 650);
    }

    screenEl.addEventListener('click', (e) => {
      // Ignore if click is on controls
      if (e.target.closest('.cine-controls') ||
          e.target.closest('.cine-progress') ||
          e.target.closest('.cine-menu-wrap') ||
          e.target.closest('.end-card-replay')) return;

      const now = Date.now();
      const rect = screenEl.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const relX = x / rect.width;

      const isDoubleTap = (now - lastTapTime < 320);
      const samePosition = Math.abs(x - lastTapX) < 60 && Math.abs(y - lastTapY) < 60;

      if (isDoubleTap && samePosition) {
        // Left side → rewind 5s
        if (relX < 0.4) {
          e.stopPropagation();
          e.preventDefault();
          video.currentTime = Math.max(0, video.currentTime - 5);
          showDtapFeedback();
          lastTapTime = 0;
          return;
        }
      }

      lastTapTime = now;
      lastTapX = x;
      lastTapY = y;
    }, true); // capture phase so we get it before play/pause toggle

    // ── Time + progress ──
    function updateTime() {
      const d = video.duration || 0;
      const c = video.currentTime || 0;
      if (timeEl) timeEl.textContent = fmt(c) + ' / ' + fmt(d);
      if (!isSeeking) {
        const pct = d > 0 ? (c / d) : 0;
        if (progressFill) progressFill.style.width = (pct * 100) + '%';
        if (progressInput) progressInput.value = Math.round(pct * 1000);
      }
    }
    video.addEventListener('timeupdate', updateTime);
    video.addEventListener('durationchange', updateTime);

    function updateBuffer() {
      if (!progressBuffer || !video.buffered.length || !video.duration) return;
      const end = video.buffered.end(video.buffered.length - 1);
      progressBuffer.style.width = (end / video.duration * 100) + '%';
    }
    video.addEventListener('progress', updateBuffer);
    video.addEventListener('loadeddata', updateBuffer);

    if (progressWrap && progressInput) {
      progressInput.addEventListener('input', () => {
        isSeeking = true;
        const pct = Number(progressInput.value) / 1000;
        if (progressFill) progressFill.style.width = (pct * 100) + '%';
        if (timeEl) timeEl.textContent = fmt(pct * (video.duration || 0)) + ' / ' + fmt(video.duration || 0);
      });
      progressInput.addEventListener('change', () => {
        video.currentTime = (Number(progressInput.value) / 1000) * (video.duration || 0);
        isSeeking = false;
      });
    }

    // ── Volume ──
    function updateVolumeIcon() {
      const muted = video.muted || video.volume === 0;
      if (iconVolOn) iconVolOn.style.display = muted ? 'none' : '';
      if (iconVolOff) iconVolOff.style.display = muted ? '' : 'none';
      if (volumeBtn) volumeBtn.setAttribute('aria-label', muted ? 'Unmute' : 'Mute');
    }
    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        const v = Number(volumeSlider.value);
        video.volume = v;
        video.muted = v === 0;
        if (v > 0) lastVolume = v;
      });
    }
    if (volumeBtn) volumeBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (video.muted || video.volume === 0) {
        video.volume = lastVolume || 1;
        video.muted = false;
      } else {
        lastVolume = video.volume;
        video.muted = true;
      }
      updateVolumeIcon();
      if (volumeSlider) volumeSlider.value = video.muted ? 0 : video.volume;
    });
    video.addEventListener('volumechange', () => {
      updateVolumeIcon();
      if (volumeSlider && !volumeSlider.matches(':active')) {
        volumeSlider.value = video.muted ? 0 : video.volume;
      }
    });
    updateVolumeIcon();

    // ── Settings menu ──
    if (settingsTrigger && settingsMenu) {
      settingsTrigger.addEventListener('click', e => {
        e.stopPropagation();
        settingsMenu.hidden = !settingsMenu.hidden;
      });

      // Quality buttons
      settingsMenu.querySelectorAll('[data-quality-value]').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const q = btn.dataset.qualityValue;
          let targetSrc = '';
          video.querySelectorAll('source').forEach(s => {
            if (s.dataset.quality === q) targetSrc = s.src;
          });
          if (!targetSrc || video.src === targetSrc) return;
          const wasPlaying = !video.paused;
          const t = video.currentTime;
          video.src = targetSrc;
          video.load();
          video.addEventListener('loadedmetadata', () => {
            video.currentTime = t;
            if (wasPlaying) video.play().catch(() => {});
          }, { once: true });
          settingsMenu.querySelectorAll('[data-quality-value]').forEach(x =>
            x.classList.toggle('is-active', x === btn));
        });
      });

      // Speed buttons
      settingsMenu.querySelectorAll('[data-speed-value]').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const v = Number(btn.dataset.speedValue);
          video.playbackRate = v;
          settingsMenu.querySelectorAll('[data-speed-value]').forEach(x =>
            x.classList.toggle('is-active', x === btn));
        });
      });

      // Default actives
      const firstQ = settingsMenu.querySelector('[data-quality-value]');
      if (firstQ) firstQ.classList.add('is-active');
      const first1x = settingsMenu.querySelector('[data-speed-value="1"]');
      if (first1x) first1x.classList.add('is-active');
    }

    // Close menu on outside click
    document.addEventListener('click', e => {
      if (!root.contains(e.target)) return;
      if (settingsMenu && !e.target.closest('.cine-menu-wrap')) settingsMenu.hidden = true;
    });

    // ── Fullscreen ──
    const fullscreenBtn = root.querySelector('[data-fullscreen]');
    if (fullscreenBtn) fullscreenBtn.addEventListener('click', e => {
      e.stopPropagation();
      const target = root.querySelector('.cinema-screen') || root;
      if (!document.fullscreenElement) target.requestFullscreen().catch(() => {});
      else document.exitFullscreen().catch(() => {});
    });

    // ── Replay (end card) ──
    if (replayBtn) replayBtn.addEventListener('click', e => {
      e.stopPropagation();
      root.classList.remove('is-ended', 'is-playing', 'is-showing-title');
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    // End-card mini controls
    const endVolumeBtn = root.querySelector('[data-end-volume]');
    const endPlayBtn = root.querySelector('[data-end-play]');
    const endFullscreenBtn = root.querySelector('[data-end-fullscreen]');

    if (endVolumeBtn) endVolumeBtn.addEventListener('click', e => {
      e.stopPropagation();
      if (video.muted || video.volume === 0) {
        video.volume = lastVolume || 1;
        video.muted = false;
      } else {
        lastVolume = video.volume;
        video.muted = true;
      }
      updateVolumeIcon();
      if (volumeSlider) volumeSlider.value = video.muted ? 0 : video.volume;
    });

    if (endPlayBtn) endPlayBtn.addEventListener('click', e => {
      e.stopPropagation();
      root.classList.remove('is-ended', 'is-showing-title');
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    if (endFullscreenBtn) endFullscreenBtn.addEventListener('click', e => {
      e.stopPropagation();
      const target = root.querySelector('.cinema-screen') || root;
      if (!document.fullscreenElement) target.requestFullscreen().catch(() => {});
      else document.exitFullscreen().catch(() => {});
    });
    // ═══════════════════════════════════════════════════
    // Fullscreen change listener
    // ═══════════════════════════════════════════════════
    function handleFullscreenChange() {
      const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
      if (fsEl && (fsEl === screenEl || root.contains(fsEl))) {
        root.classList.add('is-fullscreen');
      } else {
        root.classList.remove('is-fullscreen');
      }
    }
    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
    document.addEventListener('mozfullscreenchange', handleFullscreenChange);
    document.addEventListener('MSFullscreenChange', handleFullscreenChange);

    // ═══════════════════════════════════════════════════
    // ── FOUC fix: clear inline display:none now that CSS is loaded ──
    ['[data-end-card]', '[data-cine-dots]', '[data-controls]',
     '[data-dtap-feedback]', '[data-title-stage]', '[data-progress-wrap]'].forEach(sel => {
      const el = root.querySelector(sel);
      if (el) el.style.display = '';
    });

    updatePlayIcon();
  });
})();
</script>
