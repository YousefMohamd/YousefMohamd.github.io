---
layout: layouts/base.njk
title: Short Film Projects
---

<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/MorphSVGPlugin.min.js" defer></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="w3-text-light-grey section-heading reveal-on-scroll">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project reveal-on-scroll">
        {% if p.data.vimeoId %}
          <section
            class="cinema"
            data-cinema
            data-video-id="{{ p.data.vimeoId | escape }}"
            data-title="{{ p.data.title | escape }}"
            data-subtitle="{{ (p.data.subtitle or '') | escape }}"
            data-state="idle"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <div class="cinema-video" data-video-layer></div>
              <img
                class="cinema-poster"
                data-poster
                src="/img/optimized/projects/short-film/{{ p.data.vimeoId | escape }}.webp"
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width="1920"
                height="1080"
              >

              <div class="cine-light" data-light aria-hidden="true"></div>

              <div class="cine-title-block" data-title-block>
                <h3 class="cine-title" data-film-title></h3>
                <p class="cine-desc" data-film-desc></p>
              </div>

              <div class="cine-end-card" data-end-card aria-hidden="true">
                <div class="end-card-content">
                  <div class="end-card-vimeo-wordmark">Vimeo</div>
                  <div class="end-card-name">Yousef Mohamed</div>
                  <div class="end-card-socials">
                    <a href="https://www.instagram.com/_yousefmohamad/" target="_blank" rel="noopener noreferrer">Instagram</a>
                    <a href="https://vimeo.com/yousefmohamed2004" target="_blank" rel="noopener noreferrer">Vimeo</a>
                  </div>
                </div>
              </div>

              <div class="cine-camera-stage" data-camera-stage>
                <button class="cine-camera-btn" data-camera-btn type="button" aria-label="Play film">
                  <svg class="cbtn-cam" viewBox="0 0 100 115" aria-hidden="true" fill="currentColor">
                    <g class="reel reel-left">
                      <circle cx="30" cy="22" r="16"/>
                      <circle cx="30" cy="12.4" r="2.8" fill="var(--cam-bg,#000)"/>
                      <circle cx="39.6" cy="22" r="2.8" fill="var(--cam-bg,#000)"/>
                      <circle cx="30" cy="31.6" r="2.8" fill="var(--cam-bg,#000)"/>
                      <circle cx="20.4" cy="22" r="2.8" fill="var(--cam-bg,#000)"/>
                      <circle cx="30" cy="22" r="1.4" fill="var(--cam-bg,#000)"/>
                    </g>
                    <g class="reel reel-right">
                      <circle cx="62" cy="21" r="21"/>
                      <circle cx="62" cy="8.4" r="3.6" fill="var(--cam-bg,#000)"/>
                      <circle cx="74" cy="17.1" r="3.6" fill="var(--cam-bg,#000)"/>
                      <circle cx="69.4" cy="31.2" r="3.6" fill="var(--cam-bg,#000)"/>
                      <circle cx="54.6" cy="31.2" r="3.6" fill="var(--cam-bg,#000)"/>
                      <circle cx="50" cy="17.1" r="3.6" fill="var(--cam-bg,#000)"/>
                      <circle cx="62" cy="21" r="1.8" fill="var(--cam-bg,#000)"/>
                      <circle cx="65.5" cy="20" r="0.9" fill="var(--cam-bg,#000)"/>
                    </g>
                    <rect x="16" y="38" width="68" height="26" rx="3"/>
                    <polygon points="16,44 3,40 3,60 16,56"/>
                    <polygon points="84,44 97,36 97,64 84,56"/>
                    <circle cx="50" cy="64" r="3"/>
                    <line x1="43" y1="66" x2="28" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                    <line x1="50" y1="66" x2="50" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                    <line x1="57" y1="66" x2="72" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                  </svg>
                  <span class="camera-label">Yousef Mohamed</span>
                </button>
              </div>

              <div class="cine-controls" data-controls aria-label="Film controls">
                <div class="cine-main-row">
                  <div class="cine-timeline">
                    <div class="cine-timeline-track">
                      <div class="cine-timeline-fill" data-progress-fill></div>
                      <input class="cine-timeline-input" data-progress type="range" min="0" max="1000" step="1" value="0" aria-label="Seek through the film" disabled>
                    </div>
                  </div>
                  <span class="cine-time" data-time>00:00 / 00:00</span>
                </div>

                <div class="cine-btn-row">
                  <div class="cine-btn-left">
                    <div class="cine-camera-label-small">
                      <svg class="cbtn-cam-small" viewBox="0 0 100 115" aria-hidden="true" fill="currentColor">
                        <g class="reel reel-left">
                          <circle cx="30" cy="22" r="16"/>
                          <circle cx="30" cy="12.4" r="2.8" fill="var(--cam-bg,#000)"/>
                          <circle cx="39.6" cy="22" r="2.8" fill="var(--cam-bg,#000)"/>
                          <circle cx="30" cy="31.6" r="2.8" fill="var(--cam-bg,#000)"/>
                          <circle cx="20.4" cy="22" r="2.8" fill="var(--cam-bg,#000)"/>
                          <circle cx="30" cy="22" r="1.4" fill="var(--cam-bg,#000)"/>
                        </g>
                        <g class="reel reel-right">
                          <circle cx="62" cy="21" r="21"/>
                          <circle cx="62" cy="8.4" r="3.6" fill="var(--cam-bg,#000)"/>
                          <circle cx="74" cy="17.1" r="3.6" fill="var(--cam-bg,#000)"/>
                          <circle cx="69.4" cy="31.2" r="3.6" fill="var(--cam-bg,#000)"/>
                          <circle cx="54.6" cy="31.2" r="3.6" fill="var(--cam-bg,#000)"/>
                          <circle cx="50" cy="17.1" r="3.6" fill="var(--cam-bg,#000)"/>
                          <circle cx="62" cy="21" r="1.8" fill="var(--cam-bg,#000)"/>
                          <circle cx="65.5" cy="20" r="0.9" fill="var(--cam-bg,#000)"/>
                        </g>
                        <rect x="16" y="38" width="68" height="26" rx="3"/>
                        <polygon points="16,44 3,40 3,60 16,56"/>
                        <polygon points="84,44 97,36 97,64 84,56"/>
                        <circle cx="50" cy="64" r="3"/>
                        <line x1="43" y1="66" x2="28" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                        <line x1="50" y1="66" x2="50" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                        <line x1="57" y1="66" x2="72" y2="112" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
                      </svg>
                      <span>Yousef Mohamed</span>
                    </div>
                    <button class="cine-playpause" data-playpause-btn type="button" aria-label="Play">
                      <svg class="pp-svg" viewBox="0 0 24 24" aria-hidden="true"><path class="pp-path" d="M8 5v14l11-7z" fill="currentColor"/></svg>
                    </button>
                    <button class="cine-replay" data-replay-btn type="button" aria-label="Replay">
                      <svg viewBox="0 0 24 24" class="cine-btn-icon" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                    </button>
                    <div class="cine-volume">
                      <button class="cine-btn" data-volume-btn type="button" aria-label="Unmute film">
                        <svg viewBox="0 0 24 24" class="cine-btn-icon" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                      </button>
                      <input class="cine-volume-slider" data-volume-slider type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume">
                    </div>
                  </div>

                  <div class="cine-btn-right">
                    <button class="cine-btn cine-btn-text" data-overflow-btn type="button" aria-label="More options">•••</button>
                    <div class="cine-quality-wrap">
                      <button class="cine-btn cine-btn-text" data-quality-btn type="button" aria-label="Video quality">Auto</button>
                      <div class="cine-popup" data-quality-menu hidden></div>
                    </div>
                    <div class="cine-speed-wrap">
                      <button class="cine-btn cine-btn-text" data-speed-btn type="button" aria-label="Playback speed">1x</button>
                      <div class="cine-popup" data-speed-menu hidden>
                        <button class="cine-popup-item" data-speed-value="0.5">0.5x</button>
                        <button class="cine-popup-item" data-speed-value="0.75">0.75x</button>
                        <button class="cine-popup-item is-active" data-speed-value="1">1x</button>
                        <button class="cine-popup-item" data-speed-value="1.25">1.25x</button>
                        <button class="cine-popup-item" data-speed-value="1.5">1.5x</button>
                        <button class="cine-popup-item" data-speed-value="2">2x</button>
                      </div>
                    </div>
                    <button class="cine-btn" data-fullscreen-btn type="button" aria-label="Fullscreen">
                      <svg viewBox="0 0 24 24" class="cine-btn-icon" aria-hidden="true"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description reveal-on-scroll">{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider reveal-on-scroll">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.cinematic-projects {
  --cine-bg: #0a0a0a;
  --cine-surface: rgba(10, 10, 10, 0.85);
  --cine-text: #e6e6e6;
  --cine-desc: #cccccc;
  --cine-accent: #e8d68a;
  --cine-title-font: 'Phosphate', 'Anton', 'Impact', 'Oswald', sans-serif;
  --cine-body-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'AppleSystemUIFont', 'Inter', 'Helvetica Neue', 'Segoe UI', sans-serif;
}

.reveal-on-scroll {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.reveal-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.cinematic-projects .section-heading { font-family: var(--cine-body-font); font-size: clamp(24px, 3vw, 36px); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 48px; color: #f0f0f0; }
.cinematic-projects .film-project { margin-bottom: 56px; }
.cinematic-projects .film-description { font-family: var(--cine-body-font); color: #c8c8c8; line-height: 1.8; font-size: 15px; margin-top: 20px; }
.cinematic-projects .film-divider { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 40px 0; }

.cinematic-projects .cinema { position: relative; isolation: isolate; border-radius: 12px; overflow: hidden; background: #000; box-shadow: 0 24px 72px rgba(0,0,0,0.65); }
.cinematic-projects .cinema-screen { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000; }

.cinematic-projects .cinema-video, .cinematic-projects .cinema-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; opacity: 0; transition: opacity 0.7s ease; pointer-events: none; }
.cinematic-projects .cinema[data-state="playing"] .cinema-video, .cinematic-projects .cinema[data-state="paused"] .cinema-video, .cinematic-projects .cinema[data-state="playing"] .cinema-video iframe, .cinematic-projects .cinema[data-state="paused"] .cinema-video iframe { opacity: 1; }
.cinematic-projects .cinema-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; transition: opacity 0.6s ease; z-index: 2; }
.cinematic-projects .cinema[data-state="playing"] .cinema-poster, .cinematic-projects .cinema[data-state="paused"] .cinema-poster { opacity: 0; pointer-events: none; }

.cinematic-projects .cine-light { position: absolute; inset: 0; z-index: 3; opacity: 0; pointer-events: none; background: radial-gradient(ellipse 60% 60% at 15% 80%, rgba(255, 235, 180, 0.42) 0%, rgba(255, 235, 180, 0.14) 32%, transparent 65%); mix-blend-mode: screen; transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1); }
.cinematic-projects .cinema.is-morphing .cine-light, .cinematic-projects .cinema[data-state="playing"] .cine-light, .cinematic-projects .cinema[data-state="paused"] .cine-light { opacity: 1; }

.cinematic-projects .cine-title-block { position: absolute; top: 28px; left: 32px; right: 32px; z-index: 8; display: flex; flex-direction: column; gap: 6px; max-width: 620px; pointer-events: none; opacity: 0; transform: translate3d(0, -22px, 0); filter: blur(6px); animation: cine-soft-scroll 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards; }
@keyframes cine-soft-scroll { 0% { opacity: 0; transform: translate3d(0, -22px, 0); filter: blur(6px); } 60% { opacity: 1; filter: blur(0); } 100% { opacity: 1; transform: translate3d(0, 0, 0); filter: blur(0); } }
.cinematic-projects .cine-title { font-family: var(--cine-title-font); font-size: clamp(26px, 4.2vw, 48px); font-weight: 400; line-height: 1; letter-spacing: 0.01em; color: var(--cine-text); margin: 0; text-transform: uppercase; text-shadow: 0 2px 18px rgba(0,0,0,0.85); }
.cinematic-projects .cine-desc { font-family: var(--cine-body-font); font-size: 12px; font-weight: 400; line-height: 1.55; color: var(--cine-desc); margin: 0; max-width: 520px; text-shadow: 0 1px 6px rgba(0,0,0,0.75); }

.cinematic-projects .cinema.is-morphing .cine-title-block, .cinematic-projects .cinema[data-state="playing"] .cine-title-block, .cinematic-projects .cinema[data-state="paused"] .cine-title-block { animation: none; opacity: 0; transform: translate3d(0, -18px, 0); filter: blur(4px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.7s ease; }
.cinematic-projects .cinema.is-ended .cine-title-block { opacity: 0; }

.cinematic-projects .cine-end-card { position: absolute; inset: 0; z-index: 15; display: flex; flex-direction: column; justify-content: center; align-items: center; background: #000; opacity: 0; pointer-events: none; transition: opacity 0.5s ease; }
.cinematic-projects .cinema.is-ended .cine-end-card { opacity: 1; pointer-events: auto; }
.cinematic-projects .end-card-content { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.cinematic-projects .end-card-vimeo-wordmark { font-family: var(--cine-title-font); font-size: 64px; color: #f2f0eb; letter-spacing: -0.02em; }
.cinematic-projects .end-card-name { font-family: var(--cine-body-font); font-size: 18px; color: #f2f0eb; }
.cinematic-projects .end-card-socials { display: flex; gap: 24px; margin-top: 8px; }
.cinematic-projects .end-card-socials a { color: #f2f0eb; text-decoration: none; font-family: var(--cine-body-font); font-size: 14px; transition: opacity 0.2s; }
.cinematic-projects .end-card-socials a:hover { opacity: 0.7; }

.cinematic-projects .cine-camera-stage { position: absolute; bottom: 24px; left: 24px; z-index: 12; opacity: 1; pointer-events: auto; transition: opacity 0.4s ease; }
.cinematic-projects .cinema.is-morphing .cine-camera-stage, .cinematic-projects .cinema[data-state="playing"] .cine-camera-stage, .cinematic-projects .cinema[data-state="paused"] .cine-camera-stage, .cinematic-projects .cinema.is-ended .cine-camera-stage { opacity: 0; pointer-events: none; }
.cinematic-projects .cine-camera-btn { display: inline-flex; align-items: center; gap: 16px; padding: 0; border: none; background: transparent; color: #f2f0eb; cursor: pointer; border-radius: 8px; transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease; }
.cinematic-projects .cine-camera-btn:hover { transform: scale(1.08); background: rgba(255,255,255,0.04); }
.cinematic-projects .cbtn-cam { width: 76px; height: 76px; color: #f2f0eb; --cam-bg: #000; display: block; }
.cinematic-projects .camera-label { font-family: var(--cine-title-font); font-size: 48px; color: #e6e6e6; text-transform: uppercase; letter-spacing: 0.02em; text-shadow: 0 2px 12px rgba(0,0,0,0.85); }

.cinema.is-started .reel-left { animation: spin 5s linear infinite; transform-origin: 30px 22px; }
.cinema.is-started .reel-right { animation: spin 5s linear infinite; transform-origin: 62px 21px; animation-delay: -1.8s; }
@keyframes spin { to { transform: rotate(360deg); } }

.cinematic-projects .cine-controls { position: absolute; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; flex-direction: column; gap: 10px; padding: 64px 22px 18px; background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.72) 42%, rgba(0,0,0,0.24) 78%, rgba(0,0,0,0) 100%); opacity: 0; transform: translate3d(0, 12px, 0); pointer-events: none; transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.cinematic-projects .cinema.is-morphing .cine-controls, .cinematic-projects .cinema[data-state="playing"].is-ui-visible .cine-controls, .cinematic-projects .cinema[data-state="playing"]:hover .cine-controls, .cinematic-projects .cinema[data-state="paused"] .cine-controls, .cinematic-projects .cinema.is-ended .cine-controls { opacity: 1; transform: none; pointer-events: auto; }

.cinematic-projects .cine-main-row { display: flex; align-items: center; gap: 10px; width: 100%; }
.cinematic-projects .cine-timeline { display: flex; align-items: center; flex: 1; min-width: 0; }
.cinematic-projects .cine-timeline-track { position: relative; flex: 1; height: 3px; border-radius: 3px; background: rgba(242, 240, 235, 0.18); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transform: scaleY(1); transform-origin: center; transition: transform 0.2s ease; will-change: transform; }
.cinematic-projects .cine-timeline:hover .cine-timeline-track { transform: scaleY(1.6667); }
.cinematic-projects .cine-timeline-fill { position: absolute; top: 0; left: 0; height: 100%; width: 100%; background: rgba(242, 240, 235, 0.88); border-radius: 3px; pointer-events: none; transform: scaleX(0); transform-origin: left center; box-shadow: 0 0 8px rgba(242,240,235,0.35); will-change: transform; }
.cinematic-projects .cine-timeline-input { position: absolute; inset: -6px 0; width: 100%; height: calc(100% + 12px); margin: 0; padding: 0; appearance: none; -webkit-appearance: none; background: transparent; cursor: pointer; outline: none; z-index: 2; }
.cinematic-projects .cine-timeline-input:disabled { cursor: default; }
.cinematic-projects .cine-timeline-input::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: #f2f0eb; cursor: pointer; box-shadow: 0 0 0 4px rgba(242,240,235,0.18), 0 2px 6px rgba(0,0,0,0.5); }
.cinematic-projects .cine-timeline-input::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: #f2f0eb; cursor: pointer; border: none; }

.cinematic-projects .cine-btn-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cinematic-projects .cine-btn-left, .cinematic-projects .cine-btn-right { display: flex; align-items: center; gap: 4px; }

.cinematic-projects .cine-camera-label-small { display: inline-flex; align-items: center; gap: 8px; margin-right: 8px; }
.cinematic-projects .cbtn-cam-small { width: 24px; height: 24px; color: #f2f0eb; --cam-bg: #000; }
.cinematic-projects .cine-camera-label-small span { font-family: var(--cine-body-font); font-size: 12px; color: #f2f0eb; }

.cinematic-projects .cine-btn { display: inline-flex; align-items: center; justify-content: center; height: 40px; min-width: 40px; padding: 0 10px; border: none; border-radius: 6px; background: transparent; color: #f2f0eb; cursor: pointer; transition: background 0.15s ease, transform 0.15s ease; font-family: var(--cine-body-font); font-size: 12px; font-weight: 500; }
.cinematic-projects .cine-btn:hover { background: rgba(255,255,255,0.09); }
.cinematic-projects .cine-btn:active { transform: scale(0.94); }
.cinematic-projects .cine-btn-icon { width: 22px; height: 22px; fill: currentColor; }
.cinematic-projects .cine-btn-text { color: #f2f0eb; opacity: 0.88; }
.cinematic-projects .cine-btn-text:hover { opacity: 1; }

.cinematic-projects .cine-playpause { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: none; border-radius: 8px; background: transparent; color: #f2f0eb; cursor: pointer; flex: 0 0 auto; transition: background 0.15s ease, transform 0.15s ease; }
.cinematic-projects .cine-playpause:hover { background: rgba(255,255,255,0.09); }
.cinematic-projects .cine-playpause:active { transform: scale(0.94); }
.cinematic-projects .pp-svg { width: 28px; height: 28px; fill: currentColor; }

.cinematic-projects .cine-volume { display: inline-flex; align-items: center; }
.cinematic-projects .cine-volume-slider { width: 80px; height: 3px; margin: 0 0 0 8px; padding: 0; appearance: none; -webkit-appearance: none; background: rgba(242,240,235,0.25); border-radius: 2px; cursor: pointer; outline: none; opacity: 0; transform: scaleX(0); transform-origin: left center; pointer-events: none; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease; will-change: transform, opacity; }
.cinematic-projects .cine-volume:hover .cine-volume-slider, .cinematic-projects .cine-volume-slider:focus { opacity: 1; transform: scaleX(1); pointer-events: auto; }
.cinematic-projects .cine-volume-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 10px; height: 10px; border-radius: 50%; background: #f2f0eb; cursor: pointer; box-shadow: 0 0 0 3px rgba(242,240,235,0.15); }
.cinematic-projects .cine-volume-slider::-moz-range-thumb { width: 10px; height: 10px; border-radius: 50%; background: #f2f0eb; cursor: pointer; border: none; box-shadow: 0 0 0 3px rgba(242,240,235,0.15); }

.cinematic-projects .cine-time { font-family: var(--cine-body-font); font-size: 12px; color: rgba(242, 240, 235, 0.7); font-variant-numeric: tabular-nums; letter-spacing: 0.02em; white-space: nowrap; padding: 0 6px; user-select: none; flex: 0 0 auto; }

.cinematic-projects .cine-speed-wrap, .cinematic-projects .cine-quality-wrap { position: relative; }
.cinematic-projects .cine-popup { position: absolute; bottom: calc(100% + 10px); right: 0; min-width: 100px; padding: 6px; background: var(--cine-surface); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 8px; display: flex; flex-direction: column; gap: 2px; z-index: 40; box-shadow: 0 10px 40px rgba(0,0,0,0.6); }
.cinematic-projects .cine-popup[hidden] { display: none; }
.cinematic-projects .cine-popup-item { background: transparent; border: none; color: #f2f0eb; font-family: var(--cine-body-font); font-size: 12px; font-weight: 500; padding: 7px 12px; text-align: left; border-radius: 5px; cursor: pointer; transition: background 0.12s ease; }
.cinematic-projects .cine-popup-item:hover { background: rgba(255,255,255,0.1); }
.cinematic-projects .cine-popup-item.is-active { background: rgba(232,214,138,0.16); color: var(--cine-accent); }

@media (max-width: 640px) {
  .cinematic-projects .cine-title { font-size: 28px; }
  .cinematic-projects .cine-desc { font-size: 11px; }
  .cinematic-projects .cine-title-block { top: 16px; left: 18px; right: 18px; }
  .cinematic-projects .cine-camera-stage { bottom: 16px; left: 16px; }
  .cinematic-projects .cine-camera-btn { gap: 8px; }
  .cinematic-projects .cbtn-cam { width: 48px; height: 48px; }
  .cinematic-projects .camera-label { font-size: 24px; }
  .cinematic-projects .cine-controls { padding: 52px 14px 14px; }
  .cinematic-projects .cine-time { font-size: 11px; padding: 0 3px; }
  .cinematic-projects .end-card-vimeo-wordmark { font-size: 40px; }
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-projects *, .cinematic-projects *::before, .cinematic-projects *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
</style>

<script>
(function () {
  'use strict';

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      } else {
        entry.target.classList.remove('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));

  let sdkPromise;
  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) return Promise.resolve(window.Vimeo);
    if (sdkPromise) return sdkPromise;
    sdkPromise = new Promise(function (resolve, reject) {
      const s = document.createElement('script');
      const t = setTimeout(() => reject(new Error('Vimeo SDK timeout')), 20000);
      s.src = 'https://player.vimeo.com/api/player.js';
      s.async = true;
      s.onload = () => { clearTimeout(t); (window.Vimeo && window.Vimeo.Player) ? resolve(window.Vimeo) : reject(new Error('missing')); };
      s.onerror = () => { clearTimeout(t); reject(new Error('load failed')); };
      document.head.appendChild(s);
    });
    return sdkPromise;
  }

  function withTimeout(p, ms) {
    return new Promise((res, rej) => { const t = setTimeout(() => rej(new Error('timeout')), ms); Promise.resolve(p).then(v => { clearTimeout(t); res(v); }, e => { clearTimeout(t); rej(e); }); });
  }

  function fmt(s) {
    const v = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(v / 3600);
    const m = Math.floor((v % 3600) / 60);
    const sec = v % 60;
    const str = String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    return h ? h + ':' + str : str;
  }

  function preconnect() {
    ['https://player.vimeo.com', 'https://i.vimeocdn.com', 'https://f.vimeocdn.com'].forEach(href => {
      if (document.querySelector('link[rel="preconnect"][href="' + href + '"]')) return;
      const l = document.createElement('link'); l.rel = 'preconnect'; l.href = href; l.crossOrigin = ''; document.head.appendChild(l);
    });
  }

  function waitForGSAP(maxMs) {
    return new Promise(resolve => {
      const start = Date.now();
      (function poll() { if (window.gsap && window.MorphSVGPlugin) return resolve(true); if (Date.now() - start > (maxMs || 3000)) return resolve(false); requestAnimationFrame(poll); })();
    });
  }

  function initialize() {
    preconnect();
    const sections = document.querySelectorAll('[data-cinema]');
    if (!sections.length) return;
    waitForGSAP(3000).then(hasGSAP => { sections.forEach(root => initSection(root, hasGSAP)); });
  }

  function initSection(root, hasGSAP) {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const q  = sel => root.querySelector(sel);
    const qa = sel => Array.from(root.querySelectorAll(sel));

    const videoLayer = q('[data-video-layer]');
    const cameraBtn = q('[data-camera-btn]');
    const cameraStage = q('[data-camera-stage]');
    const titleBlock = q('[data-title-block]');
    const filmTitles = qa('[data-film-title]');
    const filmDescs = qa('[data-film-desc]');
    const controls = q('[data-controls]');
    const playpauseBtn = q('[data-playpause-btn]');
    const ppPath = q('.pp-path');
    const replayBtn = q('[data-replay-btn]');
    const volumeBtn = q('[data-volume-btn]');
    const volumeSlider = q('[data-volume-slider]');
    const timeEl = q('[data-time]');
    
    const speedBtn = q('[data-speed-btn]');
    const speedMenu = q('[data-speed-menu]');
    const qualityBtn = q('[data-quality-btn]');
    const qualityMenu = q('[data-quality-menu]');
    const fullscreenBtn = q('[data-fullscreen-btn]');

    const progress = q('[data-progress]');
    const progressFill = q('[data-progress-fill]');

    const titleText = root.dataset.title || '';
    const descText = root.dataset.subtitle || '';
    filmTitles.forEach(el => el.textContent = titleText);
    filmDescs.forEach(el => el.textContent = descText);

    let player = null; let prepPromise = null; let ready = false; let failed = false;
    let morphing = false; let morphDone = false; let duration = 0; let current = 0; let seeking = false;
    let idleTimer = null; let muted = true; let currentQuality = 'auto';

    function setState(s) {
      root.dataset.state = s;
      if (s === 'playing') {
        root.classList.remove('is-ended');
        root.classList.add('is-started', 'is-ui-visible');
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(() => root.classList.remove('is-ui-visible'), 3000);
      } else if (s === 'paused') {
        root.classList.add('is-ui-visible');
        if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      } else if (s === 'ended') {
        root.classList.add('is-ended');
        root.classList.add('is-ui-visible');
      }
    }

    function setPlayPauseIcon(playing) {
      if (!ppPath) return;
      ppPath.setAttribute('d', playing ? 'M6 19h4V5H6v14zm8-14v14h4V5h-4z' : 'M8 5v14l11-7z');
      if (playpauseBtn) playpauseBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    }

    function setVolumeIcon(volume, isMuted) {
      if (!volumeBtn) return;
      const v = isMuted ? 0 : volume;
      volumeBtn.setAttribute('aria-label', v === 0 ? 'Unmute film' : 'Mute film');
      let d;
      if (v === 0) d = 'M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z';
      else if (v < 0.5) d = 'M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z';
      else d = 'M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z';
      volumeBtn.querySelector('path').setAttribute('d', d);
    }

    function updateTime() {
      const pct = duration > 0 ? (current / duration * 100) : 0;
      if (!seeking) {
        progress.value = duration > 0 ? Math.round(current / duration * 1000) : 0;
        if (progressFill) progressFill.style.transform = 'scaleX(' + (pct / 100) + ')';
      }
      if (timeEl) timeEl.textContent = fmt(current) + ' / ' + fmt(duration);
    }

    function fail(err) { if (failed) return; failed = true; console.warn('[Cinema] failed:', err); if (cameraBtn) cameraBtn.disabled = true; }

    function prepare() {
      if (prepPromise) return prepPromise;
      prepPromise = (async () => {
        const Vimeo = await loadVimeoSDK();
        const vid = String(root.dataset.videoId || '');
        if (!/^\d+$/.test(vid)) throw new Error('Invalid Vimeo ID');
        const iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + vid + '?background=1&autoplay=0&loop=0&byline=0&title=0&portrait=0&controls=0&muted=1&playsinline=1&keyboard=0&dnt=1';
        iframe.title = 'Film'; iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media'; iframe.allowFullscreen = true; iframe.tabIndex = -1; iframe.setAttribute('loading', 'eager');
        videoLayer.appendChild(iframe);
        player = new Vimeo.Player(iframe);

        player.on('play', () => { root.classList.remove('is-ended'); setState('playing'); setPlayPauseIcon(true); });
        player.on('pause', () => { setState('paused'); setPlayPauseIcon(false); });
        player.on('ended', () => { setState('ended'); setPlayPauseIcon(false); current = duration; updateTime(); });
        player.on('timeupdate', e => { current = Number(e.seconds) || 0; duration = Number(e.duration) || duration; updateTime(); });
        player.on('durationchange', e => { duration = Number(e.duration) || 0; updateTime(); });
        player.on('volumechange', e => { muted = Boolean(e.muted) || e.volume === 0; if (volumeSlider) volumeSlider.value = e.volume; setVolumeIcon(e.volume, muted); });
        player.on('qualitychange', e => { if (e && e.id) { currentQuality = e.id; qualityBtn.textContent = e.id === 'auto' ? 'Auto' : e.id + 'p'; } });
        player.on('error', e => { const ignore = ['setQuality','getQuality','getQualities','setPlaybackRate','setCurrentTime','setMuted','setVolume','getMuted','getPaused','getDuration','getVolume']; if (e && e.method && ignore.indexOf(e.method) !== -1) return; fail(e); });

        await withTimeout(player.ready(), 20000);
        ready = true; progress.disabled = false;
        player.getDuration().then(v => { duration = Number(v) || 0; updateTime(); }).catch(() => {});
        player.getMuted().then(m => { muted = m; setVolumeIcon(1, m); }).catch(() => {});
        player.getVolume().then(v => { if (volumeSlider) volumeSlider.value = v; }).catch(() => {});
        
        player.getQualities().then(qualities => {
          if (!qualityMenu) return;
          qualityMenu.innerHTML = '';
          qualities.forEach(q => {
            const btn = document.createElement('button');
            btn.className = 'cine-popup-item' + (q.id === currentQuality ? ' is-active' : '');
            btn.dataset.qualityValue = q.id;
            btn.textContent = q.id === 'auto' ? 'Auto' : q.id + 'p';
            qualityMenu.appendChild(btn);
          });
        }).catch(() => {});
      })().catch(fail);
      return prepPromise;
    }

    function runMorphAndStart() {
      if (morphing || morphDone || failed) return;
      morphing = true; root.classList.add('is-morphing');
      prepare().then(() => { if (!ready || !player) return; player.play().catch(() => {}); });
      const cleanupAndStart = () => { morphing = false; morphDone = true; root.classList.remove('is-morphing'); setState('paused'); setPlayPauseIcon(true); };
      if (hasGSAP) {
        window.gsap.registerPlugin(window.MorphSVGPlugin);
        const tl = window.gsap.timeline({ onComplete: cleanupAndStart });
        tl.to(titleBlock, { opacity: 0, y: -18, filter: 'blur(4px)', duration: 0.55, ease: 'power2.out' }, 0);
        tl.to(q('[data-light]'), { opacity: 1, duration: 0.75, ease: 'power2.out' }, 0.15);
        tl.to(cameraStage, { opacity: 0, duration: 0.4, ease: 'power2.out' }, 1.15);
        tl.to(controls, { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' }, 1.3);
      } else {
        cameraStage.style.transition = 'opacity 0.5s ease'; cameraStage.style.opacity = '0';
        controls.style.transition = 'opacity 0.5s ease, transform 0.5s ease'; controls.style.opacity = '1'; controls.style.transform = 'none';
        setTimeout(cleanupAndStart, 600);
      }
    }

    cameraBtn.addEventListener('click', e => { e.stopPropagation(); if (!morphDone && !morphing) runMorphAndStart(); });
    playpauseBtn.addEventListener('click', e => { e.stopPropagation(); if (!ready || !player) return; if (root.dataset.state === 'playing') player.pause().catch(() => {}); else player.play().catch(() => {}); });
    if (replayBtn) {
      replayBtn.addEventListener('click', e => {
        e.stopPropagation();
        if (!ready || !player) return;
        player.setCurrentTime(0).then(() => player.play().catch(() => {})).catch(() => {});
      });
    }
    volumeBtn.addEventListener('click', e => { e.stopPropagation(); if (!ready || !player) return; if (muted) { player.setVolume(0.8).then(() => player.setMuted(false)).catch(() => {}); } else { player.setMuted(true).catch(() => {}); } });
    if (volumeSlider) { volumeSlider.addEventListener('input', e => { e.stopPropagation(); if (!ready || !player) return; const v = Number(volumeSlider.value); player.setVolume(v).catch(() => {}); if (v > 0 && muted) player.setMuted(false).catch(() => {}); }); }

    function bindSpeedMenu(btn, menu) {
      btn.addEventListener('click', e => { e.stopPropagation(); menu.hidden = !menu.hidden; if (qualityMenu) qualityMenu.hidden = true; });
      qa('[data-speed-value]', menu).forEach(b => {
        b.addEventListener('click', e => {
          e.stopPropagation(); const v = Number(b.dataset.speedValue);
          if (ready && player) player.setPlaybackRate(v).then(() => { btn.textContent = v + 'x'; qa('[data-speed-value]', menu).forEach(x => x.classList.toggle('is-active', x === b)); }).catch(() => {});
          menu.hidden = true;
        });
      });
    }
    function bindQualityMenu(btn, menu) {
      btn.addEventListener('click', e => { e.stopPropagation(); menu.hidden = !menu.hidden; if (speedMenu) speedMenu.hidden = true; });
      menu.addEventListener('click', e => {
        const b = e.target.closest('[data-quality-value]');
        if (!b) return;
        e.stopPropagation();
        const qVal = b.dataset.qualityValue;
        if (ready && player) player.setQuality(qVal).then(() => { currentQuality = qVal; qa('[data-quality-value]', menu).forEach(x => x.classList.toggle('is-active', x === b)); btn.textContent = qVal === 'auto' ? 'Auto' : qVal + 'p'; }).catch(() => {});
        menu.hidden = true;
      });
    }

    if (speedBtn && speedMenu) bindSpeedMenu(speedBtn, speedMenu);
    if (qualityBtn && qualityMenu) bindQualityMenu(qualityBtn, qualityMenu);

    function handleFullscreen() {
      if (!document.fullscreenElement) root.requestFullscreen().catch(() => {}); else document.exitFullscreen().catch(() => {});
    }
    if (fullscreenBtn) fullscreenBtn.addEventListener('click', e => { e.stopPropagation(); handleFullscreen(); });

    progress.addEventListener('input', e => { e.stopPropagation(); seeking = true; const pct = Number(progress.value) / 10; if (progressFill) progressFill.style.transform = 'scaleX(' + (pct / 100) + ')'; const preview = duration * Number(progress.value) / 1000; if (timeEl) timeEl.textContent = fmt(preview) + ' / ' + fmt(duration); });
    progress.addEventListener('change', e => { e.stopPropagation(); if (!ready || !player) return; const target = duration * Number(progress.value) / 1000; withTimeout(player.setCurrentTime(target), 8000).catch(() => {}).finally(() => { seeking = false; updateTime(); }); });
    progress.addEventListener('blur', () => { seeking = false; updateTime(); });

    root.addEventListener('mousemove', () => { if (root.dataset.state === 'playing') { root.classList.add('is-ui-visible'); if (idleTimer) clearTimeout(idleTimer); idleTimer = setTimeout(() => root.classList.remove('is-ui-visible'), 3000); } });
    root.addEventListener('mouseleave', () => { if (root.dataset.state === 'playing') { root.classList.remove('is-ui-visible'); if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; } } });

    document.addEventListener('click', e => {
      if (!root.contains(e.target)) return;
      if (speedMenu && !e.target.closest('[data-speed-wrap]')) speedMenu.hidden = true;
      if (qualityMenu && !e.target.closest('[data-quality-wrap]')) qualityMenu.hidden = true;
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, { once: true }); else initialize();
})();
</script>
