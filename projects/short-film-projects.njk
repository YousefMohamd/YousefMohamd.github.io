---
layout: layouts/base.njk
title: Short Film Projects
---

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="w3-text-light-grey">Short Film Projects</h2>

{% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project w3-margin-bottom">
        {# Title removed from here, integrated into the player #}

{% if p.data.vimeoId %}
          {% set playerKey = 'cinema-' ~ loop.index %}

<section
            class="cinema"
            data-cinema
            data-video-id="{{ p.data.vimeoId | escape }}"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <div class="cinema-video" data-video-layer></div>

<img
                class="cinema-poster"
                data-poster
                src="/img/optimized/projects/short-film/{{ p.data.vimeoId | escape }}.webp"
                alt=""
                loading="lazy"
                decoding="async"
                width="1920"
                height="1080"
              >

<!-- Title Overlay (Top Left) -->
              <div class="cinema-title-overlay" data-title-overlay>
                <h3 class="cinema-overlay-title">{{ p.data.title }}</h3>
                {% if p.data.subtitle %}
                  <p class="cinema-overlay-subtitle">{{ p.data.subtitle }}</p>
                {% endif %}
              </div>

<!-- Camera Layer (Bottom Left) -->
              <div class="cinema-camera-layer" data-camera-layer>
                <button
                  class="cinema-camera-btn"
                  data-camera
                  type="button"
                  aria-label="Play {{ p.data.title | escape }}"
                >
                  <svg class="cinema-flat-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4zM6 13h2v2H6v-2zm0-3h2v2H6v-2zm3 3h2v2H9v-2zm0-3h2v2H9v-2zm3 3h2v2h-2v-2zm0-3h2v2h-2v-2z"/>
                  </svg>
                  <span class="cinema-play-text" data-caption>Play</span>
                </button>
              </div>

<div class="cinema-beam" data-beam aria-hidden="true"></div>

<div class="cinema-fallback" data-fallback role="alert" hidden>
                <div>
                  <strong>The picture could not start</strong>
                  <p>
                    We could not load the film. Please check your connection
                    and refresh the page.
                  </p>
                  <a
                    href="https://vimeo.com/{{ p.data.vimeoId | escape }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >Watch on Vimeo</a>
                  <button
                    type="button"
                    data-refresh
                    aria-label="Refresh the page"
                  >Refresh</button>
                </div>
              </div>
            </div>

<!-- Modern YouTube-style Controls Bar -->
            <div
              class="cinema-controls"
              data-controls
              aria-label="Film controls"
              hidden
            >
              <div class="cinema-progress-container">
                <input
                  class="cinema-progress"
                  data-progress
                  type="range"
                  min="0"
                  max="1000"
                  step="1"
                  value="0"
                  aria-label="Seek through the film"
                  aria-valuetext="00:00 of 00:00"
                  disabled
                >
                <div class="cinema-progress-buffer"></div>
              </div>

<div class="cinema-control-row">
                <div class="cinema-controls-left">
                  <button type="button" data-toggle aria-label="Play film" class="ctrl-btn">
                    <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                  <button type="button" data-replay aria-label="Replay film" class="ctrl-btn">
                    <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                  </button>
                  <button type="button" data-sound aria-label="Unmute film" class="ctrl-btn">
                    <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                  </button>
                  <span class="cinema-time" data-time aria-live="off">00:00 / 00:00</span>
                </div>

<div class="cinema-controls-right">
                  <label class="ctrl-select-label">
                    <select data-speed aria-label="Playback speed">
                      <option value="0.5">0.5x</option>
                      <option value="1" selected>1x</option>
                      <option value="1.5">1.5x</option>
                      <option value="2">2x</option>
                    </select>
                  </label>
                  <label class="ctrl-select-label">
                    <select data-quality aria-label="Video quality" disabled>
                      <option value="auto">Auto</option>
                    </select>
                  </label>
                </div>
              </div>
            </div>

<p
              class="cinema-status"
              data-status
              role="status"
              aria-live="polite"
            ></p>

<noscript>
              <p>
                <a href="https://vimeo.com/{{ p.data.vimeoId | escape }}">
                  Watch this film on Vimeo
                </a>.
                JavaScript is required for the custom player.
              </p>
            </noscript>
          </section>
        {% endif %}

{% if p.templateContent %}
          <div class="w3-text-grey" style="line-height:1.7;">
            {{ p.templateContent | safe }}
          </div>
        {% endif %}

<hr class="w3-opacity">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/*
 * Modern Cinematic Player Styles
 * Clean, flat, YouTube-inspired controls with smooth animations.
 */

.cinematic-projects .cinema {
  --cinema-bg: #0f0f0f;
  --cinema-ink: #ffffff;
  --cinema-muted: #aaaaaa;
  --cinema-accent: #ff0000; /* YouTube red accent */
  --cinema-space: 16px;

  position: relative;
  isolation: isolate;
  margin-bottom: 40px;
  border-radius: 12px;
  overflow: hidden;
  color: var(--cinema-ink);
  background: var(--cinema-bg);
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.cinematic-projects .cinema [hidden] {
  display: none !important;
}

.cinematic-projects .cinema-screen {
  position: relative;
  isolation: isolate;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

/* Cinematic Fade-in for Video */
.cinematic-projects .cinema-video,
.cinematic-projects .cinema-video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  opacity: 0;
  transition: opacity 1.2s ease-in-out;
  pointer-events: none; /* Let clicks pass to screen */
}

.cinematic-projects .cinema.is-started .cinema-video,
.cinematic-projects .cinema.is-started .cinema-video iframe {
  opacity: 1;
  pointer-events: auto;
}

.cinematic-projects .cinema-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 0.8s ease;
  z-index: 2;
}

.cinematic-projects .cinema.is-started .cinema-poster {
  opacity: 0;
  pointer-events: none;
}

/* Title Overlay (Top Left) */
.cinematic-projects .cinema-title-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 15;
  padding: 24px;
  background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
  opacity: 0;
  transform: translateY(-10px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.cinematic-projects .cinema:hover .cinema-title-overlay,
.cinematic-projects .cinema.controls-visible .cinema-title-overlay {
  opacity: 1;
  transform: translateY(0);
}

.cinematic-projects .cinema-overlay-title {
  margin: 0 0 4px 0;
  font-size: clamp(20px, 3vw, 32px);
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  line-height: 1.2;
}

.cinematic-projects .cinema-overlay-subtitle {
  margin: 0;
  font-size: 14px;
  color: #ddd;
  text-shadow: 0 1px 2px rgba(0,0,0,0.8);
}

/* Camera Layer (Bottom Left) */
.cinematic-projects .cinema-camera-layer {
  position: absolute;
  bottom: 20px;
  left: 20px;
  z-index: 20;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.cinematic-projects .cinema.is-started .cinema-camera-layer {
  opacity: 0;
  pointer-events: none;
  transform: translateY(20px);
}

.cinematic-projects .cinema.is-paused .cinema-camera-layer {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.cinematic-projects .cinema-camera-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background: rgba(0,0,0,0.6);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 12px;
  padding: 16px 24px;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  backdrop-filter: blur(4px);
}

.cinematic-projects .cinema-camera-btn:hover {
  background: rgba(0,0,0,0.8);
  transform: scale(1.05);
}

.cinematic-projects .cinema-flat-icon {
  width: 48px;
  height: 48px;
  fill: #ffffff;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
}

.cinematic-projects .cinema-play-text {
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* Modern Controls Bar */
.cinematic-projects .cinema-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.6) 60%, transparent 100%);
  padding: 0 16px 12px 16px;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.cinematic-projects .cinema.controls-visible .cinema-controls {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* Progress Bar */
.cinematic-projects .cinema-progress-container {
  position: relative;
  width: 100%;
  height: 20px;
  display: flex;
  align-items: center;
  margin-bottom: 8px;
  cursor: pointer;
}

.cinematic-projects .cinema-progress {
  position: absolute;
  width: 100%;
  height: 4px;
  margin: 0;
  padding: 0;
  appearance: none;
  background: rgba(255,255,255,0.3);
  border-radius: 2px;
  cursor: pointer;
  transition: height 0.1s ease;
  z-index: 2;
}

.cinematic-projects .cinema-progress:hover {
  height: 6px;
}

.cinematic-projects .cinema-progress::-webkit-slider-thumb {
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--cinema-accent);
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.cinematic-projects .cinema-progress:hover::-webkit-slider-thumb {
  opacity: 1;
}

.cinematic-projects .cinema-progress::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--cinema-accent);
  cursor: pointer;
  border: none;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.cinematic-projects .cinema-progress:hover::-moz-range-thumb {
  opacity: 1;
}

/* Control Row Layout */
.cinematic-projects .cinema-control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.cinematic-projects .cinema-controls-left,
.cinematic-projects .cinema-controls-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cinematic-projects .ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: #ffffff;
  cursor: pointer;
  transition: background 0.2s ease;
}

.cinematic-projects .ctrl-btn:hover {
  background: rgba(255,255,255,0.1);
}

.cinematic-projects .ctrl-btn svg {
  width: 24px;
  height: 24px;
  fill: currentColor;
}

.cinematic-projects .cinema-time {
  margin-left: 8px;
  color: #dddddd;
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.cinematic-projects .ctrl-select-label {
  display: flex;
  align-items: center;
}

.cinematic-projects .ctrl-select-label select {
  background: transparent;
  border: none;
  color: #dddddd;
  font-size: 13px;
  cursor: pointer;
  outline: none;
}

.cinematic-projects .ctrl-select-label select:hover {
  color: #ffffff;
}

.cinematic-projects .ctrl-select-label select option {
  background: #222;
  color: #fff;
}

/* Status & Fallback */
.cinematic-projects .cinema-status {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(0,0,0,0.8);
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 13px;
  color: #fff;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.cinematic-projects .cinema-status:not(:empty) {
  opacity: 1;
}

.cinematic-projects .cinema-fallback {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.9);
  color: #fff;
  text-align: center;
  padding: 20px;
}

.cinematic-projects .cinema-fallback a,
.cinematic-projects .cinema-fallback button {
  display: inline-block;
  margin-top: 12px;
  padding: 8px 16px;
  background: var(--cinema-accent);
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  border: none;
  cursor: pointer;
}

/* Responsive */
@media (max-width: 600px) {
  .cinematic-projects .cinema-control-row {
    flex-wrap: wrap;
    justify-content: center;
  }
  .cinematic-projects .cinema-controls-left,
  .cinematic-projects .cinema-controls-right {
    width: 100%;
    justify-content: center;
  }
  .cinematic-projects .cinema-time {
    margin-left: 0;
  }
}
</style>

<script>
(function () {
  'use strict';

  let sdkPromise;

  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) {
      return Promise.resolve(window.Vimeo);
    }
    if (!sdkPromise) {
      sdkPromise = new Promise(function (resolve, reject) {
        const script = document.createElement('script');
        const timeout = window.setTimeout(function () {
          reject(new Error('Vimeo SDK loading timed out.'));
        }, 20000);
        script.src = 'https://player.vimeo.com/api/player.js';
        script.async = true;
        script.onload = function () {
          window.clearTimeout(timeout);
          if (window.Vimeo && window.Vimeo.Player) resolve(window.Vimeo);
          else reject(new Error('Vimeo SDK is unavailable.'));
        };
        script.onerror = function () {
          window.clearTimeout(timeout);
          reject(new Error('Vimeo SDK could not be loaded.'));
        };
        document.head.appendChild(script);
      });
    }
    return sdkPromise;
  }

  function withTimeout(promise, milliseconds) {
    return new Promise(function (resolve, reject) {
      const timer = window.setTimeout(function () {
        reject(new Error('The player did not respond in time.'));
      }, milliseconds);
      Promise.resolve(promise).then(function (value) {
        window.clearTimeout(timer);
        resolve(value);
      }, function (error) {
        window.clearTimeout(timer);
        reject(error);
      });
    });
  }

  function formatTime(seconds) {
    const safe = Math.max(0, Math.floor(Number(seconds) || 0));
    const hours = Math.floor(safe / 3600);
    const minutes = Math.floor((safe % 3600) / 60);
    const remainder = safe % 60;
    const short = String(minutes).padStart(2, '0') + ':' + String(remainder).padStart(2, '0');
    return hours ? hours + ':' + short : short;
  }

  function initialize() {
    document.querySelectorAll('[data-cinema]').forEach(function (root) {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const find = function (name) { return root.querySelector('[data-' + name + ']'); };
      const screen = root.querySelector('.cinema-screen');
      const cameraBtn = find('camera');
      const controls = find('controls');
      const toggle = find('toggle');
      const replay = find('replay');
      const sound = find('sound');
      const speed = find('speed');
      const quality = find('quality');
      const progress = find('progress');
      const time = find('time');
      const status = find('status');
      const fallback = find('fallback');
      const poster = find('poster');

      let player;
      let preparation;
      let ready = false;
      let failed = false;
      let started = false;
      let paused = true;
      let muted = true;
      let duration = 0;
      let current = 0;
      let hideTimer;
      let seekEditing = false;

      function showControls() {
        root.classList.add('controls-visible');
        window.clearTimeout(hideTimer);
        if (!started || paused || failed) return;
        hideTimer = window.setTimeout(function () {
          if (!controls.contains(document.activeElement) && !paused && !seekEditing) {
            root.classList.remove('controls-visible');
          }
        }, 3000);
      }

      function setPaused(value) {
        paused = value;
        const playIcon = '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
        const pauseIcon = '<svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
        toggle.innerHTML = value ? playIcon : pauseIcon;
        toggle.setAttribute('aria-label', value ? 'Play film' : 'Pause film');
        
        if (value) {
          root.classList.add('is-paused');
        } else {
          root.classList.remove('is-paused');
        }
        showControls();
      }

      function setMuted(value) {
        muted = value;
        const muteIcon = '<svg viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
        const unmuteIcon = '<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
        sound.innerHTML = value ? muteIcon : unmuteIcon;
        sound.setAttribute('aria-label', value ? 'Unmute film' : 'Mute film');
      }

      function updateTime() {
        time.textContent = formatTime(current) + ' / ' + formatTime(duration);
        progress.disabled = duration <= 0;
        if (!seekEditing) {
          progress.value = duration > 0 ? Math.round(current / duration * 1000) : 0;
          // Update progress bar background fill
          const percent = duration > 0 ? (current / duration * 100) : 0;
          progress.style.background = `linear-gradient(to right, #ff0000 ${percent}%, rgba(255,255,255,0.3) ${percent}%)`;
        }
        progress.setAttribute('aria-valuetext', formatTime(current) + ' of ' + formatTime(duration));
      }

      function fail(error) {
        if (failed) return;
        failed = true;
        window.clearTimeout(hideTimer);
        root.classList.add('has-error');
        root.classList.remove('controls-visible');
        controls.hidden = true;
        cameraBtn.disabled = true;
        fallback.hidden = false;
        status.textContent = '';
        if (player) player.pause().catch(function () {});
        console.warn('Cinematic Vimeo player:', error);
      }

      function notify(message, error) {
        status.textContent = message;
        showControls();
        if (error) console.warn('Cinematic Vimeo control:', error);
      }

      async function loadQualities() {
        try {
          const options = await withTimeout(player.getQualities(), 8000);
          if (failed || !Array.isArray(options) || !options.length) return;
          quality.replaceChildren(new Option('Auto', 'auto'));
          const seen = new Set(['auto']);
          options.forEach(function (option) {
            if (!option || !option.id || seen.has(String(option.id))) return;
            const id = String(option.id);
            seen.add(id);
            quality.add(new Option(String(option.label || id), id));
          });
          try {
            const active = await withTimeout(player.getQuality(), 8000);
            if (seen.has(String(active))) {
              quality.value = String(active);
            }
          } catch (error) {}
          quality.disabled = quality.options.length < 2;
        } catch (error) {
          quality.disabled = true;
        }
      }

      function prepare() {
        if (preparation) return preparation;
        preparation = (async function () {
          const Vimeo = await loadVimeoSDK();
          if (failed) return;
          const videoId = String(root.dataset.videoId || '');
          if (!/^\d+$/.test(videoId)) throw new Error('The project Vimeo ID is invalid.');

          const iframe = document.createElement('iframe');
          iframe.src = 'https://player.vimeo.com/video/' + videoId + '?background=1&autoplay=0&loop=0&byline=0&title=0&portrait=0&controls=0&muted=1&playsinline=1&keyboard=0';
          iframe.title = 'Vimeo film';
          iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
          iframe.allowFullscreen = true;
          iframe.tabIndex = -1;
          find('video-layer').appendChild(iframe);

          player = new Vimeo.Player(iframe);
          player.on('play', function () { setPaused(false); });
          player.on('pause', function () { setPaused(true); });
          player.on('ended', function () { setPaused(true); current = duration; updateTime(); root.classList.add('is-paused'); });
          player.on('timeupdate', function (event) { current = Number(event.seconds) || 0; duration = Number(event.duration) || duration; updateTime(); });
          player.on('durationchange', function (event) { duration = Number(event.duration) || 0; updateTime(); });
          player.on('playbackratechange', function (event) { speed.value = String(event.playbackRate); });
          player.on('qualitychange', function (event) { if (event && event.id) quality.value = String(event.id); });
          player.on('volumechange', function (event) { setMuted(Boolean(event.muted) || event.volume === 0); });
          player.on('error', function (error) {
            if (error && ['setQuality','getQuality','getQualities','setPlaybackRate','setCurrentTime','setMuted','setVolume'].indexOf(error.method) !== -1) return;
            fail(error);
          });

          await withTimeout(player.ready(), 20000);
          if (failed) return;
          ready = true;
          player.getDuration().then(function (value) { duration = Number(value) || 0; updateTime(); }).catch(function () {});
          player.getMuted().then(setMuted).catch(function () {});
          loadQualities();
        })().catch(function (error) { fail(error); });
        return preparation;
      }

      async function launch() {
        if (started && !paused) return;
        cameraBtn.disabled = true;
        status.textContent = 'Preparing the film.';
        await prepare();
        if (failed || !ready) return;
        try {
          await withTimeout(player.play(), 20000);
          if (failed) return;
          started = true;
          root.classList.add('is-started');
          root.classList.remove('is-paused');
          cameraBtn.disabled = false;
          showControls();
        } catch (error) { fail(error); }
      }

      // Event Listeners
      screen.addEventListener('click', function(e) {
        // If clicking on controls or camera, let their handlers deal with it
        if (controls.contains(e.target) || cameraBtn.contains(e.target)) return;
        
        if (!started) {
          launch();
        } else if (paused) {
          player.play().catch(()=>{});
        } else {
          // If playing, clicking screen pauses and shows camera
          player.pause().catch(()=>{});
          root.classList.add('is-paused');
        }
      });

      screen.addEventListener('mousemove', showControls);
      screen.addEventListener('touchstart', showControls, { passive: true });

      cameraBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!started) {
          launch();
        } else {
          player.play().catch(()=>{});
        }
      });

      find('refresh').addEventListener('click', function () { window.location.reload(); });
      poster.addEventListener('error', function () { poster.hidden = true; });

      toggle.addEventListener('click', async function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        toggle.disabled = true;
        try {
          const isPaused = await withTimeout(player.getPaused(), 8000);
          await withTimeout(isPaused ? player.play() : player.pause(), 15000);
        } catch (error) { notify('Playback could not be changed.', error); }
        finally { toggle.disabled = false; }
      });

      replay.addEventListener('click', async function (e) {
        e.stopPropagation();
        replay.disabled = true;
        try {
          await withTimeout(player.setCurrentTime(0).then(function () { return player.play(); }), 15000);
        } catch (error) { notify('The film could not be replayed.', error); }
        finally { replay.disabled = false; }
      });

      sound.addEventListener('click', async function (e) {
        e.stopPropagation();
        sound.disabled = true;
        try {
          await withTimeout(player.setMuted(!muted), 8000);
          setMuted(await withTimeout(player.getMuted(), 8000));
        } catch (error) { notify('Sound could not be changed.', error); }
        finally { sound.disabled = false; }
      });

      speed.addEventListener('change', async function (e) {
        e.stopPropagation();
        const previous = speed.value;
        speed.disabled = true;
        try {
          const actual = await withTimeout(player.setPlaybackRate(Number(speed.value)), 8000);
          speed.value = String(actual);
          status.textContent = '';
        } catch (error) {
          speed.value = previous;
          notify('This film does not support the selected playback speed.', error);
        } finally { speed.disabled = false; }
      });

      quality.addEventListener('change', async function (e) {
        e.stopPropagation();
        const previous = quality.value;
        quality.disabled = true;
        try {
          const actual = await withTimeout(player.setQuality(quality.value), 10000);
          quality.value = String(actual);
          status.textContent = '';
        } catch (error) {
          quality.value = previous;
          notify('Manual quality selection is unavailable.', error);
        } finally { quality.disabled = quality.options.length < 2; }
      });

      progress.addEventListener('input', function (e) {
        e.stopPropagation();
        seekEditing = true;
        showControls();
        const preview = duration * Number(progress.value) / 1000;
        time.textContent = formatTime(preview) + ' / ' + formatTime(duration);
        const percent = Number(progress.value) / 10;
        progress.style.background = `linear-gradient(to right, #ff0000 ${percent}%, rgba(255,255,255,0.3) ${percent}%)`;
      });

      progress.addEventListener('change', async function (e) {
        e.stopPropagation();
        try {
          current = await withTimeout(player.setCurrentTime(duration * Number(progress.value) / 1000), 10000);
        } catch (error) { notify('Seeking failed.', error); }
        finally { seekEditing = false; updateTime(); showControls(); }
      });

      progress.addEventListener('blur', function () { seekEditing = false; updateTime(); });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
})();
</script>
