.cinematic-projects .cine-dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes cine-dots-pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.75); }
  40% { opacity: 1; transform: scale(1); }
}

