---
layout: layouts/base.njk
title: Short Film Projects
---

<div class="w3-padding-64 w3-content">
  <h2 class="w3-text-light-grey">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project w3-margin-bottom">
        <h3 class="w3-text-light-grey" style="margin:18px 0 8px;">{{ p.data.title }}</h3>

        {% if p.data.vimeoId %}
          {% set thumb = vimeoThumbnails[p.data.vimeoId] %}
          <div class="video-wrapper">
            <img
              class="vimeo-thumbnail"
              src="/img/optimized/projects/short-film/{{ p.data.vimeoId }}.webp"
              alt="{{ p.data.title }} Cinematic Thumbnail"
              loading="lazy"
              decoding="async"
              width="1920"
              height="1080"
            >

            <button class="facade-play-btn" type="button" aria-label="Play video">
              <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
                <path d="M8 5.2v13.6L19 12z" fill="currentColor"/>
              </svg>
            </button>

            <iframe
              data-src="https://player.vimeo.com/video/{{ p.data.vimeoId }}?autoplay=1&color=ffffff&title=0&byline=0&portrait=0"
              width="100%"
              height="100%"
              frameborder="0"
              class="lazy-vimeo"
              allow="autoplay; fullscreen"
              allowfullscreen>
            </iframe>
          </div>
        {% endif %}

        {% if p.templateContent %}
          <div class="w3-text-grey" style="line-height:1.7;">
            {{ p.templateContent | safe }}
          </div>
        {% endif %}

        <hr class="w3-opacity">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.video-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background-color: #000;
  cursor: pointer;
  border-radius: 16px;
  overflow: hidden;
  isolation: isolate;
  margin-bottom: 16px;
}

.video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
  z-index: 1;
}

.vimeo-thumbnail {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 2;
  transition: opacity 0.4s ease-out, filter 0.4s ease-out, transform 0.6s ease-out;
  filter: contrast(1.1) saturate(1.12);
  transform: scale(1.01);
}

.video-wrapper:hover .vimeo-thumbnail {
  transform: scale(1.03);
  filter: contrast(1.15) saturate(1.2);
}

.video-wrapper.is-playing .vimeo-thumbnail {
  opacity: 0;
  pointer-events: none;
}

.facade-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70px;
  height: 70px;
  border: 1px solid oklch(1 0 0 / 0.35);
  border-radius: 50%;
  background: oklch(1 0 0 / 0.14);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 3;
  color: #ffffff;
  transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.5, 1), background 0.25s;
}

.facade-play-btn:hover {
  background: oklch(1 0 0 / 0.24);
  transform: translate(-50%, -50%) scale(1.08);
}

.facade-play-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid oklch(1 0 0 / 0.2);
  animation: zigzag-wave 1.2s infinite;
  opacity: 0;
  pointer-events: none;
}

.facade-play-btn:hover::before {
  opacity: 1;
}

@keyframes zigzag-wave {
  0% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.5); opacity: 0.3; }
  100% { transform: scale(2); opacity: 0; }
}

.facade-play-btn svg { fill: currentColor; }

.video-wrapper.is-playing {
  background-image: none !important;
  filter: none !important;
}

.video-wrapper.is-playing .facade-play-btn {
  opacity: 0;
  pointer-events: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.video-wrapper').forEach(wrapper => {
    const iframe = wrapper.querySelector('iframe');
    const playBtn = wrapper.querySelector('.facade-play-btn');

    function loadVideo() {
      if (wrapper.classList.contains('is-playing')) return;
      wrapper.classList.add('is-playing');
      if (iframe && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
      }
    }

    wrapper.addEventListener('click', loadVideo);
    if (playBtn) {
      playBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        loadVideo();
      });
    }
  });
});
</script>
