---
layout: layouts/base.njk
title: Short Film Projects
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/MorphSVGPlugin.min.js" defer></script>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://i.vimeocdn.com" crossorigin>

<div class="w3-padding-64 w3-content cinematic-projects">
  <div class="section-heading-wrap">
    <h2 class="section-heading">Short Film<br>Projects</h2>
  </div>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project" data-film-project>
        {% if p.data.videoSrc or p.data.vimeoId %}
          <section
            class="cinema"
            data-cinema
            data-state="idle"
            data-video-slug="{{ p.data.videoSlug | default('') | escape }}"
            data-vimeo-id="{{ p.data.vimeoId | default('') | escape }}"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <video
                class="cinema-video"
                data-video
                playsinline
                preload="metadata"
                {% if p.data.poster %}poster="{{ p.data.poster }}"{% endif %}
              >
                {% if p.data.videoSlug and site.videoCdn %}
                  <source src="{{ site.videoCdn }}/{{ p.data.videoSlug }}/{{ p.data.videoSlug }}-1080.mp4" data-quality="1080" type="video/mp4">
                  <source src="{{ site.videoCdn }}/{{ p.data.videoSlug }}/{{ p.data.videoSlug }}-720.mp4" data-quality="720" type="video/mp4">
                  <source src="{{ site.videoCdn }}/{{ p.data.videoSlug }}/{{ p.data.videoSlug }}-360.mp4" data-quality="360" type="video/mp4">
                {% endif %}
              </video>
              <!-- Double-tap feedback -->
              <div class="cine-dtap-feedback" data-dtap-feedback aria-hidden="true" style="display:none">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="1 7 1 10 4 10"></polyline>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
                <span>−5s</span>
              </div>


              <!-- Custom controls -->
              <!-- Loading dots (only during first play) -->
              

              <!-- Loading dots (first play only) -->
              <div class="cine-dots" data-cine-dots aria-hidden="true" style="display:none">
                <span></span><span></span><span></span>
              </div>

              <!-- Progress bar: red, thin, at bottom edge -->
              <div class="cine-progress" data-progress-wrap style="display:none">
                <div class="cine-progress-track">
                  <div class="cine-progress-buffer" data-progress-buffer></div>
                  <div class="cine-progress-fill" data-progress-fill></div>
                </div>
                <input type="range" class="cine-progress-input" data-progress min="0" max="1000" step="1" value="0" aria-label="Seek">
              </div>

              <!-- Controls row: left | time | right -->
              <div class="cine-controls" data-controls style="display:none">
                <div class="cine-controls-row">

                  <!-- CENTER: time -->
                  <div class="cine-center-group">
                    <span class="cine-time" data-time>00:00 / 00:00</span>
                  </div>

                  <!-- RIGHT: all controls -->
                  <div class="cine-right-group">

                    <!-- Settings menu (three dots) -->
                    <div class="cine-menu-wrap">
                      <button class="cine-ctrl-btn cine-menu-btn" data-settings-trigger type="button" aria-label="Settings">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <circle cx="6" cy="12" r="1.7"/>
                          <circle cx="12" cy="12" r="1.7"/>
                          <circle cx="18" cy="12" r="1.7"/>
                        </svg>
                      </button>
                      <div class="cine-menu" data-settings-menu hidden>
                        <div class="cine-submenu-wrap">
                          <button class="cine-submenu-trigger" type="button">
                            <span>Quality</span>
                            <svg class="cine-submenu-arrow" viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><path d="M7 10l5 5 5-5z"/></svg>
                          </button>
                          <div class="cine-submenu">
                            <button type="button" data-quality-value="1080">1080p</button>
                            <button type="button" data-quality-value="720">720p</button>
                            <button type="button" data-quality-value="360">360p</button>
                          </div>
                        </div>
                        <div class="cine-submenu-wrap">
                          <button class="cine-submenu-trigger" type="button">
                            <span>Speed</span>
                            <svg class="cine-submenu-arrow" viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><path d="M7 10l5 5 5-5z"/></svg>
                          </button>
                          <div class="cine-submenu">
                            <button type="button" data-speed-value="0.5">0.5x</button>
                            <button type="button" data-speed-value="0.75">0.75x</button>
                            <button type="button" data-speed-value="1">1x</button>
                            <button type="button" data-speed-value="1.25">1.25x</button>
                            <button type="button" data-speed-value="1.5">1.5x</button>
                            <button type="button" data-speed-value="2">2x</button>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Rewind 5s: text "5" + small arrow -->

                    <!-- Volume (vertical slider) -->
                    <div class="cine-volume-wrap">
                      <button class="cine-ctrl-btn" data-volume type="button" aria-label="Mute">
                        <svg class="cine-icon-vol-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M 11 5 L 6 9 L 3 9 L 3 15 L 6 15 L 11 19 Z" fill="currentColor"/>
                          <path d="M 15.5 9.5 a4 4 0 0 1 0 5"/>
                          <path d="M 18 7 a7 7 0 0 1 0 10"/>
                        </svg>
                        <svg class="cine-icon-vol-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                          <path d="M 11 5 L 6 9 L 3 9 L 3 15 L 6 15 L 11 19 Z" fill="currentColor"/>
                          <line x1="16" y1="9" x2="21" y2="14"/>
                          <line x1="21" y1="9" x2="16" y2="14"/>
                        </svg>
                      </button>
                      <div class="cine-volume-slider-wrap">
                        <input type="range" class="cine-volume-slider" data-volume-slider min="0" max="1" step="0.01" value="1" aria-label="Volume">
                      </div>
                    </div>

                    <!-- Play/Pause (last) -->
                    <button class="cine-ctrl-btn cine-pp-btn" data-playpause type="button" aria-label="Play">
                      <svg class="cine-pp-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M 9 5.5 L 9 18.5 L 18.5 12 Z"/>
                      </svg>
                      <svg class="cine-pp-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                        <line x1="9" y1="5.5" x2="9" y2="18.5"/>
                        <line x1="15" y1="5.5" x2="15" y2="18.5"/>
                      </svg>
                    </button>

                    <!-- Fullscreen -->
                    <button class="cine-ctrl-btn" data-fullscreen type="button" aria-label="Fullscreen">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="4 9 4 4 9 4"/>
                        <polyline points="20 9 20 4 15 4"/>
                        <polyline points="4 15 4 20 9 20"/>
                        <polyline points="20 15 20 20 15 20"/>
                      </svg>
                    </button>

                  </div>

                </div>
              </div>

              

              

              

              <div class="cine-fade" data-fade aria-hidden="true"></div>

              <div class="cine-title-stage" data-title-stage style="display:none">
                <div class="cine-title-inner label-reveal">
                  <h3 class="cine-film-title">{{ p.data.title | escape }}</h3>
                  <p class="cine-film-desc" data-film-desc></p>
                </div>
              </div>

              <div class="cine-end-card" data-end-card aria-hidden="true" style="display:none">
                <div class="end-card-glow" aria-hidden="true"></div>
                <div class="end-card-top">
                  <div class="end-card-photo">
                    <span class="end-card-initials">YM</span>
                    <img data-vimeo-avatar alt="" loading="lazy">
                  </div>
                  <div class="end-card-meta">
                    <div class="end-card-profile-name" data-end-author>Yousef Mohamed</div>
                    <div class="end-card-icons">
                      {% if contacts.linkedin %}<a class="linkedin" href="{{ contacts.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>{% endif %}
                      {% if contacts.instagram %}<a class="instagram" href="{{ contacts.instagram }}" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg></a>{% endif %}
                      {% if contacts.vimeo %}<a class="vimeo" href="{{ contacts.vimeo }}" target="_blank" rel="noopener" title="Vimeo" aria-label="Vimeo"><svg viewBox="0 0 24 24"><path d="M23.9765 6.4168c-.105 2.338-1.739 5.5429-4.894 9.6088-3.2679 4.247-6.0258 6.3699-8.2818 6.3699-1.409 0-2.578-1.294-3.553-3.881l-1.9179-7.1138c-.719-2.584-1.488-3.878-2.312-3.878-.179 0-.806.377-1.881 1.132L.0073 7.1971a315.06 315.06 0 0 0 3.501-3.1279c1.579-1.368 2.765-2.085 3.5539-2.159 1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.5069.5389 2.45 1.1309 3.674 1.7759 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.8679 3.434-5.7568 6.7619-5.6368 2.4729.06 3.6279 1.664 3.4799 4.7978z"/></svg></a>{% endif %}
                      {% if contacts.behance %}<a class="behance" href="{{ contacts.behance }}" target="_blank" rel="noopener" title="Behance" aria-label="Behance"><svg viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988H0V5.021h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 8.061-3.207 8.061zM3 11h3.584c2.508 0 2.906-3-.312-3H3v3zm3.391 3H3v3.016h3.341c3.055 0 2.868-3.016.05-3.016z"/></svg></a>{% endif %}
                    </div>
                    {% if contacts.email %}<a class="end-card-email" href="mailto:{{ contacts.email }}">{{ contacts.email }}</a>{% endif %}
                  </div>
                </div>
                <div class="end-card-film">
                  <h3 class="end-card-film-title">{{ p.data.title | escape }}</h3>
                  <p class="end-card-film-desc" data-end-desc></p>
                </div>

                <!-- Mini controls — bottom-right -->
                <div class="end-card-buttons">
                  <button class="end-card-btn end-card-btn-play" data-end-play type="button" aria-label="Play">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M 8 5 L 8 19 L 19 12 Z"/>
                    </svg>
                  </button>
                  <button class="end-card-btn end-card-btn-fullscreen" data-end-fullscreen type="button" aria-label="Fullscreen">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="4 9 4 4 9 4"/>
                      <polyline points="20 9 20 4 15 4"/>
                      <polyline points="4 15 4 20 9 20"/>
                      <polyline points="20 15 20 20 15 20"/>
                    </svg>
                  </button>
                  <button class="end-card-btn end-card-btn-replay" data-replay type="button" aria-label="Replay">
                    <svg class="end-card-replay-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="23 4 23 10 17 10"></polyline>
                      <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                  </button>
                </div>


              </div>
            </div>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description" data-film-markdown>{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.cinematic-projects {
  --cine-surface: rgba(10, 10, 10, 0.85);
  --cine-accent: #e8d68a;
  --cine-title-font: 'Anton', 'Oswald', 'Impact', sans-serif;
  --cine-body-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'AppleSystemUIFont', 'Inter', 'Helvetica Neue', 'Segoe UI', sans-serif;
}

.label-reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.label-reveal.is-visible { opacity: 1; transform: translateY(0); }

.cinematic-projects .film-project { margin-bottom: 56px; }
.cinematic-projects .film-description {
  font-family: var(--cine-body-font);
  color: #c8c8c8; line-height: 1.8; font-size: 15px; margin-top: 20px;
}
.cinematic-projects .film-description p { margin: 0 0 14px 0; }
.cinematic-projects .film-description strong { color: #e6e6e6; font-weight: 600; }
.cinematic-projects .film-description ul { padding-left: 22px; margin: 8px 0 14px 0; }
.cinematic-projects .film-description li { margin-bottom: 4px; }
.cinematic-projects .film-divider {
  border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 40px 0 0 0;
}

.cinematic-projects .cinema {
  position: relative; isolation: isolate; border-radius: 12px; overflow: hidden;
  background: #000; box-shadow: 0 24px 72px rgba(0,0,0,0.65);
}
.cinematic-projects .cinema-screen {
  position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000;
}

/* ── Video layer (iframe) — invisible until started ── */
/* ── Loading dots ── */
@keyframes cine-dot-pulse {
  0%, 80%, 100% { transform: scale(0.55); opacity: 0.35; }
  40%           { transform: scale(1.1);  opacity: 1;   }
}

/* ── Hit area (click anywhere) ── */
/* ── Gradient fade behind title ── */
.cinematic-projects .cine-fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 50%;
  z-index: 7; pointer-events: none;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.58) 20%, rgba(0,0,0,0.38) 42%,
    rgba(0,0,0,0.18) 66%, rgba(0,0,0,0.06) 86%, rgba(0,0,0,0) 100%
  );
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-started .cine-fade { opacity: 0; }

/* ── Title + description ── */
.cinematic-projects .cine-title-stage {
  position: absolute; left: 32px; right: 32px; bottom: 32px; z-index: 8;
  pointer-events: none;
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-started .cine-title-stage {
  opacity: 0; transform: translateY(24px);
}
.cinematic-projects .cine-title-inner {
  display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
}
.cinematic-projects .cine-film-title {
  margin: 0;
  font-family: var(--cine-title-font);
  font-weight: 400;
  font-size: clamp(20px, 3.4vw, 48px);
  line-height: 1.05;
  letter-spacing: 0.01em;
  color: #f2f0eb;
  text-transform: uppercase;
  -webkit-font-smoothing: antialiased;
}
.cinematic-projects .cine-film-desc {
  margin: 0;
  max-width: min(620px, 90%);
  font-family: var(--cine-body-font);
  font-weight: 400;
  font-size: clamp(10px, 1vw, 12px);
  line-height: 1.55;
  color: #cccccc;
  -webkit-font-smoothing: antialiased;
}
.cinematic-projects .cine-film-desc:empty { display: none; }
/* ── Custom controls ── */

/* ── Play/Pause (matches replay weight, no frame) ── */
@media (max-width: 640px) {
  }

@media (max-width: 640px) {
  .cinematic-projects .cine-title-stage { left: 18px; right: 18px; bottom: 20px; }
  .cinematic-projects .cine-film-title { font-size: 30px; }
  .cinematic-projects .cine-film-desc { font-size: 11px; }
  .cinematic-projects .cine-fade { height: 54%; }
  }

/* ── End card ── */
.cinematic-projects .cine-end-card {
  position: absolute; inset: 0; z-index: 15;
  background: #000;
  opacity: 0; pointer-events: none;
  transition: opacity 0.6s ease;
  overflow: hidden;
}
.cinematic-projects .cinema.is-ended .cine-end-card { opacity: 1; pointer-events: auto; }

@media (max-width: 640px) {
  }




/* ═══════════════════════════════════════════════════════════════
   END CARD — Full layout reset (clean rebuild)
   ═══════════════════════════════════════════════════════════════ */

.cinematic-projects .cine-end-card {
  position: absolute; inset: 0;
  z-index: 15;
  background: #000;
  opacity: 0; pointer-events: none;
  transition: opacity 0.6s ease;
  overflow: hidden;
}
.cinematic-projects .cinema.is-ended .cine-end-card {
  opacity: 1; pointer-events: auto;
}

/* Glow (soft golden bottom-left) */
/* ── Top area: profile + meta ── */
/* Profile picture */
/* Meta column (name + icons + email) */
/* ── Bottom-left: film title + desc ── */
/* ── Replay button (small, bottom-left corner) ── */
/* ── Responsive ── */
@media (max-width: 640px) {
  }


/* ═══════════════════════════════════════════════════════════════
   END CARD — Full layout reset (clean rebuild)
   ═══════════════════════════════════════════════════════════════ */

.cinematic-projects .cine-end-card {
  position: absolute; inset: 0;
  z-index: 15;
  background: #000;
  opacity: 0; pointer-events: none;
  transition: opacity 0.6s ease;
  overflow: hidden;
}
.cinematic-projects .cinema.is-ended .cine-end-card {
  opacity: 1; pointer-events: auto;
}

/* Glow (soft golden bottom-left) */
.cinematic-projects .end-card-glow {
  position: absolute;
  left: 0; bottom: 4%;
  width: 70%; height: 60%;
  pointer-events: none;
  background: radial-gradient(
    ellipse at 14% 92%,
    rgba(255, 235, 170, 0.36) 0%,
    rgba(255, 225, 140, 0.20) 22%,
    rgba(255, 215, 110, 0.09) 44%,
    rgba(255, 205, 90, 0.03) 64%,
    transparent 82%
  );
  filter: blur(26px);
  z-index: 1;
}

/* ── Top area: profile + meta ── */
.cinematic-projects .end-card-top {
  position: absolute;
  top: 68px; left: 56px; right: 56px;
  display: flex;
  align-items: flex-start;
  gap: 18px;
  z-index: 2;
}

/* Profile picture */
.cinematic-projects .end-card-photo {
  position: relative;
  width: clamp(64px, 11vw, 130px);
  height: clamp(64px, 11vw, 130px);
  border-radius: 50%;
  background: #1a1a1a;
  border: 1.5px solid rgba(255,255,255,0.12);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; overflow: hidden;
}
.cinematic-projects .end-card-photo img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; border-radius: 50%;
  opacity: 0;
  transition: opacity 0.4s ease;
}
.cinematic-projects .end-card-photo img.is-loaded { opacity: 1; }
.cinematic-projects .end-card-initials {
  font-family: 'Oswald', var(--cine-body-font);
