---
layout: layouts/base.njk
title: Short Film Projects
---

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="w3-text-light-grey section-heading">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project">
        {% if p.data.vimeoId %}
          <section
            class="cinema"
            data-cinema
            data-video-id="{{ p.data.vimeoId | escape }}"
            data-title="{{ p.data.title | escape }}"
            data-subtitle="{{ (p.data.subtitle or '') | escape }}"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <div class="cinema-video" data-video-layer></div>
              <img
                class="cinema-poster"
                data-poster
                src="/img/optimized/projects/short-film/{{ p.data.vimeoId | escape }}.webp"
                alt=""
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width="1920"
                height="1080"
              >

              <!-- Title (top-left only) -->
              <div class="cinema-title-layer">
                <h3 class="cinema-film-title" data-film-title></h3>
                <span class="cinema-film-sub" data-film-sub></span>
              </div>

              <div class="cinema-fallback" data-fallback role="alert" hidden>
                <div>
                  <strong>The picture could not start</strong>
                  <p>We could not load the film. Please check your connection and refresh the page.</p>
                  <a href="https://vimeo.com/{{ p.data.vimeoId | escape }}" target="_blank" rel="noopener noreferrer">Watch on Vimeo</a>
                  <button type="button" data-refresh>Retry</button>
                </div>
              </div>
            </div>

            <!-- Control bar (glass timeline, no frame) -->
            <div class="cinema-controls" data-controls aria-label="Film controls">
              <div class="cinema-progress-wrap" data-progress-wrap>
                <div class="cinema-progress-track">
                  <div class="cinema-progress-fill" data-progress-fill></div>
                  <input
                    class="cinema-progress"
                    data-progress
                    type="range"
                    min="0" max="1000" step="1" value="0"
                    aria-label="Seek through the film"
                    disabled
                  >
                </div>
              </div>

              <div class="cinema-btn-row">
                <div class="cinema-btn-left">
                  <div class="cbtn-cam-wrap">
                    <button class="cbtn-cam-btn" data-cam-btn type="button" aria-label="Play/Pause">
                      <svg class="cbtn-cam" viewBox="0 0 64 64" aria-hidden="true">
                        <!-- Left reel -->
                        <circle cx="22" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="2.2"/>
                        <circle cx="22" cy="16" r="2.2" fill="currentColor"/>
                        <circle cx="22" cy="9" r="1.3" fill="currentColor"/>
                        <circle cx="22" cy="23" r="1.3" fill="currentColor"/>
                        <circle cx="15" cy="16" r="1.3" fill="currentColor"/>
                        <circle cx="29" cy="16" r="1.3" fill="currentColor"/>
                        <!-- Right reel -->
                        <circle cx="42" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="2.2"/>
                        <circle cx="42" cy="16" r="2.2" fill="currentColor"/>
                        <circle cx="42" cy="9" r="1.3" fill="currentColor"/>
                        <circle cx="42" cy="23" r="1.3" fill="currentColor"/>
                        <circle cx="35" cy="16" r="1.3" fill="currentColor"/>
                        <circle cx="49" cy="16" r="1.3" fill="currentColor"/>
                        <!-- Camera body -->
                        <rect x="16" y="26" width="30" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="2.2"/>
                        <rect x="24" y="31" width="13" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.6"/>
                        <circle cx="28" cy="34.5" r="1.1" fill="currentColor"/>
                        <circle cx="33" cy="34.5" r="1.1" fill="currentColor"/>
                        <!-- Lens -->
                        <polygon points="46,30 56,26 56,43 46,39" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                        <circle cx="49.5" cy="34.5" r="1.4" fill="currentColor" opacity="0.7"/>
                        <!-- Back viewfinder -->
                        <polygon points="16,30 12,28 12,35 16,34" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        <!-- Tripod -->
                        <line x1="26" y1="43" x2="19" y2="58" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
                        <line x1="31" y1="43" x2="31" y2="58" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
                        <line x1="36" y1="43" x2="43" y2="58" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
                        <circle cx="31" cy="43" r="1.5" fill="currentColor"/>
                      </svg>
                      <span class="cbtn-cam-state" data-cam-label>Play</span>
                    </button>
                  </div>

                  <button class="cbtn cbtn-toggle" data-toggle type="button" aria-label="Play film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                  <button class="cbtn" data-replay type="button" aria-label="Replay film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                  </button>
                  <button class="cbtn" data-sound type="button" aria-label="Unmute film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                  </button>
                </div>

                <div class="cinema-btn-right">
                  <button class="cbtn cbtn-text" data-speed type="button" aria-label="Playback speed">1x</button>
                  <div class="cinema-quality-wrap">
                    <button class="cbtn cbtn-text" data-quality type="button" aria-label="Video quality">Auto</button>
                    <div class="cinema-quality-menu" data-quality-menu hidden></div>
                  </div>
                  <button class="cbtn" data-fullscreen type="button" aria-label="Fullscreen">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                  </button>
                </div>
              </div>
            </div>

            <p class="cinema-status" data-status role="status" aria-live="polite"></p>
            <noscript>
              <p><a href="https://vimeo.com/{{ p.data.vimeoId | escape }}">Watch on Vimeo</a>. JavaScript required.</p>
            </noscript>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description">{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/* ============================================================
   Cinematic Player v3
   States on .cinema:
     (pre-start)       → magical intro, controls reveal then fade
     is-started        → video playing, camera icon persistent
     is-hover          → title + camera light + state label
     ui-open           → user is interacting
     is-paused         → full bar revealed right→left
     is-ended          → end card (Vimeo wordmark)
     has-error         → fallback overlay
   Motion: transform + opacity + filter only.
   ============================================================ */
:root {
  --intro-duration: 2.8s;
  --idle-timeout: 3s;
  --accent: #e8d68a;
  --fade-fast: 0.28s;
  --fade-slow: 0.55s;
  --reel-duration: 5s;
}
.cinematic-projects {
  --bg: #0a0a0a;
  --surface: rgba(10, 10, 10, 0.75);
  --text: #ffffff;
  --off-white: #f2f0eb;
  --muted: #a0a0a0;
  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.cinematic-projects .section-heading {
  font-family: var(--font);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 48px;
  color: var(--text);
}
.cinematic-projects .film-project { margin-bottom: 56px; }
.cinematic-projects .film-description {
  font-family: var(--font);
  color: #c8c8c8;
  line-height: 1.8;
  font-size: 15px;
  margin-top: 20px;
}
.cinematic-projects .film-divider {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.08);
  margin: 40px 0;
}

/* ===== Container ===== */
.cinematic-projects .cinema {
  position: relative;
  isolation: isolate;
  border-radius: 14px;
  overflow: hidden;
  background: #000;
  box-shadow: 0 24px 72px rgba(0,0,0,0.65);
}
.cinematic-projects .cinema-fallback[hidden] { display: none !important; }

/* ===== Screen ===== */
.cinematic-projects .cinema-screen {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

/* ===== Video / Poster ===== */
.cinematic-projects .cinema-video,
.cinematic-projects .cinema-video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  opacity: 0;
  transition: opacity 0.7s ease;
  pointer-events: none;
}
.cinematic-projects .cinema.is-started .cinema-video,
.cinematic-projects .cinema.is-started .cinema-video iframe {
  opacity: 1;
}
.cinematic-projects .cinema-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 0.6s ease;
  z-index: 2;
  will-change: opacity;
}
.cinematic-projects .cinema.is-started .cinema-poster {
  opacity: 0;
  pointer-events: none;
}

/* ===== Title (top-left, scroll-smoother glide) ===== */
.cinematic-projects .cinema-title-layer {
  position: absolute;
  top: 22px;
  left: 24px;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 5px;
  max-width: 62%;
  opacity: 0;
  transform: translate3d(0, -14px, 0);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  will-change: opacity, transform;
}
/* Pre-start: title visible with scroll-smoother reveal */
.cinematic-projects .cinema:not(.is-started) .cinema-title-layer {
  opacity: 1;
  transform: none;
  transition-delay: 0.35s;
}
/* During playback: only on hover or ui-open */
.cinematic-projects .cinema.is-started.is-hover .cinema-title-layer,
.cinematic-projects .cinema.is-started.ui-open .cinema-title-layer {
  opacity: 1;
  transform: none;
}

.cinematic-projects .cinema-film-title {
  font-family: var(--font);
  font-size: clamp(15px, 1.6vw, 18px);
  font-weight: 700;
  color: var(--off-white);
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin: 0;
  text-shadow: 0 2px 12px rgba(0,0,0,0.7);
}
.cinematic-projects .cinema-film-sub {
  font-family: var(--font);
  font-size: 10px;
  font-weight: 500;
  color: var(--accent);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-shadow: 0 1px 6px rgba(0,0,0,0.7);
}

/* ===== Control Bar (NO border, gradient only) ===== */
.cinematic-projects .cinema-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 56px 22px 16px;
  background: linear-gradient(to top,
              rgba(0,0,0,0.92) 0%,
              rgba(0,0,0,0.72) 40%,
              rgba(0,0,0,0.28) 75%,
              rgba(0,0,0,0) 100%);
  pointer-events: auto;
  transition: opacity var(--fade-fast) ease, transform var(--fade-fast) ease;
  will-change: opacity, transform;
}

/* Pre-start: full bar visible during intro */
.cinematic-projects .cinema:not(.is-started) .cinema-controls {
  opacity: 1;
  transform: none;
  pointer-events: none;
}
/* Started: hidden by default */
.cinematic-projects .cinema.is-started .cinema-controls {
  opacity: 0;
  transform: translate3d(0, 8px, 0);
  pointer-events: none;
}
/* Visible during hover / ui-open / paused / ended */
.cinematic-projects .cinema.is-started.is-hover .cinema-controls,
.cinematic-projects .cinema.is-started.ui-open .cinema-controls,
.cinematic-projects .cinema.is-started.is-paused .cinema-controls,
.cinematic-projects .cinema.is-started.is-ended .cinema-controls {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}
.cinematic-projects .cinema.has-error .cinema-controls { display: none; }

/* Hide all but camera during "playing but not revealed" state */
.cinematic-projects .cinema.is-started:not(.is-hover):not(.ui-open):not(.is-paused):not(.is-ended) .cinema-progress-wrap,
.cinematic-projects .cinema.is-started:not(.is-hover):not(.ui-open):not(.is-paused):not(.is-ended) .cbtn:not(.cbtn-cam-btn) {
  opacity: 0;
  pointer-events: none;
}
.cinematic-projects .cinema-progress-wrap,
.cinematic-projects .cinema-btn-row .cbtn:not(.cbtn-cam-btn) {
  transition: opacity var(--fade-fast) ease;
  will-change: opacity;
}

/* ===== Intro animation (magical stagger) ===== */
@keyframes cp-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes cp-magical-in {
  0%   { opacity: 0; transform: translate3d(-8px, 0, 0) scale(0.92); filter: blur(4px); }
  55%  { opacity: 1; transform: translate3d(0, 0, 0) scale(1.02); filter: blur(0); }
  75%  { transform: scale(1); }
  100% { opacity: 1; transform: none; }
}
@keyframes cp-magical-out {
  0%   { opacity: 1; }
  70%  { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes cp-timeline-draw {
  0%   { transform: scaleX(0); opacity: 0; }
  20%  { transform: scaleX(1); opacity: 1; }
  85%  { transform: scaleX(1); opacity: 1; }
  100% { transform: scaleX(1); opacity: 0; }
}

.cinematic-projects .cinema:not(.is-started) {
  animation: cp-fade 0.7s ease both;
}

/* Timeline glides in first */
.cinematic-projects .cinema:not(.is-started) .cinema-progress-wrap {
  animation: cp-timeline-draw var(--intro-duration) ease both;
  transform-origin: left center;
}

/* Controls magical stagger */
.cinematic-projects .cinema:not(.is-started) .cinema-btn-left .cbtn,
.cinematic-projects .cinema:not(.is-started) .cinema-btn-right .cbtn {
  animation: cp-magical-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both,
             cp-magical-out 1.4s ease 1.6s forwards;
}
.cinematic-projects .cinema:not(.is-started) .cinema-btn-left .cbtn:nth-child(1) { animation-delay: 0.15s, 1.75s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-left .cbtn:nth-child(2) { animation-delay: 0.25s, 1.85s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-left .cbtn:nth-child(3) { animation-delay: 0.35s, 1.95s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-left .cbtn:nth-child(4) { animation-delay: 0.45s, 2.05s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-right .cbtn:nth-child(1) { animation-delay: 0.55s, 2.15s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-right .cbtn:nth-child(2) { animation-delay: 0.65s, 2.25s; }
.cinematic-projects .cinema:not(.is-started) .cinema-btn-right .cbtn:nth-child(3) { animation-delay: 0.75s, 2.35s; }

/* Camera stays visible during intro (no fade-out) */
.cinematic-projects .cinema:not(.is-started) .cbtn-cam-btn {
  animation: cp-magical-in 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both !important;
}

/* ===== Camera icon (left) ===== */
.cinematic-projects .cbtn-cam-wrap {
  position: relative;
  display: inline-flex;
}
.cinematic-projects .cbtn-cam-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  padding: 0;
  border: none;
  background: transparent;
  color: var(--off-white);
  cursor: pointer;
  transition: filter 0.35s ease;
}
.cinematic-projects .cbtn-cam {
  width: 42px;
  height: 42px;
  fill: none;
  stroke: currentColor;
  color: var(--off-white);
  filter: drop-shadow(0 1px 0 rgba(255,255,255,0.15));
  transition: filter 0.4s ease, transform 0.4s ease;
  will-change: filter, transform;
}
.cinematic-projects .cbtn-cam .reel {
  transform-origin: center;
  transform-box: fill-box;
}

/* Reel rotation only when playing */
@keyframes cp-reel-spin { to { transform: rotate(360deg); } }
.cinematic-projects .cinema.is-started .reel {
  animation: cp-reel-spin var(--reel-duration) linear infinite;
}
.cinematic-projects .cinema.is-started .reel:last-of-type {
  animation-delay: -1.4s;
}

/* Light-up on hover / paused / ui-open */
.cinematic-projects .cinema.is-hover .cbtn-cam,
.cinematic-projects .cinema.is-paused .cbtn-cam,
.cinematic-projects .cinema.ui-open .cbtn-cam,
.cinematic-projects .cinema.is-ended .cbtn-cam {
  filter: drop-shadow(0 1px 0 rgba(255,255,255,0.2))
          drop-shadow(0 0 16px rgba(232,214,138,0.55));
}

/* State label (Play / Pause) — appears under camera on hover */
.cinematic-projects .cbtn-cam-state {
  position: absolute;
  bottom: -14px;
  left: 50%;
  transform: translateX(-50%) translateY(4px);
  font-family: var(--font);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--off-white);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease, transform 0.35s ease;
  will-change: opacity, transform;
  text-shadow: 0 1px 6px rgba(0,0,0,0.8);
}
.cinematic-projects .cinema.is-hover .cbtn-cam-state,
.cinematic-projects .cinema.is-paused .cbtn-cam-state,
.cinematic-projects .cinema.ui-open .cbtn-cam-state {
  opacity: 0.85;
  transform: translateX(-50%) translateY(0);
}

/* ===== Other control buttons ===== */
.cinematic-projects .cbtn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--off-white);
  cursor: pointer;
  transition: background 0.15s ease, transform 0.15s ease;
}
.cinematic-projects .cbtn:hover { background: rgba(255,255,255,0.09); }
.cinematic-projects .cbtn:active { transform: scale(0.94); }
.cinematic-projects .cbtn-icon { width: 22px; height: 22px; fill: currentColor; }
.cinematic-projects .cbtn-text {
  width: auto;
  padding: 0 12px;
  font-family: var(--font);
  font-size: 12px;
  font-weight: 600;
  color: var(--off-white);
  letter-spacing: 0.02em;
  opacity: 0.85;
}
.cinematic-projects .cbtn-text:hover { color: var(--text); opacity: 1; }

/* ===== Progress bar (glass, thin, off-white) ===== */
.cinematic-projects .cinema-progress-wrap {
  position: relative;
  height: 20px;
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 0 4px;
}
.cinematic-projects .cinema-progress-track {
  position: relative;
  width: 100%;
  height: 3px;
  border-radius: 3px;
  background: rgba(242, 240, 235, 0.18);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  overflow: hidden;
  transition: height 0.2s ease;
}
.cinematic-projects .cinema-progress-wrap:hover .cinema-progress-track {
  height: 5px;
}
.cinematic-projects .cinema-progress-fill {
  position: absolute;
  inset: 0;
  right: auto;
  width: 0%;
  background: linear-gradient(to right, rgba(242,240,235,0.85), rgba(242,240,235,0.65));
  border-radius: 3px;
  pointer-events: none;
  transition: width 0.15s linear;
  box-shadow: 0 0 10px rgba(242,240,235,0.35);
}
.cinematic-projects .cinema-progress {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  cursor: pointer;
  outline: none;
  z-index: 2;
}
.cinematic-projects .cinema-progress::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--off-white);
  cursor: pointer;
  box-shadow: 0 0 0 4px rgba(242,240,235,0.18), 0 2px 6px rgba(0,0,0,0.5);
  transition: transform 0.15s ease;
}
.cinematic-projects .cinema-progress-wrap:hover .cinema-progress::-webkit-slider-thumb {
  transform: scale(1.15);
}
.cinematic-projects .cinema-progress::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--off-white);
  cursor: pointer;
  border: none;
  box-shadow: 0 0 0 4px rgba(242,240,235,0.18), 0 2px 6px rgba(0,0,0,0.5);
}

/* ===== Button Row ===== */
.cinematic-projects .cinema-btn-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cinematic-projects .cinema-btn-left,
.cinematic-projects .cinema-btn-right {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ===== Quality Menu ===== */
.cinematic-projects .cinema-quality-wrap { position: relative; }
.cinematic-projects .cinema-quality-menu {
  position: absolute;
  bottom: calc(100% + 8px);
  right: 0;
  background: var(--surface);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 8px;
  padding: 6px;
  min-width: 90px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  z-index: 40;
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
  animation: cp-menu-in 0.18s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.cinematic-projects .cinema-quality-menu[hidden] { display: none; }
@keyframes cp-menu-in {
  from { opacity: 0; transform: translate3d(0, 6px, 0); }
  to { opacity: 1; transform: none; }
}
.cinematic-projects .cinema-quality-item {
  background: transparent;
  border: none;
  color: var(--off-white);
  font-family: var(--font);
  font-size: 12px;
  font-weight: 500;
  padding: 7px 12px;
  text-align: left;
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.12s ease;
  width: 100%;
}
.cinematic-projects .cinema-quality-item:hover { background: rgba(255,255,255,0.1); }
.cinematic-projects .cinema-quality-item.is-active {
  background: rgba(232,214,138,0.16);
  color: var(--accent);
}

/* ===== End Card ===== */
.cinematic-projects .cinema.is-ended .cinema-screen::after {
  content: "vimeo";
  position: absolute;
  inset: 0;
  z-index: 30;
  display: grid;
  place-items: center;
  font-family: var(--font);
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--off-white);
  background: radial-gradient(60% 60% at 50% 45%, rgba(18,18,18,0.6), rgba(10,10,10,0.92));
  pointer-events: none;
  animation: cp-fade 0.7s ease both;
}
.cinematic-projects .cinema.is-ended .cinema-screen::before {
  content: "Portfolio Studio";
  position: absolute;
  left: 50%;
  top: calc(50% + 34px);
  transform: translateX(-50%);
  z-index: 31;
  font-family: var(--font);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(232,214,138,0.35);
  border-radius: 999px;
  padding: 4px 12px;
  pointer-events: none;
  animation: cp-fade 0.7s ease 0.15s both;
}

/* ===== Status & Fallback ===== */
.cinematic-projects .cinema-status {
  position: absolute;
  bottom: 110px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(0,0,0,0.85);
  padding: 6px 14px;
  border-radius: 16px;
  font-family: var(--font);
  font-size: 12px;
  color: var(--off-white);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.cinematic-projects .cinema-status:not(:empty) { opacity: 1; }

.cinematic-projects .cinema-fallback {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.9);
  color: var(--off-white);
  text-align: center;
  padding: 20px;
  font-family: var(--font);
}
.cinematic-projects .cinema-fallback a,
.cinematic-projects .cinema-fallback button {
  display: inline-block;
  margin: 6px 4px 0;
  padding: 8px 16px;
  background: var(--accent);
  color: #000;
  text-decoration: none;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
}

/* ===== Reduced Motion ===== */
@media (prefers-reduced-motion: reduce) {
  .cinematic-projects *,
  .cinematic-projects *::before,
  .cinematic-projects *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ===== Responsive ===== */
@media (max-width: 640px) {
  .cinematic-projects .cinema-controls { padding: 40px 14px 12px; gap: 8px; }
  .cinematic-projects .cinema-title-layer { top: 14px; left: 16px; }
  .cinematic-projects .cbtn { width: 34px; height: 34px; }
  .cinematic-projects .cbtn-cam { width: 34px; height: 34px; }
  .cinematic-projects .cbtn-cam-btn { width: 46px; height: 46px; }
}
</style>

<script>
(function () {
  'use strict';

  let sdkPromise;

  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) return Promise.resolve(window.Vimeo);
    if (sdkPromise) return sdkPromise;
    sdkPromise = new Promise(function (resolve, reject) {
      const script = document.createElement('script');
      const timer = window.setTimeout(function () { reject(new Error('SDK timeout')); }, 25000);
      script.src = 'https://player.vimeo.com/api/player.js';
      script.async = true;
      script.onload = function () {
        window.clearTimeout(timer);
        if (window.Vimeo && window.Vimeo.Player) resolve(window.Vimeo);
        else reject(new Error('SDK unavailable'));
      };
      script.onerror = function () {
        window.clearTimeout(timer);
        reject(new Error('SDK load failed'));
      };
      document.head.appendChild(script);
    });
    return sdkPromise;
  }

  function preconnect() {
    ['https://player.vimeo.com', 'https://i.vimeocdn.com', 'https://f.vimeocdn.com'].forEach(function (href) {
      if (document.querySelector('link[rel="preconnect"][href="' + href + '"]')) return;
      const l = document.createElement('link');
      l.rel = 'preconnect';
      l.href = href;
      l.crossOrigin = '';
      document.head.appendChild(l);
    });
  }

  function withTimeout(promise, ms) {
    return new Promise(function (resolve, reject) {
      const t = window.setTimeout(function () { reject(new Error('Timeout')); }, ms);
      Promise.resolve(promise).then(
        function (v) { window.clearTimeout(t); resolve(v); },
        function (e) { window.clearTimeout(t); reject(e); }
      );
    });
  }

  function fmt(s) {
    const v = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(v / 3600);
    const m = Math.floor((v % 3600) / 60);
    const sec = v % 60;
    const str = String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    return h ? h + ':' + str : str;
  }

  function initialize() {
    preconnect();

    document.querySelectorAll('[data-cinema]').forEach(function (root) {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const $ = function (n) { return root.querySelector('[data-' + n + ']'); };
      const screen = root.querySelector('.cinema-screen');
      const videoLayer = $('video-layer');
      const cameraBtn = $('cam-btn');
      const cameraLabel = $('cam-label');
      const controls = $('controls');
      const toggle = $('toggle');
      const replay = $('replay');
      const sound = $('sound');
      const speed = $('speed');
      const quality = $('quality');
      const qualityWrap = quality.parentNode;
      const qualityMenu = $('quality-menu');
      const progress = $('progress');
      const progressFill = $('progress-fill');
      const status = $('status');
      const fallback = $('fallback');
      const poster = $('poster');
      const filmTitle = $('film-title');
      const filmSub = $('film-sub');

      filmTitle.textContent = root.dataset.title || '';
      filmSub.textContent = root.dataset.subtitle || '';

      // State
      let player = null;
      let prepPromise = null;
      let ready = false;
      let failed = false;
      let started = false;
      let paused = true;
      let muted = true;
      let duration = 0;
      let current = 0;
      let idleTimer = null;
      let seekEdit = false;
      let qualities = [];
      let currentQuality = 'auto';
      const speedRates = [0.5, 1, 1.5, 2];
      let speedIndex = 1;

      // ===== UI helpers =====
      function clearIdle() {
        if (idleTimer) { window.clearTimeout(idleTimer); idleTimer = null; }
      }
      function markOpen() {
        root.classList.add('ui-open');
        clearIdle();
        if (started && !paused && !failed) {
          idleTimer = window.setTimeout(function () {
            root.classList.remove('ui-open');
          }, 3000);
        }
      }

      // ===== Paused / Muted =====
      function setPaused(v) {
        paused = v;
        const playSVG = '<svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M8 5v14l11-7z"/></svg>';
        const pauseSVG = '<svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
        toggle.innerHTML = v ? playSVG : pauseSVG;
        toggle.setAttribute('aria-label', v ? 'Play film' : 'Pause film');
        if (cameraLabel) cameraLabel.textContent = v ? 'Play' : 'Pause';
        root.classList.toggle('is-paused', v);
        if (v) root.classList.remove('is-ended');
      }
      function setMuted(v) {
        muted = v;
        const muteSVG = '<svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
        const unmuteSVG = '<svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
        sound.innerHTML = v ? muteSVG : unmuteSVG;
        sound.setAttribute('aria-label', v ? 'Unmute film' : 'Mute film');
      }

      function updateTime() {
        const pct = duration > 0 ? (current / duration * 100) : 0;
        if (!seekEdit) {
          progress.value = duration > 0 ? Math.round(current / duration * 1000) : 0;
          if (progressFill) progressFill.style.width = pct + '%';
        }
        progress.setAttribute('aria-valuetext', fmt(current) + ' of ' + fmt(duration));
      }

      function fail(err) {
        if (failed) return;
        failed = true;
        clearIdle();
        root.classList.add('has-error');
        root.classList.remove('ui-open', 'is-hover');
        fallback.hidden = false;
        status.textContent = '';
        if (player) try { player.pause(); } catch (e) {}
        console.warn('[Cinema] failure:', err);
      }

      function notify(msg, err) {
        status.textContent = msg;
        markOpen();
        if (err) console.warn('[Cinema]', err);
      }

      // ===== Quality menu =====
      function buildQualityMenu() {
        qualityMenu.innerHTML = '';
        const all = [{ id: 'auto', label: 'Auto' }].concat(
          qualities.map(function (q) { return { id: q.id, label: q.label || (q.id + 'p') }; })
        );
        all.forEach(function (opt) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cinema-quality-item' + (String(opt.id) === String(currentQuality) ? ' is-active' : '');
          btn.textContent = opt.label;
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            selectQuality(opt.id);
          });
          qualityMenu.appendChild(btn);
        });
      }

      function loadQualities() {
        return withTimeout(player.getQualities(), 8000).then(function (opts) {
          if (failed || !Array.isArray(opts) || !opts.length) return;
          qualities = opts;
          buildQualityMenu();
        }).catch(function () {});
      }

      function selectQuality(id) {
        return withTimeout(player.setQuality(id), 10000).then(function (actual) {
          currentQuality = actual;
          quality.textContent = actual === 'auto' ? 'Auto' : actual + 'p';
          buildQualityMenu();
        }).catch(function (err) {
          notify('Quality change failed.', err);
        }).finally(function () {
          qualityMenu.hidden = true;
        });
      }

      function openQualityMenu() {
        qualityMenu.hidden = false;
        markOpen();
        const close = function (e) {
          if (!qualityWrap.contains(e.target)) {
            qualityMenu.hidden = true;
            document.removeEventListener('click', close, true);
          }
        };
        setTimeout(function () {
          document.addEventListener('click', close, true);
        }, 0);
      }

      // ===== Prepare / Launch =====
      function prepare() {
        if (prepPromise) return prepPromise;
        prepPromise = (async function () {
          const Vimeo = await loadVimeoSDK();
          if (failed) return;
          const vid = String(root.dataset.videoId || '');
          if (!/^\d+$/.test(vid)) throw new Error('Invalid Vimeo ID');

          const iframe = document.createElement('iframe');
          iframe.src = 'https://player.vimeo.com/video/' + vid +
            '?background=1&autoplay=0&loop=0&byline=0&title=0&portrait=0&controls=0&muted=1&playsinline=1&keyboard=0&dnt=1';
          iframe.title = 'Vimeo film';
          iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
          iframe.allowFullscreen = true;
          iframe.tabIndex = -1;
          iframe.setAttribute('loading', 'eager');
          videoLayer.appendChild(iframe);

          player = new Vimeo.Player(iframe);

          player.on('play', function () { setPaused(false); });
          player.on('pause', function () { setPaused(true); });
          player.on('ended', function () {
            setPaused(true);
            current = duration;
            updateTime();
            root.classList.add('is-paused', 'is-ended');
          });
          player.on('timeupdate', function (e) {
            current = Number(e.seconds) || 0;
            duration = Number(e.duration) || duration;
            updateTime();
          });
          player.on('durationchange', function (e) {
            duration = Number(e.duration) || 0;
            updateTime();
          });
          player.on('playbackratechange', function (e) {
            speed.textContent = e.playbackRate + 'x';
            const i = speedRates.indexOf(e.playbackRate);
            if (i !== -1) speedIndex = i;
          });
          player.on('qualitychange', function (e) {
            if (e && e.id) {
              currentQuality = e.id;
              quality.textContent = e.id === 'auto' ? 'Auto' : e.id + 'p';
              buildQualityMenu();
            }
          });
          player.on('volumechange', function (e) {
            setMuted(Boolean(e.muted) || e.volume === 0);
          });
          player.on('error', function (e) {
            const METHODS = ['setQuality','getQuality','getQualities','setPlaybackRate','setCurrentTime','setMuted','setVolume','getMuted','getPaused','getDuration'];
            if (e && e.method && METHODS.indexOf(e.method) !== -1) return;
            fail(e);
          });

          await withTimeout(player.ready(), 20000);
          if (failed) return;
          ready = true;
          player.getDuration().then(function (v) { duration = Number(v) || 0; updateTime(); }).catch(function () {});
          player.getMuted().then(setMuted).catch(function () {});
          loadQualities();
        })().catch(function (e) { fail(e); });
        return prepPromise;
      }

      async function launch() {
        if (started && !paused) return;
        cameraBtn.disabled = true;
        await prepare();
        if (failed || !ready) { cameraBtn.disabled = false; return; }
        try {
          await withTimeout(player.play(), 20000);
          if (failed) { cameraBtn.disabled = false; return; }
          started = true;
          root.classList.add('is-started');
          root.classList.remove('is-paused', 'is-ended');
          cameraBtn.disabled = false;
          markOpen();
        } catch (e) {
          fail(e);
          cameraBtn.disabled = false;
        }
      }

      // ===== Events =====
      screen.addEventListener('mouseenter', function () {
        root.classList.add('is-hover');
        markOpen();
      });
      screen.addEventListener('mouseleave', function () {
        root.classList.remove('is-hover');
        clearIdle();
      });
      screen.addEventListener('mousemove', markOpen);

      screen.addEventListener('click', function (e) {
        if (e.target.closest('.cinema-controls')) return;
        if (!started) { launch(); return; }
        if (paused) {
          root.classList.remove('is-paused', 'is-ended');
          player.play().catch(function () {});
        } else {
          root.classList.add('is-paused');
          player.pause().catch(function () {});
        }
      });

      cameraBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!started) { launch(); return; }
        if (paused) {
          root.classList.remove('is-paused', 'is-ended');
          player.play().catch(function () {});
        } else {
          root.classList.add('is-paused');
          player.pause().catch(function () {});
        }
        markOpen();
      });

      $('refresh').addEventListener('click', function () { window.location.reload(); });
      poster.addEventListener('error', function () { poster.hidden = true; });

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        withTimeout(player.getPaused(), 8000).then(function (p) {
          return withTimeout(p ? player.play() : player.pause(), 15000);
        }).catch(function (err) {
          notify('Playback could not be changed.', err);
        }).finally(markOpen);
      });

      replay.addEventListener('click', function (e) {
        e.stopPropagation();
        withTimeout(player.setCurrentTime(0).then(function () { return player.play(); }), 15000)
          .then(function () { root.classList.remove('is-ended'); })
          .catch(function (err) { notify('Could not replay.', err); })
          .finally(markOpen);
      });

      sound.addEventListener('click', function (e) {
        e.stopPropagation();
        withTimeout(player.setMuted(!muted), 8000)
          .then(function () { return withTimeout(player.getMuted(), 8000); })
          .then(setMuted)
          .catch(function (err) { notify('Sound could not be changed.', err); })
          .finally(markOpen);
      });

      speed.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        speedIndex = (speedIndex + 1) % speedRates.length;
        const next = speedRates[speedIndex];
        withTimeout(player.setPlaybackRate(next), 8000)
          .then(function (actual) { speed.textContent = actual + 'x'; })
          .catch(function (err) { notify('Speed change failed.', err); })
          .finally(markOpen);
      });

      quality.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        if (qualityMenu.hidden) openQualityMenu();
        else qualityMenu.hidden = true;
      });

      progress.addEventListener('input', function (e) {
        e.stopPropagation();
        seekEdit = true;
        const pct = Number(progress.value) / 10;
        if (progressFill) progressFill.style.width = pct + '%';
        markOpen();
      });

      progress.addEventListener('change', function (e) {
        e.stopPropagation();
        const target = duration * Number(progress.value) / 1000;
        withTimeout(player.setCurrentTime(target), 10000)
          .then(function (v) { current = Number(v) || target; })
          .catch(function (err) { notify('Seek failed.', err); })
          .finally(function () {
            seekEdit = false;
            updateTime();
            markOpen();
          });
      });

      progress.addEventListener('blur', function () { seekEdit = false; updateTime(); });

      const fsBtn = $('fullscreen');
      if (fsBtn) {
        fsBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (!document.fullscreenElement) root.requestFullscreen().catch(function () {});
          else document.exitFullscreen().catch(function () {});
        });
      }

      // Preload SDK in background (no iframe yet — created on first click)
      loadVimeoSDK().catch(function () { /* ignore */ });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
})();
</script>
