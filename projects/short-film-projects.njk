---
layout: layouts/base.njk
title: Short Film Projects
---

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="w3-text-light-grey section-heading">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project">
        {% if p.data.vimeoId %}
          <section
            class="cinema"
            data-cinema
            data-video-id="{{ p.data.vimeoId | escape }}"
            data-title="{{ p.data.title | escape }}"
            data-subtitle="{{ (p.data.subtitle or '') | escape }}"
            aria-label="{{ p.data.title | escape }} video player"
          >
            <div class="cinema-screen">
              <div class="cinema-video" data-video-layer></div>
              <img
                class="cinema-poster"
                data-poster
                src="/img/optimized/projects/short-film/{{ p.data.vimeoId | escape }}.webp"
                alt=""
                loading="lazy"
                decoding="async"
                width="1920"
                height="1080"
              >

              <!-- Center Camera Play Button -->
              <div class="cinema-camera-layer" data-camera-layer>
                <button
                  class="cinema-camera-btn"
                  data-camera
                  type="button"
                  aria-label="Play {{ p.data.title | escape }}"
                >
                  <svg class="cinema-camera-svg" viewBox="0 0 64 64" aria-hidden="true">
                    <!-- Film reels -->
                    <circle cx="22" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
                    <circle cx="42" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
                    <circle cx="22" cy="16" r="2.5" fill="currentColor"/>
                    <circle cx="42" cy="16" r="2.5" fill="currentColor"/>
                    <circle cx="16" cy="10" r="1.5" fill="currentColor"/>
                    <circle cx="28" cy="10" r="1.5" fill="currentColor"/>
                    <circle cx="16" cy="22" r="1.5" fill="currentColor"/>
                    <circle cx="28" cy="22" r="1.5" fill="currentColor"/>
                    <circle cx="36" cy="10" r="1.5" fill="currentColor"/>
                    <circle cx="48" cy="10" r="1.5" fill="currentColor"/>
                    <circle cx="36" cy="22" r="1.5" fill="currentColor"/>
                    <circle cx="48" cy="22" r="1.5" fill="currentColor"/>
                    <!-- Camera body -->
                    <rect x="18" y="26" width="28" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2"/>
                    <rect x="26" y="31" width="12" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="30" cy="34.5" r="1.2" fill="currentColor"/>
                    <circle cx="34" cy="34.5" r="1.2" fill="currentColor"/>
                    <!-- Lens -->
                    <polygon points="46,30 55,27 55,41 46,38" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <polygon points="18,30 13,28 13,36 18,34" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    <!-- Tripod -->
                    <line x1="26" y1="42" x2="21" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="32" y1="42" x2="32" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    <line x1="38" y1="42" x2="43" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
                  <span class="cinema-play-label">Play</span>
                </button>
              </div>

              <div class="cinema-fallback" data-fallback role="alert" hidden>
                <div>
                  <strong>The picture could not start</strong>
                  <p>We could not load the film. Please check your connection and refresh the page.</p>
                  <a href="https://vimeo.com/{{ p.data.vimeoId | escape }}" target="_blank" rel="noopener noreferrer">Watch on Vimeo</a>
                  <button type="button" data-refresh>Refresh</button>
                </div>
              </div>
            </div>

            <!-- Controls Bar (screenshot.jpg style) -->
            <div class="cinema-controls" data-controls aria-label="Film controls" hidden>
              <div class="cinema-progress-wrap">
                <input
                  class="cinema-progress"
                  data-progress
                  type="range"
                  min="0" max="1000" step="1" value="0"
                  aria-label="Seek through the film"
                  disabled
                >
              </div>

              <div class="cinema-info-row">
                <div class="cinema-info-text">
                  <span class="cinema-info-title" data-info-title></span>
                  <span class="cinema-info-sub" data-info-sub></span>
                </div>
                <span class="cinema-time" data-time>00:00 / 00:00</span>
              </div>

              <div class="cinema-btn-row">
                <div class="cinema-btn-left">
                  <button class="cbtn" data-cam-btn type="button" aria-label="Play/Pause">
                    <svg class="cbtn-cam" viewBox="0 0 64 64" aria-hidden="true">
                      <circle cx="22" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2.5"/>
                      <circle cx="42" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2.5"/>
                      <circle cx="22" cy="16" r="2.5" fill="currentColor"/>
                      <circle cx="42" cy="16" r="2.5" fill="currentColor"/>
                      <rect x="18" y="26" width="28" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
                      <polygon points="46,30 55,27 55,41 46,38" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                      <line x1="26" y1="42" x2="21" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                      <line x1="32" y1="42" x2="32" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                      <line x1="38" y1="42" x2="43" y2="56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <button class="cbtn cbtn-toggle" data-toggle type="button" aria-label="Play film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M8 5v14l11-7z"/></svg>
                    <span class="cbtn-tip" data-tip>Play</span>
                  </button>
                  <button class="cbtn" data-replay type="button" aria-label="Replay film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                  </button>
                  <button class="cbtn" data-sound type="button" aria-label="Unmute film">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                  </button>
                </div>
                <div class="cinema-btn-right">
                  <button class="cbtn cbtn-text" data-speed type="button" aria-label="Playback speed">1x</button>
                  <button class="cbtn cbtn-text" data-quality type="button" aria-label="Video quality">Auto</button>
                  <button class="cbtn" data-fullscreen type="button" aria-label="Fullscreen">
                    <svg viewBox="0 0 24 24" class="cbtn-icon"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                  </button>
                </div>
              </div>
            </div>

            <p class="cinema-status" data-status role="status" aria-live="polite"></p>
            <noscript>
              <p><a href="https://vimeo.com/{{ p.data.vimeoId | escape }}">Watch on Vimeo</a>. JavaScript required.</p>
            </noscript>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description">{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/*
  Cinematic player visual layer.
  States: intro (<=3s on load), idle (playing: camera icon only, bottom-left),
  hover (title + soft camera light), paused/ended (full controls + end-card), error.
  Tokens centralized below. Candidate for extraction to /css/player.css
  (kept scoped under .cinematic-projects to avoid leaks).
*/
:root {
  --intro-duration: 3s;
  --idle-timeout: 2.5s;
  --light-intensity: 0.25;
  --accent-color: #e8d68a;
  --channel-name: "Portfolio Studio";
  --fade-fast: 0.35s;
  --fade-slow: 0.8s;
}
.cinematic-projects {
  --c-bg: #0a0a0a;
  --c-surface: rgba(16, 16, 16, 0.86);
  --c-border: rgba(255, 255, 255, 0.10);
  --c-text: #ffffff;
  --c-muted: #999999;
  --c-accent: var(--accent-color);
  --c-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.cinematic-projects .section-heading {
  font-family: var(--c-font);
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 48px;
  color: var(--c-text);
}

.cinematic-projects .film-project {
  margin-bottom: 56px;
}

.cinematic-projects .film-description {
  font-family: var(--c-font);
  color: #cccccc;
  line-height: 1.8;
  font-size: 15px;
  margin-top: 20px;
}

.cinematic-projects .film-divider {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.08);
  margin: 40px 0;
}

/* ===== Cinema Container ===== */
.cinematic-projects .cinema {
  position: relative;
  isolation: isolate;
  border-radius: 12px;
  overflow: hidden;
  background: var(--c-bg);
  box-shadow: 0 20px 60px rgba(0,0,0,0.6);
}

.cinematic-projects .cinema [hidden] { display: none !important; }

/* ===== Screen ===== */
.cinematic-projects .cinema-screen {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
  cursor: pointer;
}

/* ===== Video Layer ===== */
.cinematic-projects .cinema-video,
.cinematic-projects .cinema-video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  opacity: 0;
  transition: opacity 1s ease;
  pointer-events: none;
}

.cinematic-projects .cinema.is-started .cinema-video,
.cinematic-projects .cinema.is-started .cinema-video iframe {
  opacity: 1;
  pointer-events: auto;
}

/* ===== Poster ===== */
.cinematic-projects .cinema-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1;
  transition: opacity 0.6s ease;
  z-index: 2;
}

.cinematic-projects .cinema.is-started .cinema-poster {
  opacity: 0;
  pointer-events: none;
}

/* Center play button removed per redesign. */
.cinematic-projects .cinema-camera-layer {
  display: none !important;
}

.cinematic-projects .cinema.is-started .cinema-camera-layer {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.9);
}

.cinematic-projects .cinema.is-paused .cinema-camera-layer {
  opacity: 1;
  pointer-events: auto;
  transform: scale(1);
}

/* ===== Control bar + state machine (no glass, reference layout) ===== */
.cinematic-projects .cinema .cinema-controls {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  z-index: 20;
  display: flex;
  flex-direction: column;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 0;
  pointer-events: none;
  transition: background var(--fade-fast) ease, border-color var(--fade-fast) ease;
}
/* Conflict: JS never clears [hidden]; visibility is driven by state classes instead. */
.cinematic-projects .cinema .cinema-controls[hidden] { display: flex; }
.cinematic-projects .cinema.has-error .cinema-controls { display: none !important; }
.cinematic-projects .cinema-info-row { order: 1; }
.cinematic-projects .cinema-progress-wrap { order: 2; }
.cinematic-projects .cinema-btn-row { order: 3; }

.cinematic-projects .cinema-progress-wrap,
.cinematic-projects .cinema-info-row,
.cinematic-projects .cinema-btn-row .cbtn:not([data-cam-btn]) {
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--fade-fast) ease;
  will-change: opacity;
}
.cinematic-projects .cinema-info-sub { transition: opacity var(--fade-fast) ease; }
.cinematic-projects [data-cam-btn] {
  width: 44px;
  height: 44px;
  pointer-events: auto;
}

/* Intro (<=3s), pre-start only. Conflict: autoplay needs a gesture; film starts on first click. */
@keyframes cp-intro-bar { 0% { opacity: 0; transform: scaleX(0); } 55% { opacity: 1; transform: scaleX(1); } 100% { opacity: 0; } }
@keyframes cp-intro-meta { 0% { opacity: 0; transform: translate3d(0, 6px, 0); } 50% { opacity: 1; transform: none; } 100% { opacity: 0; } }
@keyframes cp-fade-in { from { opacity: 0; } to { opacity: 1; } }
.cinematic-projects .cinema:not(.is-started) { animation: cp-fade-in 0.9s ease both; }
.cinematic-projects .cinema:not(.is-started) .cinema-progress-wrap {
  animation: cp-intro-bar var(--intro-duration) ease both;
  transform-origin: left center;
}
.cinematic-projects .cinema:not(.is-started) .cinema-info-row {
  animation: cp-intro-meta var(--intro-duration) ease both;
}

/* Playback idle: camera icon persists bottom-left. Hover: title + play/pause + soft light. */
.cinematic-projects .cinema.is-started:not(.is-paused):hover .cinema-info-row,
.cinematic-projects .cinema.is-started:not(.is-paused):hover [data-toggle] {
  opacity: 1;
  pointer-events: auto;
}
.cinematic-projects .cinema.is-started:not(.is-paused) .cinema-info-sub { opacity: 0; }
.cinematic-projects .cinema.is-started:hover [data-cam-btn] .cbtn-cam,
.cinematic-projects .cinema.is-paused [data-cam-btn] .cbtn-cam {
  filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.12))
          drop-shadow(0 0 10px rgba(232, 214, 138, var(--light-intensity)));
}

/* Paused/ended: full controls per reference. Conflict: camera-icon click plays (existing JS); pause via surface/toggle reveals these. */
.cinematic-projects .cinema.is-paused .cinema-controls {
  background: var(--c-surface);
  border-color: var(--c-border);
  padding: 10px 16px 12px;
}
.cinematic-projects .cinema.is-paused .cinema-progress-wrap,
.cinematic-projects .cinema.is-paused .cinema-info-row,
.cinematic-projects .cinema.is-paused .cinema-btn-row .cbtn:not([data-cam-btn]) {
  opacity: 1;
  pointer-events: auto;
}
.cinematic-projects .cinema.is-paused .cinema-info-sub { opacity: 1; }

/* End-card: Vimeo wordmark + channel tag. Conflict: ended shares .is-paused (no JS hook); hidden pre-start. */
.cinematic-projects .cinema.is-started.is-paused .cinema-screen::after {
  content: "vimeo";
  position: absolute;
  inset: 0;
  z-index: 30;
  display: grid;
  place-items: center;
  font-family: var(--c-font);
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: #ffffff;
  background: radial-gradient(60% 60% at 50% 45%, rgba(18, 18, 18, 0.55), rgba(10, 10, 10, 0.88));
  pointer-events: none;
}
.cinematic-projects .cinema.is-started.is-paused .cinema-screen::before {
  content: var(--channel-name);
  position: absolute;
  left: 50%;
  top: calc(50% + 30px);
  transform: translateX(-50%);
  z-index: 31;
  font-family: var(--c-font);
  font-size: 12px;
  font-weight: 600;
  color: var(--accent-color);
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(232, 214, 138, 0.35);
  border-radius: 999px;
  padding: 3px 10px;
  pointer-events: none;
}

/* Wheel-driven camera shift (transform only, GPU-friendly). */
.cinematic-projects .cinema-video,
.cinematic-projects .cinema-poster {
  transform: translate3d(0, var(--cam-shift, 0px), 0) scale(1.035);
  will-change: transform;
}

@media (prefers-reduced-motion: reduce) {
  .cinematic-projects *,
  .cinematic-projects *::before,
  .cinematic-projects *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .cinematic-projects .cinema-video,
  .cinematic-projects .cinema-poster { transform: none !important; }
}

/* ===== Progress Bar ===== */
.cinematic-projects .cinema-progress-wrap {
  position: relative;
  height: 20px;
  display: flex;
  align-items: center;
  cursor: pointer;
  margin-bottom: 4px;
}

.cinematic-projects .cinema-progress {
  width: 100%;
  height: 3px;
  margin: 0;
  padding: 0;
  appearance: none;
  -webkit-appearance: none;
  background: rgba(255,255,255,0.2);
  border-radius: 2px;
  cursor: pointer;
  transition: height 0.15s ease;
  outline: none;
}

.cinematic-projects .cinema-progress:hover {
  height: 5px;
}

/* Conflict: JS paints the fill gradient inline (red); recolored to muted yellow via filter. */
.cinematic-projects .cinema-progress {
  filter: hue-rotate(48deg) saturate(0.55);
}
.cinematic-projects .cinema-progress::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffffff;
  cursor: pointer;
  opacity: 1;
}

.cinematic-projects .cinema-progress::-moz-range-thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffffff;
  cursor: pointer;
  border: none;
  opacity: 1;
}

/* ===== Info Row ===== */
.cinematic-projects .cinema-info-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;
  padding: 0 4px;
}

.cinematic-projects .cinema-info-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.cinematic-projects .cinema-info-title {
  font-family: var(--c-font);
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cinematic-projects .cinema-info-sub {
  font-family: var(--c-font);
  font-size: 12px;
  color: var(--c-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cinematic-projects .cinema-time {
  font-family: var(--c-font);
  font-size: 12px;
  color: var(--c-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  margin-left: 12px;
}

/* ===== Button Row ===== */
.cinematic-projects .cinema-btn-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cinematic-projects .cinema-btn-left,
.cinematic-projects .cinema-btn-right {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* ===== Control Buttons ===== */
.cinematic-projects .cbtn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #ffffff;
  cursor: pointer;
  transition: background 0.15s;
}

.cinematic-projects .cbtn:hover {
  background: rgba(255,255,255,0.1);
}

.cinematic-projects .cbtn-icon {
  width: 22px;
  height: 22px;
  fill: currentColor;
}

.cinematic-projects .cbtn-cam {
  width: 34px;
  height: 34px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.12));
  will-change: transform, opacity, filter;
}

.cinematic-projects .cbtn-text {
  width: auto;
  padding: 0 10px;
  font-family: var(--c-font);
  font-size: 12px;
  font-weight: 500;
  color: var(--c-muted);
}

.cinematic-projects .cbtn-text:hover {
  color: #fff;
}

/* ===== Tooltip (like "Pause" in screenshot) ===== */
.cinematic-projects .cbtn-tip {
  position: absolute;
  bottom: -24px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.92);
  color: #fff;
  font-family: var(--c-font);
  font-size: 11px;
  font-weight: 500;
  padding: 3px 8px;
  border-radius: 3px;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
  border: 1px solid rgba(255,255,255,0.1);
  z-index: 30;
}

.cinematic-projects .cbtn-toggle:hover .cbtn-tip,
.cinematic-projects .cinema:not(.is-started) .cbtn-tip,
.cinematic-projects .cinema.is-paused .cbtn-tip {
  opacity: 1;
}

/* ===== Status & Fallback ===== */
.cinematic-projects .cinema-status {
  position: absolute;
  bottom: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 25;
  background: rgba(0,0,0,0.8);
  padding: 6px 14px;
  border-radius: 16px;
  font-family: var(--c-font);
  font-size: 12px;
  color: #fff;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}

.cinematic-projects .cinema-status:not(:empty) {
  opacity: 1;
}

.cinematic-projects .cinema-fallback {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: center;
  background: rgba(0,0,0,0.9);
  color: #fff;
  text-align: center;
  padding: 20px;
  font-family: var(--c-font);
}

.cinematic-projects .cinema-fallback a,
.cinematic-projects .cinema-fallback button {
  display: inline-block;
  margin-top: 12px;
  padding: 8px 16px;
  background: var(--c-accent);
  color: #fff;
  text-decoration: none;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  font-family: var(--c-font);
  font-size: 13px;
}

/* ===== Responsive ===== */
@media (max-width: 600px) {
  .cinematic-projects .cinema-btn-row {
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .cinematic-projects .cinema-info-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .cinematic-projects .cinema-time {
    margin-left: 0;
  }
  .cinematic-projects .cinema-camera-svg {
    width: 56px;
    height: 56px;
  }
  .cinematic-projects .cinema-camera-btn {
    padding: 18px 24px;
  }
}
</style>

<script>
(function () {
  'use strict';

  let sdkPromise;

  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) return Promise.resolve(window.Vimeo);
    if (!sdkPromise) {
      sdkPromise = new Promise(function (resolve, reject) {
        const script = document.createElement('script');
        const timer = window.setTimeout(function () { reject(new Error('Vimeo SDK timeout.')); }, 20000);
        script.src = 'https://player.vimeo.com/api/player.js';
        script.async = true;
        script.onload = function () {
          window.clearTimeout(timer);
          if (window.Vimeo && window.Vimeo.Player) resolve(window.Vimeo);
          else reject(new Error('Vimeo SDK unavailable.'));
        };
        script.onerror = function () {
          window.clearTimeout(timer);
          reject(new Error('Vimeo SDK load failed.'));
        };
        document.head.appendChild(script);
      });
    }
    return sdkPromise;
  }

  function withTimeout(promise, ms) {
    return new Promise(function (resolve, reject) {
      const t = window.setTimeout(function () { reject(new Error('Timeout.')); }, ms);
      Promise.resolve(promise).then(
        function (v) { window.clearTimeout(t); resolve(v); },
        function (e) { window.clearTimeout(t); reject(e); }
      );
    });
  }

  function fmt(s) {
    const v = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(v / 3600);
    const m = Math.floor((v % 3600) / 60);
    const sec = v % 60;
    const str = String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    return h ? h + ':' + str : str;
  }

  function initialize() {
    document.querySelectorAll('[data-cinema]').forEach(function (root) {
      if (root.dataset.initialized) return;
      root.dataset.initialized = 'true';

      const $ = function (n) { return root.querySelector('[data-' + n + ']'); };
      const screen = root.querySelector('.cinema-screen');
      const cameraBtn = $('camera');
      const controls = $('controls');
      const toggle = $('toggle');
      const tip = $('tip');
      const replay = $('replay');
      const sound = $('sound');
      const speed = $('speed');
      const quality = $('quality');
      const progress = $('progress');
      const timeEl = $('time');
      const status = $('status');
      const fallback = $('fallback');
      const poster = $('poster');
      const infoTitle = $('info-title');
      const infoSub = $('info-sub');

      // Set info from data attributes
      infoTitle.textContent = root.dataset.title || '';
      infoSub.textContent = root.dataset.subtitle || '';

      let player, prep;
      let ready = false, failed = false, started = false, paused = true, muted = true;
      let duration = 0, current = 0, hideTimer, seekEdit = false;
      let speedRates = [0.5, 1, 1.5, 2];
      let speedIndex = 1; // start at 1x
      let qualities = [];
      let qualityIndex = 0;

      function showControls() {
        root.classList.add('controls-visible');
        window.clearTimeout(hideTimer);
        if (!started || paused || failed) return;
        hideTimer = window.setTimeout(function () {
          if (!controls.contains(document.activeElement) && !paused && !seekEdit) {
            root.classList.remove('controls-visible');
          }
        }, 3000);
      }

      function setPaused(v) {
        paused = v;
        const playSVG = '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
        const pauseSVG = '<svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
        toggle.querySelector('.cbtn-icon').outerHTML = v ? playSVG : pauseSVG;
        toggle.setAttribute('aria-label', v ? 'Play film' : 'Pause film');
        tip.textContent = v ? 'Play' : 'Pause';
        if (v) root.classList.add('is-paused');
        else root.classList.remove('is-paused');
        showControls();
      }

      function setMuted(v) {
        muted = v;
        const muteSVG = '<svg viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>';
        const unmuteSVG = '<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>';
        sound.querySelector('.cbtn-icon').outerHTML = v ? muteSVG : unmuteSVG;
        sound.setAttribute('aria-label', v ? 'Unmute film' : 'Mute film');
      }

      function updateTime() {
        timeEl.textContent = fmt(current) + ' / ' + fmt(duration);
        progress.disabled = duration <= 0;
        if (!seekEdit) {
          progress.value = duration > 0 ? Math.round(current / duration * 1000) : 0;
          const pct = duration > 0 ? (current / duration * 100) : 0;
          progress.style.background = 'linear-gradient(to right, #e50914 ' + pct + '%, rgba(255,255,255,0.2) ' + pct + '%)';
        }
        progress.setAttribute('aria-valuetext', fmt(current) + ' of ' + fmt(duration));
      }

      function fail(err) {
        if (failed) return;
        failed = true;
        window.clearTimeout(hideTimer);
        root.classList.add('has-error');
        root.classList.remove('controls-visible');
        controls.hidden = true;
        cameraBtn.disabled = true;
        fallback.hidden = false;
        status.textContent = '';
        if (player) player.pause().catch(function(){});
        console.warn('Cinema player:', err);
      }

      function notify(msg, err) {
        status.textContent = msg;
        showControls();
        if (err) console.warn('Cinema control:', err);
      }

      async function loadQualities() {
        try {
          const opts = await withTimeout(player.getQualities(), 8000);
          if (failed || !Array.isArray(opts) || !opts.length) return;
          qualities = opts;
          qualityIndex = 0;
        } catch (e) {}
      }

      function prepare() {
        if (prep) return prep;
        prep = (async function () {
          const Vimeo = await loadVimeoSDK();
          if (failed) return;
          const vid = String(root.dataset.videoId || '');
          if (!/^\d+$/.test(vid)) throw new Error('Invalid Vimeo ID.');

          const iframe = document.createElement('iframe');
          iframe.src = 'https://player.vimeo.com/video/' + vid + '?background=1&autoplay=0&loop=0&byline=0&title=0&portrait=0&controls=0&muted=1&playsinline=1&keyboard=0';
          iframe.title = 'Vimeo film';
          iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
          iframe.allowFullscreen = true;
          iframe.tabIndex = -1;
          $('video-layer').appendChild(iframe);

          player = new Vimeo.Player(iframe);
          player.on('play', function () { setPaused(false); });
          player.on('pause', function () { setPaused(true); });
          player.on('ended', function () { setPaused(true); current = duration; updateTime(); root.classList.add('is-paused'); });
          player.on('timeupdate', function (e) { current = Number(e.seconds) || 0; duration = Number(e.duration) || duration; updateTime(); });
          player.on('durationchange', function (e) { duration = Number(e.duration) || 0; updateTime(); });
          player.on('playbackratechange', function (e) {
            speed.textContent = e.playbackRate + 'x';
            speedIndex = speedRates.indexOf(e.playbackRate);
            if (speedIndex === -1) speedIndex = 1;
          });
          player.on('qualitychange', function (e) {
            if (e && e.id) {
              quality.textContent = e.id === 'auto' ? 'Auto' : e.id + 'p';
              for (let i = 0; i < qualities.length; i++) {
                if (String(qualities[i].id) === String(e.id)) { qualityIndex = i; break; }
              }
            }
          });
          player.on('volumechange', function (e) { setMuted(Boolean(e.muted) || e.volume === 0); });
          player.on('error', function (e) {
            if (e && ['setQuality','getQuality','getQualities','setPlaybackRate','setCurrentTime','setMuted','setVolume'].indexOf(e.method) !== -1) return;
            fail(e);
          });

          await withTimeout(player.ready(), 20000);
          if (failed) return;
          ready = true;
          player.getDuration().then(function (v) { duration = Number(v) || 0; updateTime(); }).catch(function(){});
          player.getMuted().then(setMuted).catch(function(){});
          loadQualities();
        })().catch(function (e) { fail(e); });
        return prep;
      }

      async function launch() {
        if (started && !paused) return;
        cameraBtn.disabled = true;
        status.textContent = 'Preparing the film.';
        await prepare();
        if (failed || !ready) return;
        try {
          await withTimeout(player.play(), 20000);
          if (failed) return;
          started = true;
          root.classList.add('is-started');
          root.classList.remove('is-paused');
          cameraBtn.disabled = false;
          // FIX: Clear status message after successful launch
          status.textContent = '';
          showControls();
        } catch (e) { fail(e); }
      }

      // Events
      screen.addEventListener('click', function (e) {
        if (controls.contains(e.target) || cameraBtn.contains(e.target)) return;
        if (!started) launch();
        else if (paused) player.play().catch(function(){});
        else { player.pause().catch(function(){}); root.classList.add('is-paused'); }
      });

      screen.addEventListener('mousemove', showControls);
      screen.addEventListener('touchstart', showControls, { passive: true });

      cameraBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (!started) launch();
        else player.play().catch(function(){});
      });

      $('refresh').addEventListener('click', function () { window.location.reload(); });
      poster.addEventListener('error', function () { poster.hidden = true; });

      toggle.addEventListener('click', async function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        toggle.disabled = true;
        try {
          const p = await withTimeout(player.getPaused(), 8000);
          await withTimeout(p ? player.play() : player.pause(), 15000);
        } catch (err) { notify('Playback could not be changed.', err); }
        finally { toggle.disabled = false; }
      });

      replay.addEventListener('click', async function (e) {
        e.stopPropagation();
        replay.disabled = true;
        try {
          await withTimeout(player.setCurrentTime(0).then(function () { return player.play(); }), 15000);
        } catch (err) { notify('Could not replay.', err); }
        finally { replay.disabled = false; }
      });

      sound.addEventListener('click', async function (e) {
        e.stopPropagation();
        sound.disabled = true;
        try {
          await withTimeout(player.setMuted(!muted), 8000);
          setMuted(await withTimeout(player.getMuted(), 8000));
        } catch (err) { notify('Sound could not be changed.', err); }
        finally { sound.disabled = false; }
      });

      // Speed cycle: 0.5x -> 1x -> 1.5x -> 2x -> 0.5x
      speed.addEventListener('click', async function (e) {
        e.stopPropagation();
        if (!ready || failed) return;
        speedIndex = (speedIndex + 1) % speedRates.length;
        const next = speedRates[speedIndex];
        speed.disabled = true;
        try {
          const actual = await withTimeout(player.setPlaybackRate(next), 8000);
          speed.textContent = actual + 'x';
        } catch (err) { notify('Speed change failed.', err); }
        finally { speed.disabled = false; }
      });

      // Quality cycle
      quality.addEventListener('click', async function (e) {
        e.stopPropagation();
        if (!ready || failed || qualities.length < 2) return;
        qualityIndex = (qualityIndex + 1) % qualities.length;
        const next = qualities[qualityIndex];
        quality.disabled = true;
        try {
          const actual = await withTimeout(player.setQuality(next.id), 10000);
          quality.textContent = actual === 'auto' ? 'Auto' : actual + 'p';
        } catch (err) { notify('Quality change failed.', err); }
        finally { quality.disabled = false; }
      });

      progress.addEventListener('input', function (e) {
        e.stopPropagation();
        seekEdit = true;
        showControls();
        const preview = duration * Number(progress.value) / 1000;
        timeEl.textContent = fmt(preview) + ' / ' + fmt(duration);
        const pct = Number(progress.value) / 10;
        progress.style.background = 'linear-gradient(to right, #e50914 ' + pct + '%, rgba(255,255,255,0.2) ' + pct + '%)';
      });

      progress.addEventListener('change', async function (e) {
        e.stopPropagation();
        try {
          current = await withTimeout(player.setCurrentTime(duration * Number(progress.value) / 1000), 10000);
        } catch (err) { notify('Seek failed.', err); }
        finally { seekEdit = false; updateTime(); showControls(); }
      });

      progress.addEventListener('blur', function () { seekEdit = false; updateTime(); });

      // Fullscreen
      const fsBtn = $('fullscreen');
      if (fsBtn) {
        fsBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (!document.fullscreenElement) {
            root.requestFullscreen().catch(function(){});
          } else {
            document.exitFullscreen().catch(function(){});
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }
})();
</script>

<script>
/* Wheel-driven camera shift (transform only, GPU-friendly). */
(function () {
  'use strict';
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('[data-cinema]').forEach(function (root) {
    var target = 0, cur = 0, raf = null;
    function tick() {
      cur += (target - cur) * 0.12;
      root.style.setProperty('--cam-shift', cur.toFixed(2) + 'px');
      raf = Math.abs(target - cur) > 0.1 ? requestAnimationFrame(tick) : null;
    }
    root.addEventListener('wheel', function (e) {
      target = Math.max(-8, Math.min(8, target + e.deltaY * 0.05));
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  });
})();
</script>
