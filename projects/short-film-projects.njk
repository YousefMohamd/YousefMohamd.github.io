<script>
(function () {
  'use strict';

  // ═══════════════════════════════════════════════════════════════
  // 1. Soft scroll reveal
  // ═══════════════════════════════════════════════════════════════
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('is-visible');
      else entry.target.classList.remove('is-visible');
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.label-reveal').forEach(el => observer.observe(el));

  // ═══════════════════════════════════════════════════════════════
  // 2. Remove first markdown paragraph
  // ═══════════════════════════════════════════════════════════════
  document.querySelectorAll('[data-film-markdown]').forEach(el => {
    const firstP = el.querySelector('p');
    if (firstP) firstP.remove();
  });

  // ═══════════════════════════════════════════════════════════════
  // 3. Vimeo oEmbed — single fetch per video (title + desc + author)
  // ═══════════════════════════════════════════════════════════════
  const vimeoInfoCache = new Map();

  function fetchVimeoInfo(id) {
    if (!id) return Promise.resolve(null);
    if (vimeoInfoCache.has(id)) return Promise.resolve(vimeoInfoCache.get(id));

    return new Promise(resolve => {
      const cbName = 'vimeoInfo_' + Date.now() + '_' + Math.random().toString(36).slice(2);
      const script = document.createElement('script');
      let done = false;

      const cleanup = () => {
        if (done) return;
        done = true;
        try { delete window[cbName]; } catch (e) { window[cbName] = undefined; }
        if (script.parentNode) script.parentNode.removeChild(script);
      };

      window[cbName] = (data) => {
        const payload = data || null;
        if (payload && payload.description) {
          payload.description = String(payload.description)
            .replace(/<[^>]*>/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
        }
        vimeoInfoCache.set(id, payload);
        resolve(payload);
        cleanup();
      };

      script.src = 'https://vimeo.com/api/oembed.json?url=' +
        encodeURIComponent('https://vimeo.com/' + id) +
        '&callback=' + cbName;
      script.async = true;
      script.onerror = () => {
        vimeoInfoCache.set(id, null);
        resolve(null);
        cleanup();
      };
      document.head.appendChild(script);

      setTimeout(() => {
        if (!done) { resolve(null); cleanup(); }
      }, 6000);
    });
  }

  // Populate description + author for every video
  document.querySelectorAll('[data-cinema]').forEach(cinema => {
    const descEl = cinema.querySelector('[data-film-desc]');
    const endDescEl = cinema.querySelector('[data-end-desc]');
    const endAuthorEl = cinema.querySelector('[data-end-author]');
    const vimeoId = cinema.dataset.videoId || '';
    if (!vimeoId) return;

    fetchVimeoInfo(vimeoId).then(info => {
      if (!info) return;
      if (info.description) {
        if (descEl) descEl.textContent = info.description;
        if (endDescEl) endDescEl.textContent = info.description;
      }
      if (info.author_name && endAuthorEl) {
        endAuthorEl.textContent = info.author_name;
      }
      // Extract username from author_url → fetch avatar from Vimeo v2 API
      const authorUrl = info.author_url || '';
      const usernameMatch = authorUrl.match(/vimeo\.com\/([^\/?#]+)/);
      if (usernameMatch) {
        const username = usernameMatch[1];
        const avatarImg = cinema.querySelector('[data-vimeo-avatar]');
        if (avatarImg && !avatarImg.dataset.fetched) {
          avatarImg.dataset.fetched = '1';
          fetchVimeoAvatar(username).then(url => {
            if (!url) return;
            avatarImg.src = url;
            avatarImg.onload = () => avatarImg.classList.add('is-loaded');
            avatarImg.onerror = () => { avatarImg.removeAttribute('src'); };
          });
        }
      }
    }).catch(() => {});
  });

  // ── Vimeo avatar (v2 API, JSONP) ──
  const avatarCache = new Map();
  function fetchVimeoAvatar(username) {
    if (!username) return Promise.resolve('');
    if (avatarCache.has(username)) return Promise.resolve(avatarCache.get(username));
    return new Promise(resolve => {
      const cbName = 'vimeoAvatar_' + Date.now() + '_' + Math.random().toString(36).slice(2);
      const script = document.createElement('script');
      let done = false;
      const cleanup = () => {
        if (done) return; done = true;
        try { delete window[cbName]; } catch (e) { window[cbName] = undefined; }
        if (script.parentNode) script.parentNode.removeChild(script);
      };
      window[cbName] = (data) => {
        const url = (data && (data.portrait_large || data.portrait_medium || data.portrait_small)) || '';
        avatarCache.set(username, url);
        resolve(url);
        cleanup();
      };
      script.src = 'https://vimeo.com/api/v2/' + encodeURIComponent(username) + '/info.json?callback=' + cbName;
      script.async = true;
      script.onerror = () => { avatarCache.set(username, ''); resolve(''); cleanup(); };
      document.head.appendChild(script);
      setTimeout(() => { if (!done) { resolve(''); cleanup(); } }, 5000);
    });
  }

  // ═══════════════════════════════════════════════════════════════
  // 4. Vimeo SDK loader
  // ═══════════════════════════════════════════════════════════════
  let sdkPromise;
  function loadVimeoSDK() {
    if (window.Vimeo && window.Vimeo.Player) return Promise.resolve(window.Vimeo);
    if (sdkPromise) return sdkPromise;
    sdkPromise = new Promise(function (resolve, reject) {
      const s = document.createElement('script');
      s.src = 'https://player.vimeo.com/api/player.js';
      s.async = true;
      s.onload = () => (window.Vimeo && window.Vimeo.Player) ? resolve(window.Vimeo) : reject(new Error('missing'));
      s.onerror = () => reject(new Error('load failed'));
      document.head.appendChild(s);
    });
    return sdkPromise;
  }

  // ═══════════════════════════════════════════════════════════════
  // 5. Utilities
  // ═══════════════════════════════════════════════════════════════
  function fmtTime(s) {
    const v = Math.max(0, Math.floor(Number(s) || 0));
    const h = Math.floor(v / 3600);
    const m = Math.floor((v % 3600) / 60);
    const sec = v % 60;
    const str = String(m).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
    return h ? h + ':' + str : str;
  }

  const MIN_LOADING_MS = 700;

  // ═══════════════════════════════════════════════════════════════
  // 6. Per-section initialization
  // ═══════════════════════════════════════════════════════════════
  function initSection(root) {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const layer = root.querySelector('[data-video-layer]');
    const hit = root.querySelector('[data-play-hit]');
    const shield = root.querySelector('[data-shield]');
    const playpauseBtn = root.querySelector('[data-playpause-btn]');
    const ppPath = root.querySelector('.pp-path');
    const volumeBtn = root.querySelector('[data-volume-btn]');
    const volumeSlider = root.querySelector('[data-volume-slider]');
    const speedBtn = root.querySelector('[data-speed-btn]');
    const speedMenu = root.querySelector('[data-speed-menu]');
    const qualityBtn = root.querySelector('[data-quality-btn]');
    const qualityMenu = root.querySelector('[data-quality-menu]');
    const fullscreenBtn = root.querySelector('[data-fullscreen-btn]');
    const replayBtn = root.querySelector('[data-replay-btn]');
    const timeEl = root.querySelector('[data-time]');
    const progress = root.querySelector('[data-progress]');
    const progressFill = root.querySelector('[data-progress-fill]');

    const vimeoId = root.dataset.videoId;
    const videoSrc = root.dataset.videoSrc;
    if (!layer) return;

    let player = null;
    let prepared = false;
    let preparing = false;
    let duration = 0;
    let current = 0;
    let isSeeking = false;
    let isMuted = false;
    let currentQuality = 'auto';
    let firstPlayHandled = false;
    let idleTimer = null;

    function setPlayPauseIcon(playing) {
      if (!ppPath) return;
      ppPath.setAttribute('d', playing ? 'M6 19h4V5H6v14zm8-14v14h4V5h-4z' : 'M8 5v14l11-7z');
      if (playpauseBtn) playpauseBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
    }

    function updateTime() {
      const pct = duration > 0 ? (current / duration) : 0;
      if (!isSeeking) {
        if (progress) progress.value = Math.round(pct * 1000);
        if (progressFill) progressFill.style.transform = 'scaleX(' + pct + ')';
      }
      if (timeEl) timeEl.textContent = fmtTime(current) + ' / ' + fmtTime(duration);
    }

    function showControls() {
      root.classList.add('is-ui-visible');
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => root.classList.remove('is-ui-visible'), 3200);
    }

    function revealVideo() {
      root.classList.remove('is-loading');
      root.classList.add('is-started');
      root.dataset.state = 'playing';
      if (player) {
        player.setCurrentTime(0).catch(() => {});
        player.play().catch(() => {});
      } else if (videoSrc) {
        const v = layer.querySelector('video');
        if (v) { v.currentTime = 0; v.play().catch(() => {}); }
      }
      showControls();
    }

    function prepare() {
      if (prepared) return Promise.resolve();
      if (preparing) return;
      preparing = true;

      if (videoSrc) {
        const v = document.createElement('video');
        v.playsInline = true; v.preload = 'auto'; v.controls = false;
        v.muted = true;
        v.src = videoSrc;
        v.addEventListener('ended', () => { root.classList.add('is-ended'); });
        v.addEventListener('timeupdate', () => {
          current = v.currentTime; duration = v.duration || 0; updateTime();
        });
        v.addEventListener('volumechange', () => {
          isMuted = v.muted || v.volume === 0;
          if (volumeSlider) volumeSlider.value = v.muted ? 0 : v.volume;
        });
        v.addEventListener('play', () => {
          if (!firstPlayHandled) {
            firstPlayHandled = true;
            v.pause();
            v.currentTime = 0;
            const startAt = parseInt(root.dataset.loadingStart || '0', 10);
            const wait = Math.max(0, MIN_LOADING_MS - (Date.now() - startAt));
            setTimeout(revealVideo, wait);
          } else {
            setPlayPauseIcon(true);
            root.dataset.state = 'playing';
          }
        });
        v.addEventListener('pause', () => {
          if (root.classList.contains('is-loading')) return;
          if (root.dataset.state === 'ended') return;
          setPlayPauseIcon(false);
          root.dataset.state = 'paused';
        });
        layer.appendChild(v);
        prepared = true; preparing = false;
        return Promise.resolve();
      }

      return loadVimeoSDK().then(Vimeo => {
        const iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + vimeoId +
          '?autoplay=0&muted=1&controls=0&byline=0&title=0&portrait=0&dnt=1&playsinline=1';
        iframe.title = 'Film';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        iframe.tabIndex = -1;
        layer.appendChild(iframe);
        player = new Vimeo.Player(iframe);

        player.on('play', () => {
          if (!firstPlayHandled) {
            firstPlayHandled = true;
            player.pause().catch(() => {});
            player.setCurrentTime(0).catch(() => {});
            const startAt = parseInt(root.dataset.loadingStart || '0', 10);
            const wait = Math.max(0, MIN_LOADING_MS - (Date.now() - startAt));
            setTimeout(revealVideo, wait);
          } else {
            setPlayPauseIcon(true);
            root.dataset.state = 'playing';
            root.classList.remove('is-ended');
          }
        });
        player.on('pause', () => {
          if (root.classList.contains('is-loading')) return;
          if (root.dataset.state === 'ended') return;
          setPlayPauseIcon(false);
          root.dataset.state = 'paused';
        });
        player.on('ended', () => {
          root.classList.add('is-ended');
          root.classList.remove('is-loading');
        });
        player.on('timeupdate', (e) => {
          current = Number(e.seconds) || 0;
          duration = Number(e.duration) || duration;
          updateTime();
        });
        player.on('durationchange', (e) => {
          duration = Number(e.duration) || 0;
          updateTime();
        });
        player.on('volumechange', (e) => {
          isMuted = Boolean(e.muted) || e.volume === 0;
          if (volumeSlider) volumeSlider.value = e.volume;
        });
        player.on('qualitychange', (e) => {
          if (e && e.id) {
            currentQuality = e.id;
            if (qualityBtn) qualityBtn.textContent = e.id === 'auto' ? 'Auto' : (parseInt(e.id, 10) + 'p');
          }
        });

        return player.ready().then(() => {
          prepared = true; preparing = false;
          player.getDuration().then(d => { duration = Number(d) || 0; updateTime(); }).catch(() => {});
          player.getQualities().then(list => {
            if (!qualityMenu) return;
            qualityMenu.innerHTML = '';
            list.forEach(q => {
              const b = document.createElement('button');
              b.className = 'cine-popup-item' + (q.id === currentQuality ? ' is-active' : '');
              b.dataset.qualityValue = q.id;
              b.textContent = q.id === 'auto' ? 'Auto' : (parseInt(q.id, 10) + 'p');
              qualityMenu.appendChild(b);
            });
          }).catch(() => {});
        });
      }).catch(err => {
        preparing = false;
        console.warn('[Cinema] prepare failed', err);
      });
    }

    function play() {
      if (root.classList.contains('is-started')) {
        if (player) player.play().catch(() => {});
        else if (videoSrc) {
          const v = layer.querySelector('video');
          if (v) v.play().catch(() => {});
        }
        return;
      }

      root.dataset.loadingStart = String(Date.now());
      root.classList.add('is-loading');

      const safety = setTimeout(() => {
        if (root.classList.contains('is-loading')) revealVideo();
      }, 5000);

      if (prepared && player) {
        player.play().catch(() => { clearTimeout(safety); root.classList.remove('is-loading'); });
        return;
      }
      if (prepared && videoSrc) {
        const v = layer.querySelector('video');
        if (v) v.play().catch(() => { clearTimeout(safety); root.classList.remove('is-loading'); });
        return;
      }
      prepare().then(() => {
        if (player) player.play().catch(() => { clearTimeout(safety); root.classList.remove('is-loading'); });
        else if (videoSrc) {
          const v = layer.querySelector('video');
          if (v) v.play().catch(() => { clearTimeout(safety); root.classList.remove('is-loading'); });
        }
      }).catch(() => {
        clearTimeout(safety);
        root.classList.remove('is-loading');
      });
    }

    function pause() {
      if (player) player.pause().catch(() => {});
      else if (videoSrc) {
        const v = layer.querySelector('video');
        if (v) v.pause();
      }
    }

    function togglePlay() {
      if (root.dataset.state === 'playing') pause();
      else play();
    }

    function prewarm() {
      if (!prepared && !preparing) prepare();
    }

    if (hit) hit.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('is-loading')) return;
      if (!root.classList.contains('is-started')) { play(); return; }
      if (root.classList.contains('is-ui-visible')) {
        root.classList.remove('is-ui-visible');
        if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      } else {
        showControls();
      }
    });
    if (hit) hit.addEventListener('mouseenter', prewarm, { passive: true });

    if (shield) shield.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('is-loading')) return;
      if (!root.classList.contains('is-started')) { play(); return; }
      if (root.classList.contains('is-ui-visible')) {
        root.classList.remove('is-ui-visible');
        if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
      } else {
        showControls();
      }
    });
    if (shield) shield.addEventListener('mouseenter', prewarm, { passive: true });

    if (playpauseBtn) playpauseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (root.classList.contains('is-loading')) return;
      togglePlay();
    });

    if (replayBtn) replayBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      root.classList.remove('is-ended');
      root.dataset.state = 'playing';
      if (player) {
        player.setCurrentTime(0).then(() => player.play()).catch(() => {});
      } else if (videoSrc) {
        const v = layer.querySelector('video');
        if (v) { v.currentTime = 0; v.play().catch(() => {}); }
      }
    });

    if (volumeBtn) volumeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (player) {
        if (isMuted) player.setMuted(false).catch(() => {});
        else player.setMuted(true).catch(() => {});
      } else {
        const v = layer.querySelector('video');
        if (v) v.muted = !v.muted;
      }
    });

    if (volumeSlider) volumeSlider.addEventListener('input', (e) => {
      e.stopPropagation();
      const val = Number(volumeSlider.value);
      if (player) { player.setVolume(val).catch(() => {}); if (val > 0) player.setMuted(false).catch(() => {}); }
      else { const v = layer.querySelector('video'); if (v) { v.volume = val; v.muted = val === 0; } }
    });

    if (speedBtn && speedMenu) {
      speedBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        speedMenu.hidden = !speedMenu.hidden;
        if (qualityMenu) qualityMenu.hidden = true;
      });
      speedMenu.querySelectorAll('[data-speed-value]').forEach(b => {
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          const v = Number(b.dataset.speedValue);
          if (player) player.setPlaybackRate(v).catch(() => {});
          else { const vid = layer.querySelector('video'); if (vid) vid.playbackRate = v; }
          speedBtn.textContent = v + 'x';
          speedMenu.querySelectorAll('[data-speed-value]').forEach(x => x.classList.toggle('is-active', x === b));
          speedMenu.hidden = true;
        });
      });
    }

    if (qualityBtn && qualityMenu) {
      qualityBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        qualityMenu.hidden = !qualityMenu.hidden;
        if (speedMenu) speedMenu.hidden = true;
      });
      qualityMenu.addEventListener('click', (e) => {
        const b = e.target.closest('[data-quality-value]');
        if (!b) return;
        e.stopPropagation();
        const q = b.dataset.qualityValue;
        if (player && !videoSrc) {
          player.setQuality(q).then(() => {
            currentQuality = q;
            qualityBtn.textContent = q === 'auto' ? 'Auto' : (parseInt(q, 10) + 'p');
            qualityMenu.querySelectorAll('.cine-popup-item').forEach(x => x.classList.toggle('is-active', x === b));
          }).catch(() => {});
        }
        qualityMenu.hidden = true;
      });
    }

    if (fullscreenBtn) fullscreenBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!document.fullscreenElement) root.requestFullscreen().catch(() => {});
      else document.exitFullscreen().catch(() => {});
    });

    if (progress) {
      progress.addEventListener('input', (e) => {
        e.stopPropagation();
        isSeeking = true;
        const pct = Number(progress.value) / 1000;
        if (progressFill) progressFill.style.transform = 'scaleX(' + pct + ')';
        if (timeEl) timeEl.textContent = fmtTime(duration * pct) + ' / ' + fmtTime(duration);
      });
      progress.addEventListener('change', (e) => {
        e.stopPropagation();
        const target = duration * Number(progress.value) / 1000;
        if (player) player.setCurrentTime(target).catch(() => {}).finally(() => { isSeeking = false; });
        else { const v = layer.querySelector('video'); if (v) v.currentTime = target; isSeeking = false; }
      });
      progress.addEventListener('blur', () => { isSeeking = false; });
    }

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) return;
      if (speedMenu && !e.target.closest('.cine-speed-wrap')) speedMenu.hidden = true;
      if (qualityMenu && !e.target.closest('.cine-quality-wrap')) qualityMenu.hidden = true;
    });
  }

  // ═══════════════════════════════════════════════════════════════
  // 7. Boot
  // ═══════════════════════════════════════════════════════════════
  loadVimeoSDK().catch(() => {});

  function boot() {
    document.querySelectorAll('[data-cinema]').forEach(initSection);
    setTimeout(() => {
      document.querySelectorAll('[data-cinema]').forEach(root => {
        if (root.dataset.prewarmed) return;
        if (!root.dataset.videoId && !root.dataset.videoSrc) return;
        if (root.classList.contains('is-started')) return;
        const hit = root.querySelector('[data-play-hit]');
        if (hit) hit.dispatchEvent(new MouseEvent('mouseenter'));
        root.dataset.prewarmed = 'true';
      });
    }, 300);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
})();
</script>
