---
layout: layouts/base.njk
title: Short Film Projects
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://player.vimeo.com" crossorigin>
<link rel="preconnect" href="https://i.vimeocdn.com" crossorigin>
<link rel="dns-prefetch" href="https://player.vimeo.com">
<link rel="preload" as="script" href="https://player.vimeo.com/api/player.js" crossorigin>

<div class="w3-padding-64 w3-content cinematic-projects">
  <h2 class="section-heading">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project" data-film-project>
        {% if p.data.videoSrc or p.data.vimeoId %}
          <section class="cinema" data-cinema data-state="idle"
            data-video-id="{{ p.data.vimeoId | default('') | escape }}"
            data-video-src="{{ p.data.videoSrc | default('') | escape }}"
            aria-label="{{ p.data.title | escape }} video player">
            <div class="cinema-screen">
              <div class="cinema-video-layer" data-video-layer></div>

              {% if p.data.poster %}
                <img class="cinema-poster" data-poster src="{{ p.data.poster }}" alt="" decoding="async">
              {% elif p.data.vimeoId %}
                <img class="cinema-poster" data-poster src="https://vumbnail.com/{{ p.data.vimeoId }}_large.jpg" alt="" decoding="async" onerror="this.onerror=null;this.src='https://vumbnail.com/{{ p.data.vimeoId }}.jpg'">
              {% endif %}

              <div class="cine-shield" data-shield aria-hidden="true"></div>

              <div class="cine-dots" data-cine-dots aria-hidden="true">
                <span></span><span></span><span></span>
              </div>

              <button class="cinema-hit" data-play-hit type="button" aria-label="Play"></button>

              <div class="cine-fade" data-fade aria-hidden="true"></div>

              <div class="cine-title-stage">
                <div class="cine-title-inner label-reveal">
                  <h3 class="cine-film-title">{{ p.data.title | escape }}</h3>
                  <p class="cine-film-desc" data-film-desc></p>
                </div>
              </div>

              <div class="cine-controls" data-controls>
                <div class="cine-main-row">
                  <div class="cine-timeline">
                    <div class="cine-timeline-track">
                      <div class="cine-timeline-fill" data-progress-fill></div>
                      <input class="cine-timeline-input" data-progress type="range" min="0" max="1000" value="0" aria-label="Seek">
                    </div>
                  </div>
                  <span class="cine-time" data-time>00:00 / 00:00</span>
                </div>
                <div class="cine-btn-row">
                  <div class="cine-btn-left">
                    <button class="cine-playpause" data-playpause-btn type="button" aria-label="Play">
                      <svg class="pp-svg" viewBox="0 0 24 24"><path class="pp-path" d="M8 5v14l11-7z" fill="currentColor"/></svg>
                    </button>
                    <div class="cine-volume">
                      <button class="cine-btn" data-volume-btn type="button" aria-label="Mute">
                        <svg viewBox="0 0 24 24" class="cine-btn-icon"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                      </button>
                      <input class="cine-volume-slider" data-volume-slider type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume">
                    </div>
                  </div>
                  <div class="cine-btn-right">
                    <div class="cine-quality-wrap">
                      <button class="cine-btn cine-btn-text" data-quality-btn type="button" aria-label="Quality">Auto</button>
                      <div class="cine-popup" data-quality-menu hidden></div>
                    </div>
                    <div class="cine-speed-wrap">
                      <button class="cine-btn cine-btn-text" data-speed-btn type="button" aria-label="Speed">1x</button>
                      <div class="cine-popup" data-speed-menu hidden>
                        <button class="cine-popup-item" data-speed-value="0.5">0.5x</button>
                        <button class="cine-popup-item" data-speed-value="0.75">0.75x</button>
                        <button class="cine-popup-item is-active" data-speed-value="1">1x</button>
                        <button class="cine-popup-item" data-speed-value="1.25">1.25x</button>
                        <button class="cine-popup-item" data-speed-value="1.5">1.5x</button>
                        <button class="cine-popup-item" data-speed-value="2">2x</button>
                      </div>
                    </div>
                    <button class="cine-btn" data-fullscreen-btn type="button" aria-label="Fullscreen">
                      <svg viewBox="0 0 24 24" class="cine-btn-icon"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                    </button>
                  </div>
                </div>
              </div>

              <div class="cine-end-card" data-end-card aria-hidden="true">
                <div class="end-card-glow" aria-hidden="true"></div>

                <div class="end-card-top">
                  <div class="end-card-photo">
                    <span class="end-card-initials">YM</span>
                    <img data-vimeo-avatar alt="" loading="lazy">
                  </div>

                  <div class="end-card-meta">
                    <div class="end-card-profile-name" data-end-author>Yousef Mohamed</div>

                    <div class="end-card-icons">
                      {% if contacts.linkedin %}
                      <a class="linkedin" href="{{ contacts.linkedin }}" target="_blank" rel="noopener" title="LinkedIn" aria-label="LinkedIn">
                        <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                      </a>
                      {% endif %}
                      {% if contacts.instagram %}
                      <a class="instagram" href="{{ contacts.instagram }}" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                      </a>
                      {% endif %}
                      {% if contacts.vimeo %}
                      <a class="vimeo" href="{{ contacts.vimeo }}" target="_blank" rel="noopener" title="Vimeo" aria-label="Vimeo">
                        <svg viewBox="0 0 24 24"><path d="M23.9765 6.4168c-.105 2.338-1.739 5.5429-4.894 9.6088-3.2679 4.247-6.0258 6.3699-8.2818 6.3699-1.409 0-2.578-1.294-3.553-3.881l-1.9179-7.1138c-.719-2.584-1.488-3.878-2.312-3.878-.179 0-.806.377-1.881 1.132L.0073 7.1971a315.06 315.06 0 0 0 3.501-3.1279c1.579-1.368 2.765-2.085 3.5539-2.159 1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.5069.5389 2.45 1.1309 3.674 1.7759 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.8679 3.434-5.7568 6.7619-5.6368 2.4729.06 3.6279 1.664 3.4799 4.7978z"/></svg>
                      </a>
                      {% endif %}
                      {% if contacts.behance %}
                      <a class="behance" href="{{ contacts.behance }}" target="_blank" rel="noopener" title="Behance" aria-label="Behance">
                        <svg viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988H0V5.021h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 8.061-3.207 8.061zM3 11h3.584c2.508 0 2.906-3-.312-3H3v3zm3.391 3H3v3.016h3.341c3.055 0 2.868-3.016.05-3.016z"/></svg>
                      </a>
                      {% endif %}
                    </div>

                    {% if contacts.email %}
                    <a class="end-card-email" href="mailto:{{ contacts.email }}">{{ contacts.email }}</a>
                    {% endif %}
                  </div>
                </div>

                <div class="end-card-film">
                  <h3 class="end-card-film-title">{{ p.data.title | escape }}</h3>
                  <p class="end-card-film-desc" data-end-desc></p>
                </div>

                <a class="end-card-vimeo-link" href="{{ contacts.vimeo or 'https://vimeo.com/' }}" target="_blank" rel="noopener" aria-label="Vimeo profile">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.9765 6.4168c-.105 2.338-1.739 5.5429-4.894 9.6088-3.2679 4.247-6.0258 6.3699-8.2818 6.3699-1.409 0-2.578-1.294-3.553-3.881l-1.9179-7.1138c-.719-2.584-1.488-3.878-2.312-3.878-.179 0-.806.377-1.881 1.132L.0073 7.1971a315.06 315.06 0 0 0 3.501-3.1279c1.579-1.368 2.765-2.085 3.5539-2.159 1.867-.18 3.016 1.1 3.447 3.838.465 2.953.789 4.789.971 5.5069.5389 2.45 1.1309 3.674 1.7759 3.674.502 0 1.256-.796 2.265-2.385 1.004-1.589 1.54-2.797 1.612-3.628.144-1.371-.395-2.061-1.614-2.061-.574 0-1.167.121-1.777.391 1.186-3.8679 3.434-5.7568 6.7619-5.6368 2.4729.06 3.6279 1.664 3.4799 4.7978z"/></svg>
                </a>

                <button class="end-card-replay" data-replay-btn type="button" aria-label="Replay">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                </button>
              </div>
            </div>
          </section>
        {% endif %}

        {% if p.templateContent %}
          <div class="film-description" data-film-markdown>{{ p.templateContent | safe }}</div>
        {% endif %}

        <hr class="film-divider">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
.cinematic-projects {
  --cine-surface: rgba(10, 10, 10, 0.85);
  --cine-accent: #e8d68a;
  --cine-title-font: 'Anton', 'Oswald', 'Impact', sans-serif;
  --cine-body-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'AppleSystemUIFont', 'Inter', 'Helvetica Neue', 'Segoe UI', sans-serif;
}

.label-reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.label-reveal.is-visible { opacity: 1; transform: translateY(0); }

.cinematic-projects .section-heading {
  font-family: var(--cine-body-font);
  font-size: 38px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: normal;
  color: #f2e9d8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  margin-bottom: 44px;
}

.cinematic-projects .film-project { margin-bottom: 56px; }
.cinematic-projects .film-description {
  font-family: var(--cine-body-font);
  color: #c8c8c8; line-height: 1.8; font-size: 15px; margin-top: 20px;
}
.cinematic-projects .film-description p { margin: 0 0 14px 0; }
.cinematic-projects .film-description strong { color: #e6e6e6; font-weight: 600; }
.cinematic-projects .film-description ul { padding-left: 22px; margin: 8px 0 14px 0; }
.cinematic-projects .film-description li { margin-bottom: 4px; }
.cinematic-projects .film-divider {
  border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 40px 0 0 0;
}

.cinematic-projects .cinema {
  position: relative; isolation: isolate; border-radius: 12px; overflow: hidden;
  background: #000; box-shadow: 0 24px 72px rgba(0,0,0,0.65);
}
.cinematic-projects .cinema-screen {
  position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000;
}

/* ── Video layer (iframe) — invisible until started ── */
.cinematic-projects .cinema-video-layer {
  position: absolute; inset: 0; z-index: 1;
  opacity: 0; pointer-events: none;
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-started .cinema-video-layer {
  opacity: 1; pointer-events: auto;
}
.cinematic-projects .cinema-video-layer iframe,
.cinematic-projects .cinema-video-layer video {
  position: absolute; inset: 0; width: 100%; height: 100%;
  border: 0; background: #000; display: block;
}

/* ── Poster — sits ON TOP of iframe, hides Vimeo's own poster/spinner ── */
.cinematic-projects .cinema-poster {
  position: absolute; inset: 0; z-index: 2;
  width: 100%; height: 100%;
  object-fit: cover; background: #000;
  opacity: 1; transform: scale(1);
  filter: blur(0px) brightness(1);
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
              transform 1.4s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
}
.cinematic-projects .cinema.is-started .cinema-poster {
  opacity: 0;
  transform: scale(1.08);
  filter: blur(14px) brightness(0.6);
}

/* ── Shield (top-right corner — blocks Vimeo hover icons) ── */
.cinematic-projects .cine-shield {
  position: absolute; top: 0; right: 0;
  width: 220px; height: 80px;
  z-index: 4; background: transparent;
  cursor: pointer; pointer-events: auto;
}
.cinematic-projects .cinema.is-started .cine-shield { display: none; }

/* ── Loading dots ── */
.cinematic-projects .cine-dots {
  position: absolute; inset: 0; z-index: 5;
  display: flex; align-items: center; justify-content: center;
  gap: 14px; opacity: 0; pointer-events: none;
  transition: opacity 0.35s ease;
}
.cinematic-projects .cinema.is-loading .cine-dots { opacity: 1; }
.cinematic-projects .cine-dots span {
  display: block; width: 14px; height: 14px;
  border-radius: 50%; background: #f2f0eb;
  box-shadow: 0 0 18px rgba(242,240,235,0.55), 0 0 36px rgba(242,240,235,0.25);
  animation: cine-dot-pulse 1.15s ease-in-out infinite both;
}
.cinematic-projects .cine-dots span:nth-child(1) { animation-delay: 0s; }
.cinematic-projects .cine-dots span:nth-child(2) { animation-delay: 0.16s; }
.cinematic-projects .cine-dots span:nth-child(3) { animation-delay: 0.32s; }
@keyframes cine-dot-pulse {
  0%, 80%, 100% { transform: scale(0.55); opacity: 0.35; }
  40%           { transform: scale(1.1);  opacity: 1;   }
}

/* ── Hit area (click anywhere) ── */
.cinematic-projects .cinema-hit {
  position: absolute; inset: 0; z-index: 6;
  border: 0; padding: 0; margin: 0;
  background: transparent; cursor: pointer;
}
.cinematic-projects .cinema.is-ended .cinema-hit { opacity: 0; pointer-events: none; }

/* ── Gradient fade behind title ── */
.cinematic-projects .cine-fade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 50%;
  z-index: 7; pointer-events: none;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.58) 20%, rgba(0,0,0,0.38) 42%,
    rgba(0,0,0,0.18) 66%, rgba(0,0,0,0.06) 86%, rgba(0,0,0,0) 100%
  );
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-started .cine-fade { opacity: 0; }

/* ── Title + description ── */
.cinematic-projects .cine-title-stage {
  position: absolute; left: 32px; right: 32px; bottom: 32px; z-index: 8;
  pointer-events: none;
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.cinematic-projects .cinema.is-started .cine-title-stage {
  opacity: 0; transform: translateY(24px);
}
.cinematic-projects .cine-title-inner {
  display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
}
.cinematic-projects .cine-film-title {
  margin: 0; font-family: var(--cine-title-font); font-weight: 400;
  font-size: 48px; line-height: 1; letter-spacing: 0.01em;
  color: #f2f0eb; text-transform: uppercase;
}
.cinematic-projects .cine-film-desc {
  margin: 0; max-width: 620px; font-family: var(--cine-body-font);
  font-size: 12px; line-height: 1.6; color: #cccccc;
}
.cinematic-projects .cine-film-desc:empty { display: none; }
/* ── Custom controls ── */
.cinematic-projects .cine-controls {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 12;
  display: flex; flex-direction: column; gap: 8px;
  padding: 60px 20px 16px;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 40%, transparent 100%);
  opacity: 0; transform: translateY(12px); pointer-events: none;
  transition: opacity 0.35s ease, transform 0.35s ease;
}
.cinematic-projects .cinema.is-ui-visible .cine-controls {
  opacity: 1; transform: translateY(0); pointer-events: auto;
}
.cinematic-projects .cinema.is-loading .cine-controls,
.cinematic-projects .cinema.is-ended .cine-controls { opacity: 0 !important; pointer-events: none !important; }

.cinematic-projects .cine-main-row {
  display: flex; align-items: center; gap: 10px; width: 100%;
}
.cinematic-projects .cine-timeline {
  display: flex; align-items: center; flex: 1; min-width: 0;
}
.cinematic-projects .cine-timeline-track {
  position: relative; flex: 1; height: 3px; border-radius: 3px;
  background: rgba(242, 240, 235, 0.22); transition: height 0.2s ease;
}
.cinematic-projects .cine-timeline:hover .cine-timeline-track { height: 5px; }
.cinematic-projects .cine-timeline-fill {
  position: absolute; top: 0; left: 0; height: 100%; width: 100%;
  background: #f2f0eb; border-radius: 3px; pointer-events: none;
  transform: scaleX(0); transform-origin: left center;
}
.cinematic-projects .cine-timeline-input {
  position: absolute; inset: -6px 0; width: 100%; height: calc(100% + 12px);
  margin: 0; padding: 0; appearance: none; -webkit-appearance: none;
  background: transparent; cursor: pointer; outline: none; z-index: 2;
}
.cinematic-projects .cine-timeline-input::-webkit-slider-thumb {
  -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%;
  background: #f2f0eb; cursor: pointer;
  box-shadow: 0 0 0 4px rgba(242,240,235,0.18), 0 2px 6px rgba(0,0,0,0.5);
}
.cinematic-projects .cine-timeline-input::-moz-range-thumb {
  width: 12px; height: 12px; border-radius: 50%; background: #f2f0eb;
  cursor: pointer; border: none;
}

.cinematic-projects .cine-btn-row {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.cinematic-projects .cine-btn-left,
.cinematic-projects .cine-btn-right {
  display: flex; align-items: center; gap: 4px;
}
.cinematic-projects .cine-btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: 36px; min-width: 36px; padding: 0 8px;
  border: none; border-radius: 6px; background: transparent;
  color: #f2f0eb; cursor: pointer; font-family: var(--cine-body-font);
  font-size: 12px; font-weight: 500;
  transition: background 0.15s ease;
}
.cinematic-projects .cine-btn:hover { background: rgba(255,255,255,0.1); }
.cinematic-projects .cine-btn-icon { width: 20px; height: 20px; fill: currentColor; }
.cinematic-projects .cine-btn-text { opacity: 0.9; }

.cinematic-projects .cine-playpause {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; padding: 0; border: none; border-radius: 8px;
  background: transparent; color: #f2f0eb; cursor: pointer;
  transition: background 0.15s ease;
}
