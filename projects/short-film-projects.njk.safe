---
layout: layouts/base.njk
title: Short Film Projects
---

<div class="w3-padding-64 w3-content">
  <h2 class="w3-text-light-grey">Short Film Projects</h2>

  {% for p in (collections.project or []) | reverse %}
    {% if (p.data.section or '').toLowerCase() == 'short film projects' %}
      <div class="film-project w3-margin-bottom">
        <h3 class="w3-text-light-grey" style="margin:18px 0 8px;">{{ p.data.title }}</h3>

        {% if p.data.vimeoId %}
          <!-- تم استخدام _large.jpg لجلب البوستر بأعلى جودة HD -->
          <div class="video-wrapper" style="background-image: url('https://vumbnail.com/{{ p.data.vimeoId }}_large.jpg');">

            <!-- زر التشغيل بالتصميم الزجاجي والموجة الزجزاجية -->
            <button class="facade-play-btn" type="button" aria-label="Play video">
              <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
                <path d="M8 5.2v13.6L19 12z" fill="currentColor"/>
              </svg>
            </button>

            <iframe
              data-src="https://player.vimeo.com/video/{{ p.data.vimeoId }}?autoplay=1&color=ffffff&title=0&byline=0&portrait=0"
              width="100%" height="100%" frameborder="0"
              class="lazy-vimeo"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
        {% endif %}

        {% if p.templateContent %}
          <div class="w3-text-grey" style="line-height:1.7;">
            {{ p.templateContent | safe }}
          </div>
        {% endif %}

        <hr class="w3-opacity">
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
/* Video Wrapper Styling with Curved Edges & Isolation */
.video-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background-size: cover;
  background-position: center;
  cursor: pointer;
  border-radius: 16px;
  overflow: hidden;
  isolation: isolate;
}

.video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

/* Glassmorphism Play Button */
.facade-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70px;
  height: 70px;
  border: 1px solid oklch(1 0 0 / 0.35);
  border-radius: 50%;
  background: oklch(1 0 0 / 0.14);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
  color: #ffffff;
  transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.5, 1), background 0.25s;
}

.facade-play-btn:hover {
  background: oklch(1 0 0 / 0.24);
  transform: translate(-50%, -50%) scale(1.08);
}

/* Classic Zigzag Wave Animation */
.facade-play-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2px solid oklch(1 0 0 / 0.2);
  animation: zigzag-wave 1.2s infinite;
  opacity: 0;
  pointer-events: none;
}

.facade-play-btn:hover::before {
  opacity: 1;
}

@keyframes zigzag-wave {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.5);
    opacity: 0.3;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.facade-play-btn svg {
  fill: currentColor;
}

/* Cinematic Ambient Glow & Poster Removal on Play */
.video-wrapper.is-playing {
  background-image: none !important;
}

.video-wrapper.is-playing::before {
  content: '';
  position: absolute;
  inset: -10px;
  background: radial-gradient(closest-side, oklch(1 0 0 / 0.2), transparent);
  filter: blur(25px);
  z-index: -1;
  opacity: 0.6;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.video-wrapper').forEach(wrapper => {
    const iframe = wrapper.querySelector('iframe');
    const playBtn = wrapper.querySelector('.facade-play-btn');

    function loadVideo() {
      if (wrapper.classList.contains('is-playing')) return;
      wrapper.classList.add('is-playing');
      if (iframe && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
      }
    }

    wrapper.addEventListener('click', loadVideo);
    if (playBtn) {
      playBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        loadVideo();
      });
    }
  });
});
</script>
